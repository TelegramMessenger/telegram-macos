import AppKit

enum TextInputAttributes {
    static let bold = NSAttributedString.Key("Attribute__Bold")
    static let quote = NSAttributedString.Key("Attribute__Blockquote")
    static let customEmoji = NSAttributedString.Key("Attribute__CustomEmoji")
    static let formattedDate = NSAttributedString.Key("Attribute__FormattedDate")
    static let allAttributes = [bold, quote, customEmoji, formattedDate]
}

final class TextViewBlockQuoteData: NSObject {
    let id: Int
    init(id: Int) {
        self.id = id
        super.init()
    }
    override func isEqual(_ object: Any?) -> Bool {
        return (object as? TextViewBlockQuoteData)?.id == self.id
    }
    override var hash: Int {
        return self.id
    }
}

final class TextViewFormattedDateData {
}

final class TextInputTextCustomEmojiAttribute: NSObject {
    let fileId: Int64
    let emoji: String
    init(fileId: Int64, emoji: String) {
        self.fileId = fileId
        self.emoji = emoji
        super.init()
    }
    override func isEqual(_ object: Any?) -> Bool {
        return self === (object as? TextInputTextCustomEmojiAttribute)
    }
}

extension NSRange {
    var min: Int {
        return self.location
    }
    var max: Int {
        return self.location + self.length
    }
}

extension String {
    var length: Int {
        return (self as NSString).length
    }
    var nsstring: NSString {
        return self as NSString
    }
}

extension NSAttributedString {
    static func initialize(string: String?) -> NSAttributedString {
        return NSAttributedString(string: string ?? "")
    }
    var range: NSRange {
        return NSRange(location: 0, length: self.length)
    }
    __TRIMMED__
}

extension NSMutableAttributedString {
    __REMOVE_WHITESPACE__
}

enum MessageTextEntityType: Equatable {
    enum DateTimeFormat: Equatable {
        case relative
        case full
    }
    case Bold
    case Italic
    case Strikethrough
    case Underline
    case Spoiler
    case Code
    case Pre(language: String?)
    case BlockQuote(isCollapsed: Bool)
    case CustomEmoji(stickerPack: Int?, fileId: Int64)
    case FormattedDate(format: DateTimeFormat?, date: Int32)
}

struct MessageTextEntity: Equatable {
    var range: Range<Int>
    var type: MessageTextEntityType
    init(range: Range<Int>, type: MessageTextEntityType) {
        self.range = range
        self.type = type
    }
}

struct TextEntitiesMessageAttribute {
    let entities: [MessageTextEntity]
}

func formatDateTimeEntity(format: MessageTextEntityType.DateTimeFormat, date: Int32) -> String {
    return "11/14/26, 5:00 PM"
}

__RESOLVE_DATES__

__ENTITIES_IN_RANGE__

__TRIM_WITH_ENTITIES__

__ENTITIES_FOR_TEXT__

struct MessageId: Equatable {
    let id: Int32
}

final class Message {
    let id = MessageId(id: 1)
    let text: String
    let textEntities: TextEntitiesMessageAttribute?
    let media: [Int] = []
    init(_ text: String, _ entities: [MessageTextEntity]) {
        self.text = text
        self.textEntities = entities.isEmpty ? nil : TextEntitiesMessageAttribute(entities: entities)
    }
}

struct EngineMessageReplyQuote {
    let text: String
    let offset: Int?
    let entities: [MessageTextEntity]
    let media: Int?
}

struct ReplySubject {
    let quote: EngineMessageReplyQuote?
    init(messageId: MessageId, quote: EngineMessageReplyQuote?, innerSubject: Int?) {
        self.quote = quote
    }
}

struct ChatTextInputState {
    let attributedText: NSAttributedString
    init(attributedText: NSAttributedString, selectionRange: Range<Int>) {
        self.attributedText = attributedText
    }
    func messageTextEntities() -> [MessageTextEntity] {
        var result: [MessageTextEntity] = []
        self.attributedText.enumerateAttributes(in: self.attributedText.range, options: []) { attributes, range, _ in
            if attributes[TextInputAttributes.bold] != nil {
                result.append(MessageTextEntity(range: range.location ..< NSMaxRange(range), type: .Bold))
            }
            if let emoji = attributes[TextInputAttributes.customEmoji] as? TextInputTextCustomEmojiAttribute {
                result.append(MessageTextEntity(range: range.location ..< NSMaxRange(range), type: .CustomEmoji(stickerPack: nil, fileId: emoji.fileId)))
            }
        }
        return result
    }
}

var captured: EngineMessageReplyQuote?
var replied = false
var alerted = false

final class ChatInteraction {
    func setupReplyMessage(_ message: Message, _ subject: ReplySubject) {
        replied = true
        captured = subject.quote
    }
}

