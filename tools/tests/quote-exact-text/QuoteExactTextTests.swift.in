    func getGeneralValue(_ key: String, orElse defaultValue: Int32) -> Int32 {
        return defaultValue
    }
}

struct Context {
    let appConfiguration = AppConfiguration()
    let window = 0
}

struct Strings {
    let chatMessageContextQuoteLimitExceed = "limit"
}

func strings() -> Strings {
    return Strings()
}

func alert(for window: Int, info: String) {
    alerted = true
}

let context = Context()
let chatInteraction = ChatInteraction()

struct TextSelectedRange {
    var range: NSRange = NSMakeRange(NSNotFound, 0)
}

final class TextViewLayout {
    private(set) var attributedString: NSAttributedString
    var selectedRange = TextSelectedRange()
    var lines: [Int] = []
    var string: String {
        return self.attributedString.string
    }
    init(_ attributedString: NSAttributedString) {
        self.attributedString = attributedString
    }
    func setAttributedString(_ string: NSAttributedString) {
        self.attributedString = string
    }
}

final class FoldingTextLayout {
    struct ViewLayout {
        let text: TextViewLayout
    }

    var blocks: [ViewLayout]
    let blockRanges: [NSRange]
    let attributedString: NSAttributedString

    init(attributedString: NSAttributedString, blocks: [TextViewLayout], blockRanges: [NSRange]) {
        self.attributedString = attributedString
        self.blocks = blocks.map { ViewLayout(text: $0) }
        self.blockRanges = blockRanges
    }

    __MERGED__

    __BREAK_STRING__

    static func make(_ string: NSAttributedString) -> FoldingTextLayout {
        let blockRanges = FoldingTextLayout.breakString(string)
        return FoldingTextLayout(attributedString: string, blocks: blockRanges.map { TextViewLayout(string.attributedSubstring(from: $0)) }, blockRanges: blockRanges)
    }
}

__MESSAGE_TEXT_RANGE__

func quote(_ layout: TextViewLayout, _ message: Message) -> EngineMessageReplyQuote? {
    captured = nil
    replied = false
    alerted = false
    let selectedRange = layout.selectedRange.range
    let selectedString = layout.attributedString.attributedSubstring(from: selectedRange)
    let handler: () -> Void = {
        __HANDLER__
    }
    handler()
    return captured
}

func embedCustomEmoji(_ string: NSMutableAttributedString) {
    var emoji: [NSRange] = []
    string.enumerateAttribute(TextInputAttributes.customEmoji, in: string.range, options: []) { value, range, _ in
        if value is TextInputTextCustomEmojiAttribute {
            emoji.append(range)
        }
    }
    for range in emoji.reversed() {
        string.replaceCharacters(in: range, with: NSAttributedString(string: "🤡", attributes: string.attributes(at: range.location, effectiveRange: nil)))
    }
}

func shown(_ message: Message, caption: Bool = false) -> NSMutableAttributedString {
    let (text, entities) = resolveFormattedDateEntities(message.text, entities: message.textEntities?.entities ?? [])
    let string = NSMutableAttributedString(string: text)
    for (index, entity) in entities.enumerated() {
        let range = NSRange(location: entity.range.lowerBound, length: entity.range.count)
        switch entity.type {
        case .BlockQuote, .Pre:
            string.addAttribute(TextInputAttributes.quote, value: TextViewBlockQuoteData(id: index + 1), range: range)
        case .FormattedDate:
            string.addAttribute(TextInputAttributes.formattedDate, value: TextViewFormattedDateData(), range: range)
        case let .CustomEmoji(_, fileId):
            string.addAttribute(TextInputAttributes.customEmoji, value: TextInputTextCustomEmojiAttribute(fileId: fileId, emoji: string.attributedSubstring(from: range).string), range: range)
        case .Bold:
            string.addAttribute(TextInputAttributes.bold, value: true as NSNumber, range: range)
        default:
            break
        }
    }
    if caption {
        string.removeWhitespaceFromQuoteAttribute()
        embedCustomEmoji(string)
    } else {
        embedCustomEmoji(string)
        string.removeWhitespaceFromQuoteAttribute()
    }
    return string
}

func select(_ layout: FoldingTextLayout, from start: Int, to end: Int) {
    for (block, range) in zip(layout.blocks, layout.blockRanges) {
        let lower = Swift.max(start, range.location)
        let upper = Swift.min(end, NSMaxRange(range))
        block.text.selectedRange.range = lower < upper ? NSMakeRange(lower - range.location, upper - lower) : NSMakeRange(NSNotFound, 0)
    }
}

var total = 0
var failed = 0

func check(_ name: String, _ condition: Bool, _ detail: @autoclosure () -> String) {
    total += 1
    if !condition {
        failed += 1
        print("FAIL \(name): \(detail())")
    }
}

func checkAtOffset(_ name: String, _ result: EngineMessageReplyQuote?, _ text: String) {
    guard let result, let offset = result.offset, !result.text.isEmpty else {
        return
    }
    let at = NSRange(location: offset, length: (result.text as NSString).length)
    let found = offset >= 0 && NSMaxRange(at) <= (text as NSString).length ? (text as NSString).substring(with: at) : "<past the end>"
    check("\(name) is at its offset", found == result.text, "the message has \(found.debugDescription) at offset \(offset)")
}

struct Selection {
    let from: String
    let to: String
    let text: String
    let offset: Int
    var entities: [MessageTextEntity]? = nil
}

struct Case {
    let name: String
    let text: String
    let entities: [MessageTextEntity]
    let selections: [Selection]
}

func entity(_ lower: Int, _ upper: Int, _ type: MessageTextEntityType) -> MessageTextEntity {
    return MessageTextEntity(range: lower ..< upper, type: type)
}

let date = MessageTextEntityType.FormattedDate(format: .full, date: 1794675600)

let cases: [Case] = [
    Case(name: "across the end of a quote", text: "Intro\nQuoted line\nOutro", entities: [entity(6, 17, .BlockQuote(isCollapsed: false))], selections: [
        Selection(from: "line", to: "Out", text: "line\nOut", offset: 13),
        Selection(from: "tro", to: "Quo", text: "tro\nQuo", offset: 2),
        Selection(from: "Quoted", to: "line", text: "Quoted line", offset: 6),
