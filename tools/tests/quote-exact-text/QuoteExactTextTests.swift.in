    Case(name: "across the end of a code block typed with fences", text: "Hi\n\nlet x = 1\n\nBye", entities: [entity(3, 14, .Pre(language: nil))], selections: [
        Selection(from: "1", to: "By", text: "1\n\nBy", offset: 12),
        Selection(from: "Hi", to: "let", text: "Hi\n\nlet", offset: 0),
        Selection(from: "Bye", to: "Bye", text: "Bye", offset: 15),
