        Selection(from: "ted", to: "Out", text: "ted\n\nOut", offset: 10),
        Selection(from: "Outro", to: "Outro", text: "Outro", offset: 15),
    ]),
    Case(name: "quote inside a line", text: "before quoted after", entities: [entity(7, 13, .BlockQuote(isCollapsed: false))], selections: [
        Selection(from: "quoted", to: "aft", text: "quoted aft", offset: 7),
        Selection(from: "fore", to: "quo", text: "fore quo", offset: 2),
    ]),
    Case(name: "two quotes in a row", text: "A\nB\nC", entities: [entity(0, 1, .BlockQuote(isCollapsed: false)), entity(2, 3, .BlockQuote(isCollapsed: false)), entity(4, 5, .BlockQuote(isCollapsed: false))], selections: [
        Selection(from: "A", to: "C", text: "A\nB\nC", offset: 0),
        Selection(from: "C", to: "C", text: "C", offset: 4),
    ]),
    Case(name: "formatted date", text: "Call at 5 please", entities: [entity(8, 9, date)], selections: [
        Selection(from: "11/14/26, 5:00 PM", to: "11/14/26, 5:00 PM", text: "5", offset: 8),
        Selection(from: "at", to: "ple", text: "at 5 ple", offset: 5),
        Selection(from: "5:00", to: "ple", text: "5 ple", offset: 8),
        Selection(from: "Call", to: "14", text: "Call at 5", offset: 0),
        Selection(from: "please", to: "please", text: "please", offset: 10),
    ]),
    Case(name: "custom emoji one unit long", text: "Done ✅ now", entities: [entity(5, 6, .CustomEmoji(stickerPack: nil, fileId: 1))], selections: [
        Selection(from: "now", to: "now", text: "now", offset: 7),
        Selection(from: "Done", to: "now", text: "Done ✅ now", offset: 0, entities: [entity(5, 6, .CustomEmoji(stickerPack: nil, fileId: 1))]),
    ]),
    Case(name: "custom emoji four units long", text: "👍🏻 ok 👍🏻 fine", entities: [entity(0, 4, .CustomEmoji(stickerPack: nil, fileId: 2)), entity(8, 12, .CustomEmoji(stickerPack: nil, fileId: 2))], selections: [
        Selection(from: "ok", to: "ok", text: "ok", offset: 5),
        Selection(from: "ok", to: "fine", text: "ok 👍🏻 fine", offset: 5, entities: [entity(3, 7, .CustomEmoji(stickerPack: nil, fileId: 2))]),
    ]),
    Case(name: "custom emoji next to each other", text: "go ✅✅ now", entities: [entity(3, 4, .CustomEmoji(stickerPack: nil, fileId: 1)), entity(4, 5, .CustomEmoji(stickerPack: nil, fileId: 1))], selections: [
        Selection(from: "go", to: "now", text: "go ✅✅ now", offset: 0, entities: [entity(3, 4, .CustomEmoji(stickerPack: nil, fileId: 1)), entity(4, 5, .CustomEmoji(stickerPack: nil, fileId: 1))]),
        Selection(from: "now", to: "now", text: "now", offset: 6),
    ]),
    Case(name: "bold before a quote", text: "Intro bold\nQuoted\nOutro", entities: [entity(6, 10, .Bold), entity(11, 17, .BlockQuote(isCollapsed: false))], selections: [
        Selection(from: "bold", to: "Quo", text: "bold\nQuo", offset: 6, entities: [entity(0, 4, .Bold)]),
    ]),
    Case(name: "repeated text after a code block", text: "same\n\ncode\n\nsame", entities: [entity(5, 11, .Pre(language: nil))], selections: [
        Selection(from: "code\nsame", to: "code\nsame", text: "code\n\nsame", offset: 6),
