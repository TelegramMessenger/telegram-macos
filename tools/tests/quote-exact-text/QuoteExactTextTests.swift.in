]

for (item, caption) in cases.flatMap({ item in [(item, false), (item, true)] }) {
    let message = Message(item.text, item.entities)
    let string = shown(message, caption: caption)
    let layout = FoldingTextLayout.make(string)
    let shownText = string.string as NSString
    for selection in item.selections {
        let name = "\(item.name)\(caption ? " (caption)" : ""): \(selection.text.debugDescription)"
        let start = shownText.range(of: selection.from)
        let end = start.location == NSNotFound ? start : shownText.range(of: selection.to, options: [], range: NSRange(location: start.location, length: shownText.length - start.location))
        guard start.location != NSNotFound, end.location != NSNotFound else {
            check(name, false, "the selection from \(selection.from.debugDescription) to \(selection.to.debugDescription) is not in the shown text \(string.string.debugDescription)")
            continue
        }
        select(layout, from: start.location, to: NSMaxRange(end))
        guard let result = quote(layout.merged, message) else {
            check(name, false, "Quote set up no reply")
            continue
        }
        check("\(name) text", result.text == selection.text, "quoted \(result.text.debugDescription)")
        check("\(name) is in the message", (item.text as NSString).range(of: result.text).location != NSNotFound, "quoted \(result.text.debugDescription), not a part of \(item.text.debugDescription)")
        check("\(name) offset", result.offset == selection.offset, "offset \(result.offset.map(String.init) ?? "nil"), the quote starts at \(selection.offset) in the message")
        if let offset = result.offset, !result.text.isEmpty {
            let at = NSRange(location: offset, length: (result.text as NSString).length)
            let found = NSMaxRange(at) <= (item.text as NSString).length ? (item.text as NSString).substring(with: at) : "<past the end>"
            check("\(name) is at its offset", found == result.text, "the message has \(found.debugDescription) at offset \(offset)")
        }
        if let entities = selection.entities {
            check("\(name) entities", result.entities == entities, "entities \(result.entities)")
        }
    }
}

do {
    let message = Message("Done ✅ now", [entity(5, 6, .CustomEmoji(stickerPack: nil, fileId: 1))])
    let string = shown(message)
    let layout = FoldingTextLayout.make(string)
    select(layout, from: 6, to: string.length)
    let result = quote(layout.merged, message)
    check("a selection that starts inside a custom emoji takes the whole emoji", result?.text == "✅ now" && result?.offset == 5, "quoted \(result?.text.debugDescription ?? "nothing") at \(result?.offset.map(String.init) ?? "nil")")
    checkAtOffset("a selection that starts inside a custom emoji", result, message.text)
}

do {
    let message = Message("Intro\nQuoted\nat 5 please", [entity(6, 12, .BlockQuote(isCollapsed: false)), entity(16, 17, .FormattedDate(format: .relative, date: 1794675600))])
    let string = shown(message)
    let layout = FoldingTextLayout.make(string)
    let last = layout.blocks[layout.blocks.count - 1].text
    let updated = NSMutableAttributedString(attributedString: last.attributedString)
    var run = NSRange()
    _ = updated.attribute(TextInputAttributes.formattedDate, at: 3, longestEffectiveRange: &run, in: updated.range)
    updated.replaceCharacters(in: run, with: NSAttributedString(string: "in 1 minute", attributes: updated.attributes(at: run.location, effectiveRange: nil)))
    last.setAttributedString(updated)
    for block in layout.blocks {
        block.text.selectedRange.range = NSMakeRange(NSNotFound, 0)
    }
    layout.blocks[1].text.selectedRange.range = NSMakeRange(3, 3)
    last.selectedRange.range = NSMakeRange(0, (updated.string as NSString).range(of: "ple").location + 3)
    let result = quote(layout.merged, message)
    check("a relative date updated after layout", result?.text == "ted\nat 5 ple" && result?.offset == 9, "quoted \(result?.text.debugDescription ?? "nothing") at \(result?.offset.map(String.init) ?? "nil")")
    checkAtOffset("a relative date updated after layout", result, message.text)
}

do {
    let message = Message("a   b", [])
    let string = shown(message)
    let layout = FoldingTextLayout.make(string)
    select(layout, from: 1, to: 4)
    let result = quote(layout.merged, message)
    check("a selection of spaces only: a reply without a quote", replied && result == nil, "replied \(replied), quoted \(result?.text.debugDescription ?? "nothing")")
}

do {
    let message = Message("a \u{94D}k", [])
    let string = shown(message)
    let layout = FoldingTextLayout.make(string)
    select(layout, from: 1, to: 4)
    let result = quote(layout.merged, message)
    check("a combining mark after a space", result?.text == "\u{94D}k" && result?.offset == 2, "quoted \(result?.text.debugDescription ?? "nothing") at \(result?.offset.map(String.init) ?? "nil")")
    checkAtOffset("a combining mark after a space", result, message.text)
}

do {
    let message = Message("Original text", [])
    let layout = TextViewLayout(NSAttributedString(string: "A summary"))
    layout.selectedRange.range = NSMakeRange(2, 7)
    let result = quote(layout, message)
    check("text that is not the message's: Quote keeps working", result?.text == "summary", "quoted \(result?.text.debugDescription ?? "nothing")")
}

do {
    let message = Message("Call at 5", [entity(8, 12, date)])
    let string = shown(message)
    let layout = FoldingTextLayout.make(string)
    select(layout, from: 0, to: string.length)
    let result = quote(layout.merged, message)
    check("a date entity past the end of the text: Quote keeps working", result != nil, "Quote set up no reply")
}

do {
    let message = Message("abcdefghij", [])
    let layout = TextViewLayout(NSAttributedString(string: message.text))
    layout.selectedRange.range = NSMakeRange(0, 10)
    _ = quote(layout, message)
    check("limit: a short quote passes", !alerted, "alerted")
    let long = String(repeating: "a", count: 1025)
    let longLayout = TextViewLayout(NSAttributedString(string: long))
    longLayout.selectedRange.range = NSMakeRange(0, 1025)
    let result = quote(longLayout, Message(long, []))
    check("limit: a quote over quote_length_max alerts", alerted && result == nil, "no alert for 1025 characters")
}

print("\(total - failed)/\(total) checks passed")
exit(failed == 0 ? 0 : 1)
