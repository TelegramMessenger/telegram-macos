import Cocoa

final class NSKeyValueObservation {
    private let cancel: () -> Void
    init(_ cancel: @escaping () -> Void) { self.cancel = cancel }
    deinit { cancel() }
}

final class WKFindConfiguration {
    var backwards = false
    var caseSensitive = false
    var wraps = true
}

struct WKFindResult {
    let matchFound: Bool
}

final class WKWebView: NSView {
    var searches: [(String, Bool)] = []
    func find(_ query: String, configuration: WKFindConfiguration, completionHandler: @escaping (WKFindResult) -> Void) {
        searches.append((query, configuration.backwards))
        completionHandler(WKFindResult(matchFound: !query.isEmpty))
    }
    var url: URL? { didSet { notify(\WKWebView.url) } }
    var isLoading = false { didSet { notify(\WKWebView.isLoading) } }
    private var observers: [UUID: (AnyKeyPath, () -> Void)] = [:]
    func observe<Value>(_ path: KeyPath<WKWebView, Value>, options: NSKeyValueObservingOptions, changeHandler: @escaping (WKWebView, Void) -> Void) -> NSKeyValueObservation {
        let id = UUID()
        observers[id] = (path, { [weak self] in
            if let self { changeHandler(self, ()) }
        })
        return NSKeyValueObservation { [weak self] in self?.observers.removeValue(forKey: id) }
    }
    private func notify(_ path: AnyKeyPath) {
        for entry in Array(observers.values) where entry.0 == path { entry.1() }
    }
}

final class NSTextFinder {
    typealias Action = AppKit.NSTextFinder.Action
    static weak var latest: NSTextFinder?
    weak var client: WKWebView?
    weak var findBarContainer: (any NSTextFinderBarContainer)?
    var isIncrementalSearchingEnabled = false
    var incrementalSearchingShouldDimContentView = false
    var actions: [Action] = []
    var notes = 0
    var cancellations = 0
    init() { Self.latest = self }
    func performAction(_ action: Action) {
        actions.append(action)
        if action == .showFindInterface { findBarContainer?.isFindBarVisible = true }
        if action == .hideFindInterface { findBarContainer?.isFindBarVisible = false }
    }
    func cancelFindIndicator() { cancellations += 1 }
    func noteClientStringWillChange() { notes += 1 }
}

final class PageFindBarView: NSView {
    var query = ""
    var queryUpdated: ((String) -> Void)?
    var navigate: ((Bool) -> Void)?
    var close: (() -> Void)?
    var found: Bool?
    var loading = false
    func focus() {}
    func containsResponder(_ responder: NSResponder?) -> Bool { false }
    func updateResult(index: Int? = nil, count: Int? = nil, found: Bool? = nil, loading: Bool = false) {
        self.found = found
        self.loading = loading
    }
}

final class FindContainer: NSObject, BrowserPageFindContainer {
    var pageFindBar: PageFindBarView?
    var findBarView: NSView?
    var isFindBarVisible = false
    func findBarViewDidChangeHeight() {}
}
