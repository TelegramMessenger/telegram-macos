import Foundation
import CoreFoundation
import QuartzCore
import SwiftSignalKit

public struct PeerId: Hashable { let value: Int64 }
public struct MessageId: Hashable, Comparable {
    let peerId: PeerId
    let namespace: Int32
    let id: Int32
    public static func < (lhs: MessageId, rhs: MessageId) -> Bool {
        if lhs.peerId != rhs.peerId { return lhs.peerId.value < rhs.peerId.value }
        if lhs.namespace != rhs.namespace { return lhs.namespace < rhs.namespace }
        return lhs.id < rhs.id
    }
}
public struct MediaId: Equatable { let namespace: Int32; let id: Int64 }
public enum Namespaces {
    public enum Message { static let Cloud: Int32 = 0 }
}
struct MessageFlags: OptionSet {
    let rawValue: Int
    static let Failed = MessageFlags(rawValue: 1)
    static let Sending = MessageFlags(rawValue: 2)
    static let Unsent = MessageFlags(rawValue: 4)
}
struct ForwardInfo { let date: Int32 }
public class Peer { var displayTitle = ""; var id = PeerId(value: 1); var canUseInputPeer = true }
public class Message {
    let id: MessageId
    var timestamp: Int32
    var forwardInfo: ForwardInfo?
    var flags: MessageFlags = []
    var media: [Any]
    var peers: [PeerId: Peer] = [:]
    var anyMedia: Any? { media.first }
    init(id: MessageId = MessageId(peerId: PeerId(value: 1), namespace: 0, id: 1), timestamp: Int32 = 100, forward: Int32? = nil, poll: TelegramMediaPoll) {
        self.id = id
        self.timestamp = timestamp
        self.forwardInfo = forward.map { ForwardInfo(date: $0) }
        self.media = [poll]
    }
}
struct TelegramMediaPollOption { let opaqueIdentifier: Data }
struct TelegramMediaPollOptionVoters {
    let selected: Bool
    let opaqueIdentifier: Data
    let count: Int32?
    let isCorrect: Bool
    let recentVoters: [PeerId]
}
struct TelegramMediaPollResults {
    var voters: [TelegramMediaPollOptionVoters]?
    var totalVoters: Int32?
}
enum TelegramMediaPollPublicity { case anonymous; case `public` }
public class TelegramMediaPoll {
    var pollId = MediaId(namespace: 0, id: 101)
    var isClosed = false
    var deadlineTimeout: Int32?
    var deadlineDate: Int32?
    var hideResultsUntilClose = false
    var openAnswers = true
    var countries: [String] = []
    var restrictToSubscribers = false
    var isMultiple = false
    var isQuiz = false
    var publicity: TelegramMediaPollPublicity = .anonymous
    var options = [TelegramMediaPollOption(opaqueIdentifier: Data([1])), TelegramMediaPollOption(opaqueIdentifier: Data([2]))]
    var results = TelegramMediaPollResults(voters: nil, totalVoters: nil)
}
enum GetMessagesResult { case progress; case result([Message]) }
enum GetMessagesStrategy { case local; case cloud(skipLocal: Bool) }
enum GetMessagesError: Error { case privateChannel }
enum RequestMessageSelectPollOptionError: Error { case generic; case restrictedToSubscribers }
struct CachedChannelData {
    let minAvailableMessageId: MessageId?
}
enum Api {
    struct InputPeer { let id: PeerId }
    struct Updates { let messages: [Message] }
    struct Request { let peer: InputPeer; let id: Int32; let hash: Int64 }
    enum functions {
        enum messages {
            static func getPollResults(peer: InputPeer, msgId: Int32, pollHash: Int64) -> Request {
                Request(peer: peer, id: msgId, hash: pollHash)
            }
        }
    }
}
func apiInputPeer(_ peer: Peer) -> Api.InputPeer? { peer.canUseInputPeer ? Api.InputPeer(id: peer.id) : nil }
final class Network {
    var now: Int32 = 100
    var requests: [Api.Request] = []
    var response: Signal<GetMessagesResult, GetMessagesError> = .single(.result([]))
    func getApproximateRemoteTimestamp() -> Int32 { now }
    func request(_ request: Api.Request) -> Signal<Api.Updates, GetMessagesError> {
        requests.append(request)
        return response |> mapToSignal { value -> Signal<Api.Updates, GetMessagesError> in
            switch value {
            case .progress: return .complete()
            case let .result(messages): return .single(Api.Updates(messages: messages))
            }
        }
    }
}
final class Transaction {
    let postbox: Postbox
    init(_ postbox: Postbox) { self.postbox = postbox }
    func getMessage(_ id: MessageId) -> Message? { postbox.message?.id == id ? postbox.message : nil }
    func getPeer(_ id: PeerId) -> Peer? { postbox.peer?.id == id ? postbox.peer : nil }
    func getPeerCachedData(peerId: PeerId) -> Any? { postbox.cachedData }
}
final class Postbox {
    var message: Message?
    var peer: Peer? = Peer()
    var cachedData: CachedChannelData?
    var transactions = 0
    func transaction<T>(_ body: @escaping (Transaction) -> T) -> Signal<T, NoError> {
        return Signal { subscriber in
            Queue.mainQueue().async {
                self.transactions += 1
                subscriber.putNext(body(Transaction(self)))
                subscriber.putCompletion()
            }
            return EmptyDisposable
        }
    }
}
final class StateManager {
    let postbox: Postbox
    var updates: [Api.Updates] = []
    var barrierCount = 0
    var barrier: Signal<[MessageId], NoError> = .single([])
    var applyBeforeBarrier: (() -> Void)?
    init(_ postbox: Postbox) { self.postbox = postbox }
    func addUpdates(_ updates: Api.Updates) { self.updates.append(updates) }
    func pollStateUpdateCompletion() -> Signal<[MessageId], NoError> {
        barrierCount += 1
        return barrier |> map { value in
            for updates in self.updates {
                if let current = self.postbox.message, let matching = updates.messages.first(where: { $0.id == current.id && ($0.anyMedia as? TelegramMediaPoll)?.pollId == (current.anyMedia as? TelegramMediaPoll)?.pollId }) {
                    self.postbox.message = matching
                }
            }
            self.updates.removeAll()
            self.applyBeforeBarrier?()
            return value
        }
    }
}
final class Account {
    let network = Network()
    let postbox = Postbox()
    lazy var stateManager = StateManager(postbox)
}
final class MessagesAPI {
    let account: Account
    var genericRequests: [(MessageId, Bool)] = []
    var requests: [(MessageId, Bool)] { genericRequests + account.network.requests.map { (MessageId(peerId: $0.peer.id, namespace: 0, id: $0.id), $0.hash == 0) } }
    var votes: [[Data]] = []
    var response: Signal<GetMessagesResult, GetMessagesError> {
        get { account.network.response }
        set { account.network.response = newValue }
    }
    init(_ account: Account) { self.account = account }
    func getMessagesLoadIfNecessary(_ messageIds: [MessageId], strategy: GetMessagesStrategy = .cloud(skipLocal: false)) -> Signal<GetMessagesResult, GetMessagesError> {
        let transaction = Transaction(account.postbox)
        @@LOADER_FILTER@@
        guard !ids.isEmpty else { return .single(.result([])) }
        let skip: Bool
        if case let .cloud(value) = strategy { skip = value } else { skip = false }
        genericRequests.append((ids[0], skip))
        return response
    }
    @@CORE_WRAPPER@@
    func requestMessageSelectPollOption(messageId: MessageId, opaqueIdentifiers: [Data]) -> Signal<TelegramMediaPoll?, RequestMessageSelectPollOptionError> {
        votes.append(opaqueIdentifiers)
        return .single(nil)
    }
}
final class Engine {
    let messages: MessagesAPI
    init(_ account: Account) { self.messages = MessagesAPI(account) }
}
@@CORE_REFRESH@@
protocol AccountContextProtocol: AnyObject { var engine: Engine { get }; var account: Account { get }; var window: NSWindow { get } }
final class Context: AccountContextProtocol { let account = Account(); lazy var engine = Engine(account); let window = NSWindow() }
class NSWindow {}
class Control {
    var window: NSWindow?
    var visibleRect = CGRect(x: 0, y: 0, width: 400, height: 200)
    func viewWillMove(toWindow newWindow: NSWindow?) {}
    func viewDidMoveToWindow() {}
}
struct Labels {
    let unknownError = "generic"
    let chatPollVotingClosed = "closed"
    let chatMessageMenuItemsAndJoiner = " and "
    let chatMessageMenuItemsOnlyOldSubscribersCanVote = "subscriber"
    func chatMessageMenuItemsOnlyUsersFromCountriesCanVote(_ countries: String) -> String { "country" }
    func chatMessageMenuItemsOnlySubscribersOfCanVote(_ title: String) -> String { "subscriber" }
}
struct Appearance { let locale = Locale(identifier: "en_US") }
let appAppearance = Appearance()
func strings() -> Labels { Labels() }
var alerts: [String] = []
func alert(for window: NSWindow, info: String) { alerts.append(info) }
func showModalText(for window: NSWindow, text: String) { alerts.append(text) }
func showModalProgress<T, E>(signal: Signal<T, E>, for window: NSWindow) -> Signal<T, E> { signal }
