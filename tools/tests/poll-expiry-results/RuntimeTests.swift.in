    var state = PollRefreshState()
    expect(state.update(messageId: message.id, pollId: poll.pollId, deadline: 160), "refresh new identity resets budget")
    let first = state.begin(now: 0)!
    expect(state.begin(now: 100) == nil, "refresh in flight deduplicated")
    expect(!state.update(messageId: message.id, pollId: poll.pollId, deadline: 160), "same row rebuild preserves budget")
    expect(state.finish(first), "matching response completes request")
    expect(state.begin(now: 4.99) == nil, "refresh spacing bounded")
    let second = state.begin(now: 5)!
    state.cancel()
    expect(!state.finish(second), "cancel ignores stale completion")
    let third = state.begin(now: 10)!
    expect(!state.finish(second) && state.inFlight, "old response cannot complete newer request")
    expect(state.finish(third), "current response accepted")
    expect(state.begin(now: 1000) == nil && state.attempts == 3, "three attempt hard bound")
    state.cancel()
    expect(state.begin(now: 2000) == nil, "detach does not reset exhausted budget")
    _ = state.update(messageId: message.id, pollId: poll.pollId, deadline: 200)
    expect(state.begin(now: 2001) != nil, "changed deadline gets fresh budget")
    expect(pollDeadlineTimestamp(message: Message(timestamp: Int32.max, poll: poll), poll: poll) == 160, "absolute timestamp stays absolute near overflow")
    poll.deadlineDate = nil
    poll.deadlineTimeout = 60
    expect(pollDeadlineTimestamp(message: Message(timestamp: Int32.max, poll: poll), poll: poll) == Int64(Int32.max) + 60, "relative timestamp addition does not overflow")
}
