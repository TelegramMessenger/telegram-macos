do {
    let (context, poll, message, row) = fixture(now: 160, deadline: 160)
    let closedPoll = TelegramMediaPoll()
    closedPoll.isClosed = true
    context.engine.messages.response = .single(.result([Message(id: message.id, poll: closedPoll)]))
    let controller = Controller(context)
    alerts = []
    controller.submit(messageId: message.id, opaqueIdentifiers: [Data([1])])
    spin()
    expect(context.engine.messages.votes.isEmpty && alerts == ["closed"], "late preflight confirms closure without sending vote")
    let local = Message(id: MessageId(peerId: PeerId(value: 1), namespace: 1, id: 2), poll: closedPoll)
    expect(!pollNeedsResultsRefresh(message: local, poll: closedPoll, timestamp: 160), "closed local poll cannot request cloud message")
    let owner = Owner()
    owner.window = NSWindow()
    owner.bind(row)
    owner.exhaust()
    expect(!owner.timerRunning, "exhausted owner timer is stopped")
    owner.viewWillMove(toWindow: nil)
    owner.window = nil
    let requests = context.engine.messages.requests.count
    owner.window = NSWindow()
    owner.viewDidMoveToWindow()
    spin()
    expect(context.engine.messages.requests.count == requests + 1 && owner.attempts == 1, "real reattachment permits a fresh bounded refresh")
    owner.viewWillMove(toWindow: nil)
    poll.isClosed = true
}
