        receivedNil = value == nil
    })
    spin(10.2)
    expect(values == 1 && receivedNil && disposed == 1, "actual signal timeout yields missing result and disposes request")
    disposable.dispose()
}
for floor in [Int32?.none, Int32?(100)] {
    let context = Context()
    let poll = TelegramMediaPoll()
    let id = MessageId(peerId: PeerId(value: 1), namespace: 0, id: 110)
    let message = Message(id: id, poll: poll)
    context.account.postbox.message = message
    context.account.postbox.cachedData = floor.map { CachedChannelData(minAvailableMessageId: MessageId(peerId: id.peerId, namespace: 0, id: $0)) }
    let closed = TelegramMediaPoll()
    closed.isClosed = true
    closed.results = TelegramMediaPollResults(voters: [voter(1, 3), voter(2, 1)], totalVoters: 4)
    context.engine.messages.response = .single(.result([Message(id: id, poll: closed)]))
    var result: Message?
    let disposable = refreshPollMessage(context: context, messageId: id, pollId: poll.pollId).start(next: { result = $0 })
    spin()
    expect(context.engine.messages.requests.count == 1, "floor \(String(describing: floor)) requests available poll110")
    expect((result?.anyMedia as? TelegramMediaPoll)?.isClosed == true, "floor \(String(describing: floor)) returns server closure")
    expect(context.engine.messages.genericRequests.isEmpty, "floor \(String(describing: floor)) bypasses generic loader")
    disposable.dispose()
}
#if REFRESH_FIXED
for unavailable in [Int32(90), 100] {
    let context = Context()
    let poll = TelegramMediaPoll()
    let id = MessageId(peerId: PeerId(value: 1), namespace: 0, id: unavailable)
    context.account.postbox.message = Message(id: id, poll: poll)
    context.account.postbox.cachedData = CachedChannelData(minAvailableMessageId: MessageId(peerId: id.peerId, namespace: 0, id: 100))
    var received = false
    let disposable = refreshPollMessage(context: context, messageId: id, pollId: poll.pollId).start(next: { received = $0 == nil })
    spin()
    expect(received && context.engine.messages.requests.isEmpty, "unavailable poll\(unavailable) cannot request")
    disposable.dispose()
}
for invalid in ["local", "missing-message", "wrong-poll", "missing-peer", "no-input-peer"] {
    let context = Context()
    let poll = TelegramMediaPoll()
    let id = MessageId(peerId: PeerId(value: 1), namespace: invalid == "local" ? 1 : 0, id: 110)
    context.account.postbox.message = invalid == "missing-message" ? nil : Message(id: id, poll: poll)
    if invalid == "missing-peer" { context.account.postbox.peer = nil }
    if invalid == "no-input-peer" { context.account.postbox.peer?.canUseInputPeer = false }
    let pollId = invalid == "wrong-poll" ? MediaId(namespace: 0, id: 999) : poll.pollId
    var received = false
    let disposable = refreshPollMessage(context: context, messageId: id, pollId: pollId).start(next: { received = $0 == nil })
    spin()
    expect(received && context.engine.messages.requests.isEmpty, "\(invalid) produces nil without RPC")
    disposable.dispose()
}
do {
    let (context, poll, message, _) = fixture(now: 160, deadline: 160)
    let closed = TelegramMediaPoll()
    closed.isClosed = true
    context.engine.messages.response = .single(.result([Message(id: message.id, poll: closed)]))
    var barrierSubscriber: Subscriber<[MessageId], NoError>?
    context.account.stateManager.barrier = Signal { subscriber in
        barrierSubscriber = subscriber
        return EmptyDisposable
    }
    var result: Message?
    let disposable = refreshPollMessage(context: context, messageId: message.id, pollId: poll.pollId).start(next: { result = $0 })
    spin()
    expect(result == nil && context.account.postbox.message === message, "refresh waits for state replay barrier")
    expect(context.account.stateManager.barrierCount == 1 && context.account.stateManager.updates.count == 1, "RPC update queued before barrier")
    expect(context.account.network.requests.first?.hash == 0, "refresh requests complete poll results without cached hash")
    barrierSubscriber?.putNext([])
    barrierSubscriber?.putCompletion()
    spin()
    expect((result?.anyMedia as? TelegramMediaPoll)?.isClosed == true, "refresh reads replayed message after barrier")
    disposable.dispose()
}
for mutation in ["deleted", "different-poll"] {
    let (context, poll, message, _) = fixture(now: 160, deadline: 160)
    context.engine.messages.response = .single(.result([message]))
    context.account.stateManager.applyBeforeBarrier = {
        if mutation == "deleted" { context.account.postbox.message = nil }
        else {
            let replacement = TelegramMediaPoll()
            replacement.pollId = MediaId(namespace: 0, id: 999)
            context.account.postbox.message = Message(id: message.id, poll: replacement)
        }
    }
    var received = false
    let disposable = refreshPollMessage(context: context, messageId: message.id, pollId: poll.pollId).start(next: { received = $0 == nil })
    spin()
    expect(received, "\(mutation) during refresh rejected on final read")
    disposable.dispose()
}
do {
    let (context, poll, message, _) = fixture(now: 160, deadline: 160)
    context.engine.messages.response = .single(.result([message]))
    var barrierSubscriber: Subscriber<[MessageId], NoError>?
    var disposed = 0
    context.account.stateManager.barrier = Signal { subscriber in
        barrierSubscriber = subscriber
        return ActionDisposable { disposed += 1 }
    }
    var values = 0
    let disposable = refreshPollMessage(context: context, messageId: message.id, pollId: poll.pollId).start(next: { _ in values += 1 })
    spin()
    let transactions = context.account.postbox.transactions
    disposable.dispose()
    barrierSubscriber?.putNext([])
    barrierSubscriber?.putCompletion()
    spin()
    expect(disposed == 1 && values == 0 && context.account.postbox.transactions == transactions, "cancelled state barrier cannot read or deliver stale message")
}
