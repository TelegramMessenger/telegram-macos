struct Option {
    var isSelected = false
    var isMultipleSelected = false
    var isLoading = false
}
struct Aggregate { let percent: Float?; let count: Int32?; let peers: [PeerId] }
final class Row {
    var message: Message?
    let poll: TelegramMediaPoll
    let context: Context
    var options: [Option] = []
    var copies = 0
    init(_ message: Message, context: Context) {
        self.message = message
        self.poll = message.anyMedia as! TelegramMediaPoll
        self.context = context
        self.options = poll.results.voters?.map { Option(isSelected: $0.selected) } ?? []
    }
    func copyAndUpdate(animated: Bool) { copies += 1 }
    var canVote: Bool { canInvokeVote }
    @@PROPERTIES@@
    func aggregates() -> [Aggregate] {
        let displayOptions = poll.options
        let displayIndices = Array(poll.options.indices)
        var output: [Aggregate] = []
        @@AGGREGATE@@
    }
}
final class Owner: Control {
    weak var currentItem: Row?
    @@OWNER_FIELDS@@
    @@OWNER_METHODS@@
    func updateResultsIn() {}
    func bind(_ item: Row) { @@OWNER_BIND@@ }
    func tick() { @@OWNER_TICK@@ }
    var attempts: Int { @@OWNER_ATTEMPTS@@ }
    var timerRunning: Bool { resultsInTimer != nil }
    func exhaust() { @@OWNER_EXHAUST@@ }
}
struct ChatPollStateData {
    var identifiers: [Data]
    var isLoading: Bool
}
struct State { var pollAnswers: [MessageId: ChatPollStateData] = [:] }
final class Controller {
    let context: Context
    let selectMessagePollOptionDisposables = DisposableDict<MessageId>()
    var state = State()
    init(_ context: Context) { self.context = context }
    deinit { selectMessagePollOptionDisposables.dispose() }
    func updateState(_ f: (State) -> State) { state = f(state) }
    func submit(messageId: MessageId, opaqueIdentifiers: [Data]) {
        let context = self.context
        let submit = true
        state.pollAnswers[messageId] = ChatPollStateData(identifiers: opaqueIdentifiers, isLoading: true)
        @@PREFLIGHT@@
        @@PREFLIGHT_START@@
    }
    func fail(messageId: MessageId, error: RequestMessageSelectPollOptionError) {
        let context = self.context
        let handler: (RequestMessageSelectPollOptionError) -> Void = { [weak self] error in
            @@ERROR_BODY@@
        }
        handler(error)
    }
}

var checks = 0
var failures = 0
func expect(_ value: @autoclosure () -> Bool, _ name: String) {
    checks += 1
    if value() { print("PASS \(name)") } else { failures += 1; print("FAIL \(name)") }
}
func spin(_ interval: Double = 0.025) {
    RunLoop.main.run(until: Date(timeIntervalSinceNow: interval))
}
func voter(_ id: UInt8, _ count: Int32?, selected: Bool = false, peers: [PeerId] = []) -> TelegramMediaPollOptionVoters {
    TelegramMediaPollOptionVoters(selected: selected, opaqueIdentifier: Data([id]), count: count, isCorrect: false, recentVoters: peers)
}
func fixture(now: Int32 = 100, deadline: Int32? = nil, relative: Int32? = nil, closed: Bool = false, timestamp: Int32 = 100, forward: Int32? = nil) -> (Context, TelegramMediaPoll, Message, Row) {
    let context = Context()
    context.account.network.now = now
    let poll = TelegramMediaPoll()
    poll.deadlineDate = deadline
    poll.deadlineTimeout = relative
    poll.isClosed = closed
    let message = Message(timestamp: timestamp, forward: forward, poll: poll)
    context.account.postbox.message = message
    return (context, poll, message, Row(message, context: context))
}

for absolute in [false, true] {
    let (context, _, _, row) = fixture(now: 159, deadline: absolute ? 160 : nil, relative: absolute ? nil : 60)
    expect(row.deadlineEndDate == 160, "\(absolute ? "absolute" : "relative") deadline")
    expect(row.showResultsIn, "deadline countdown for nonvoter")
    expect(row.canVote, "vote before deadline")
    context.account.network.now = 160
    expect(!row.canVote, "disable at exact deadline")
    expect(!row.isClosed, "clock does not assert server closure")
}
do {
    let (_, _, _, row) = fixture(now: 160, relative: 60, timestamp: 150, forward: 100)
    expect(row.deadlineEndDate == 160, "forward uses original timestamp")
    expect(!row.canVote, "forwarded relative deadline blocks late vote")
}
do {
    let (_, _, _, row) = fixture(now: 180, deadline: 200, relative: 60, timestamp: 100, forward: 20)
    expect(row.deadlineEndDate == 200, "absolute close date takes precedence")
    expect(row.canVote, "absolute deadline overrides old relative origin")
}
do {
    let (_, _, _, row) = fixture(now: 100, deadline: 101)
    expect(row.canVote, "remote clock not real wall clock controls votes")
    let (_, _, _, indefinite) = fixture(now: Int32.max)
    expect(indefinite.canVote, "untimed poll remains open")
    let (_, _, _, closed) = fixture(now: 0, closed: true)
    expect(!closed.canVote, "server closure blocks regardless of clock")
}
do {
    let (context, poll, _, _) = fixture(now: 300, deadline: 100, relative: 1)
    let local = Message(id: MessageId(peerId: PeerId(value: 1), namespace: 1, id: 1), poll: poll)
    local.flags = .Sending
    let row = Row(local, context: context)
    expect(row.deadlineEndDate == nil, "local outgoing message has no server deadline")
    expect(!row.canVote, "sending flag remains blocked")
}
do {
    let (_, poll, _, row) = fixture(closed: true)
    poll.results = TelegramMediaPollResults(voters: [voter(1, 3), voter(2, 1)], totalVoters: 4)
    expect(row.aggregates().map { $0.percent } == [75, 25], "closed nonvoter sees final aggregates")
    poll.results.voters = [voter(1, 4)]
    expect(row.aggregates().map { $0.percent } == [100, 0], "server sparse zero option preserved")
    poll.results.voters = nil
    expect(row.aggregates().allSatisfy { $0.percent == nil }, "missing server voter data is not zero percent")
    poll.results.totalVoters = nil
    expect(row.aggregates().allSatisfy { $0.percent == nil }, "missing server total is not zero percent")
    poll.results.totalVoters = 0
    expect(row.aggregates().map { $0.percent } == [0, 0], "authoritative zero total renders zero")
    poll.results = TelegramMediaPollResults(voters: [voter(1, nil)], totalVoters: 4)
    expect(row.aggregates().allSatisfy { $0.percent == nil }, "withheld option counts remain unknown")
}
do {
    let (_, poll, _, row) = fixture(now: 300, deadline: 200)
    poll.hideResultsUntilClose = true
    poll.results = TelegramMediaPollResults(voters: [voter(1, 3, selected: true), voter(2, 1)], totalVoters: 4)
    expect(row.aggregates().allSatisfy { $0.percent == nil }, "expired clock cannot reveal hidden results")
    poll.isClosed = true
    expect(row.aggregates().map { $0.percent } == [75, 25], "server closure reveals hidden aggregates")
    poll.isClosed = false
    poll.hideResultsUntilClose = false
    poll.results.voters = [voter(1, 4, selected: true)]
    expect(row.aggregates().map { $0.percent } == [100, 0], "normal voted sparse live results preserved")
    poll.results.voters = [voter(1, 4)]
    expect(row.aggregates().allSatisfy { $0.percent == nil }, "open nonvoter results remain hidden")
}
do {
    let (_, poll, _, row) = fixture(closed: true)
    poll.results = TelegramMediaPollResults(voters: [voter(1, 4, peers: [PeerId(value: 9)])], totalVoters: 4)
    expect(row.aggregates().allSatisfy { $0.peers.isEmpty }, "anonymous aggregates never expose identities")
    poll.publicity = .public
    expect(row.aggregates()[0].peers == [PeerId(value: 9)], "public voter metadata preserved")
}
do {
    let (context, _, message, row) = fixture(now: 160, deadline: 160)
    let owner = Owner()
    owner.window = NSWindow()
    context.engine.messages.response = .single(.result([message]))
    owner.bind(row)
    spin()
    expect(context.engine.messages.requests.count == 1, "already expired initial bind refreshes immediately")
    for _ in 0..<20 { owner.bind(row); owner.tick() }
    expect(context.engine.messages.requests.count == 1, "rebuild does not repeatedly refetch")
    expect(context.engine.messages.requests.allSatisfy { $0.0 == message.id && $0.1 }, "refresh requests matching poll identity")
    owner.exhaust()
    expect(!owner.timerRunning, "exhausted refresh stops timer")
    owner.viewWillMove(toWindow: nil)
    owner.window = nil
    owner.tick()
    expect(context.engine.messages.requests.count == 1, "detached row does not fetch")
}
do {
    let (context, poll, message, row) = fixture(now: 101, deadline: 160)
    poll.results.voters = [voter(1, 1, selected: true)]
    let owner = Owner()
    owner.window = NSWindow()
    owner.bind(row)
    context.account.network.now = 160
    context.engine.messages.response = .single(.result([message]))
    owner.tick()
    spin()
    expect(context.engine.messages.requests.count == 1, "deadline refresh also reaches voted viewers")
    expect(row.copies == 1, "expiry redraw occurs once")
    owner.tick()
    expect(row.copies == 1, "expired row does not redraw forever")
    owner.viewWillMove(toWindow: nil)
}
do {
    let (context, _, message, _) = fixture(now: 160, deadline: 160)
    let controller = Controller(context)
    controller.submit(messageId: message.id, opaqueIdentifiers: [Data([1])])
    spin()
    expect(context.engine.messages.votes.isEmpty, "controller guards stale option click")
    expect(controller.state.pollAnswers[message.id] == nil, "late vote clears transient selection")
    let (openContext, _, openMessage, _) = fixture(now: 159, deadline: 160)
    let openController = Controller(openContext)
    openController.submit(messageId: openMessage.id, opaqueIdentifiers: [])
    spin()
    expect(openContext.engine.messages.votes == [[]], "preclosure retract vote still sent")
}
do {
    let (context, poll, message, _) = fixture(now: 160, deadline: 160)
    let controller = Controller(context)
    alerts = []
    context.engine.messages.response = .single(.result([message]))
    controller.fail(messageId: message.id, error: .generic)
    spin()
    expect(alerts == ["generic"], "expired open cached result keeps generic network error")
    let closedPoll = TelegramMediaPoll()
    closedPoll.isClosed = true
    let updated = Message(id: message.id, poll: closedPoll)
    context.engine.messages.response = .single(.result([updated]))
    alerts = []
    controller.fail(messageId: message.id, error: .generic)
    spin()
    expect(alerts == ["closed"], "race refetch server closure selects closed error")
    context.account.postbox.message = message
    let wrong = Message(id: MessageId(peerId: PeerId(value: 99), namespace: 0, id: message.id.id), poll: closedPoll)
    context.engine.messages.response = .single(.result([wrong]))
    alerts = []
    controller.fail(messageId: message.id, error: .generic)
    spin()
    expect(alerts == ["generic"], "wrong peer response cannot claim closure")
    closedPoll.pollId = MediaId(namespace: 0, id: 999)
    context.engine.messages.response = .single(.result([updated]))
    alerts = []
    controller.fail(messageId: message.id, error: .generic)
    spin()
    expect(alerts == ["generic"], "wrong poll response cannot claim closure")
    context.engine.messages.response = .fail(.privateChannel)
    alerts = []
    controller.fail(messageId: message.id, error: .generic)
    spin()
    expect(alerts == ["generic"], "failed reload keeps generic error")
    for restriction in ["country", "subscriber"] {
        poll.countries = restriction == "country" ? ["US"] : []
        poll.restrictToSubscribers = restriction == "subscriber"
        alerts = []
        controller.fail(messageId: message.id, error: .generic)
        spin()
        expect(alerts == [restriction], "\(restriction) generic fallback survives failed refresh")
    }
    alerts = []
    controller.fail(messageId: message.id, error: .restrictedToSubscribers)
    spin()
    expect(alerts == ["subscriber"], "explicit subscriber rejection preserved")
    poll.isClosed = true
    alerts = []
    controller.fail(messageId: message.id, error: .generic)
    spin()
    expect(alerts == ["closed"], "already stored server closure overrides restriction")
}
