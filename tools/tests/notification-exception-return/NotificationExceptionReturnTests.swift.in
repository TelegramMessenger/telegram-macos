import Foundation
import XCTest

enum KeyHandlerResult: Equatable { case invoked, rejected, invokeNext }
enum EventType { case keyDown, leftMouseUp }
struct Event { let type: EventType; let sending: Bool; let keyCode: Int }
final class App { var currentEvent: Event? }
let NSApp = App()
enum InputDataUIHooks {
    struct Hooks { func checkSendingAbility(_ event: Event) -> Bool { event.sending } }
    static let shared = Hooks()
}
enum InputDataReturnResult { case `default`, nextResponder, nothing, invokeEvent }
enum Failure { case none }
enum InputDataValidation { case none, fail(Failure) }
struct InputDataIdentifier: Hashable {}
struct InputDataValue { let stringValue: String? }
struct Window { func makeFirstResponder(_ value: Int) -> Bool { true } }
struct InputDataEntryId { let identifier: InputDataIdentifier? }
class TableRowItem {
    let stableId = AnyHashable(0)
    var view: RowView?
}
final class InputDataRowItem: TableRowItem { var limit = 0 }
final class RowView { func shakeView() {} }
final class TableView { func enumerateItems(_ visit: (TableRowItem) -> Bool) {} }
extension String { var length: Int { utf16.count } }
struct ModalHeaderData { let image: Int; let handler: () -> Void }
struct Icons { let modalClose = 0 }
struct Theme { let icons = Icons() }
let theme = Theme()
final class InputDataController {
    var validateData: ([InputDataIdentifier: InputDataValue]) -> InputDataValidation = { _ in .fail(.none) }
    var currentFirstResponderIdentifier: InputDataIdentifier? { nil }
    var autoInputAction = false
    var window: Window?
    func nextResponder() -> Int { 0 }
    func returnKeyInvocation(_ identifier: InputDataIdentifier?, _ event: Event) -> InputDataReturnResult { .default }
    func fetchData() -> [InputDataIdentifier: InputDataValue] { [:] }
    func proccessValidation(_ result: InputDataValidation) {}
    let tableView = TableView()
    var leftModalHeader: ModalHeaderData?
    func findItem(for identifier: InputDataIdentifier) -> InputDataRowItem? { nil }
    func inputLimitReached(_ count: Int) {}
    __VALIDATE_INPUT__
    __VALIDATE_VALUES__
    __RETURN_ACTION__
}
final class ModalInteractions {
    let accept: () -> Void
    init(acceptTitle: String, accept: @escaping () -> Void, singleButton: Bool) { self.accept = accept }
}
struct Strings { var modalDone: String { "Done" } }
func strings() -> Strings { Strings() }
enum ExceptionMute { case alwaysOn, alwaysOff }
enum Sound: Equatable { case `default`, none, custom(Int) }
enum Mute { case muted, unmuted }
enum Preview { case show, hide }
struct State {
    var mute: ExceptionMute?
    var previews: Bool?
    var sound: Sound?
}
final class StateValue {
    var value: State
    init(_ value: State) { self.value = value }
    func with<T>(_ body: (State) -> T) -> T { body(value) }
}
final class Recorder { var values: [String] = [] }
struct Action {
    let recorder: Recorder
    let value: String
    func start() -> Int { recorder.values.append(value); return 0 }
}
final class Peers {
    let recorder: Recorder
    init(_ recorder: Recorder) { self.recorder = recorder }
    func updatePeerStoriesMutedSetting(peerId: Int, mute: Mute) -> Action { .init(recorder: recorder, value: "storyMute:\(peerId):\(mute)") }
    func updatePeerStoriesHideSenderSetting(peerId: Int, hideSender: Preview) -> Action { .init(recorder: recorder, value: "storyPreview:\(peerId):\(hideSender)") }
    func updatePeerStorySoundInteractive(peerId: Int, sound: Sound) -> Action { .init(recorder: recorder, value: "storySound:\(peerId):\(sound)") }
    func updatePeerMuteSetting(peerId: Int, threadId: Int?, muteInterval: Int32) -> Action { precondition(threadId == nil); return .init(recorder: recorder, value: "mute:\(peerId):\(muteInterval)") }
    func updatePeerDisplayPreviewsSetting(peerId: Int, threadId: Int?, displayPreviews: Preview) -> Action { precondition(threadId == nil); return .init(recorder: recorder, value: "preview:\(peerId):\(displayPreviews)") }
    func updatePeerNotificationSoundInteractive(peerId: Int, threadId: Int?, sound: Sound) -> Action { precondition(threadId == nil); return .init(recorder: recorder, value: "sound:\(peerId):\(sound)") }
}
struct Engine { let peers: Peers }
struct Context { let engine: Engine }
struct Exceptions {
    let recorder: Recorder
    func add(_ peerId: Int) { recorder.values.append("exception:\(peerId)") }
}
struct Harness {
    let controller: InputDataController
    let modal: ModalInteractions
    let recorder: Recorder
    let state: StateValue
    let cancel: () -> Void
}
func makeHarness(_ initial: State, isStories: Bool) -> Harness {
    let recorder = Recorder()
    let context = Context(engine: Engine(peers: Peers(recorder)))
    let exceptionsContext = Exceptions(recorder: recorder)
    let peerId = 42
    let stateValue = StateValue(initial)
    let controller = InputDataController()
    let close: (() -> Void)? = { recorder.values.append("close") }
    __APPLY_AND_BINDING__
    __CANCEL_HEADER__
    return Harness(controller: controller, modal: modalInteractions, recorder: recorder, state: stateValue, cancel: controller.leftModalHeader!.handler)
}
private func check(_ name: String, _ value: Bool) { record(name, value) }

private var assertions = 0
private var failures: [String] = []
private func record(_ name: String, _ value: Bool, file: StaticString = #filePath, line: UInt = #line) {
    assertions += 1
    if !value { failures.append(name) }
    XCTAssertTrue(value, name, file: file, line: line)
}

final class RegressionTests: XCTestCase {
    @objc func testRegressionScenarios() {
        let states: [State] = [
            .init(),
            .init(mute: .alwaysOn),
            .init(mute: .alwaysOff),
            .init(previews: true),
            .init(previews: false),
            .init(sound: Sound.none),
            .init(sound: .custom(7)),
            .init(mute: .alwaysOff, previews: false, sound: .custom(9))
        ]
        for stories in [false, true] {
            for (index, state) in states.enumerated() {
                let done = makeHarness(state, isStories: stories)
                done.modal.accept()
                let changes: [[String]] = stories ? [
                    [], ["storyMute:42:unmuted"], ["storyMute:42:muted"],
                    ["storyPreview:42:show"], ["storyPreview:42:hide"],
                    ["storySound:42:none"], ["storySound:42:custom(7)"],
                    ["storyMute:42:muted", "storyPreview:42:hide", "storySound:42:custom(9)"]
                ] : [
                    [], ["mute:42:0"], ["mute:42:2147483647"],
                    ["preview:42:show"], ["preview:42:hide"],
                    ["sound:42:none"], ["sound:42:custom(7)"],
                    ["mute:42:2147483647", "preview:42:hide", "sound:42:custom(9)"]
                ]
                let expected = changes[index] + (index == 0 ? [] : ["exception:42"]) + ["close"]
                check("Done stories=\(stories) state=\(index)", done.recorder.values == expected)
                for key in [36, 76] {
                    for sending in [false, true] {
                        let keyboard = makeHarness(state, isStories: stories)
                        NSApp.currentEvent = Event(type: .keyDown, sending: sending, keyCode: key)
                        let result = keyboard.controller.returnKeyAction()
                        check("Return stories=\(stories) state=\(index) key=\(key) sending=\(sending)", result == .invoked && keyboard.recorder.values == done.recorder.values)
                    }
                }
                let cancelled = makeHarness(state, isStories: stories)
                cancelled.cancel()
                check("Cancel stories=\(stories) state=\(index)", cancelled.recorder.values == ["close"])
            }
        }
        let latest = makeHarness(.init(), isStories: false)
        latest.state.value = .init(mute: .alwaysOff, previews: false, sound: .custom(5))
        NSApp.currentEvent = Event(type: .keyDown, sending: false, keyCode: 36)
        _ = latest.controller.returnKeyAction()
        check("reads current state", latest.recorder.values == ["mute:42:2147483647", "preview:42:hide", "sound:42:custom(5)", "exception:42", "close"])
        NSApp.currentEvent = nil
        let direct = makeHarness(.init(mute: .alwaysOn), isStories: false)
        direct.modal.accept()
        check("Done independent of current event", direct.recorder.values == ["mute:42:0", "exception:42", "close"])
        let missingEvent = makeHarness(.init(mute: .alwaysOn), isStories: false)
        check("missing event forwards", missingEvent.controller.returnKeyAction() == .invokeNext && missingEvent.recorder.values.isEmpty)
        var released: Harness? = makeHarness(.init(), isStories: false)
        let retainedButton = released!.modal
        weak var weakController = released!.controller
        released = nil
        retainedButton.accept()
        check("button does not retain controller", weakController == nil)
    }
}

let suite = XCTestSuite(forTestCaseClass: RegressionTests.self)
suite.run()
let nativeRun = suite.testRun!
print("RESULT " + String(data: try! JSONSerialization.data(withJSONObject: [
    "test_cases": nativeRun.executionCount,
    "scenarios": assertions,
    "assertions": assertions,
    "failed_assertions": failures.count,
    "failures": failures,
    "xctest_failures": nativeRun.totalFailureCount
], options: [.sortedKeys]), encoding: .utf8)!)
exit(nativeRun.hasSucceeded && failures.isEmpty ? 0 : 1)
