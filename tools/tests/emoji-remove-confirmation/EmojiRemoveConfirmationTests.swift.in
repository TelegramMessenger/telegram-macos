import Foundation
import XCTest

internal struct Language {
    let strings: [String: String]
}
private var primary = Language(strings: [:])
private var secondary: Language? = nil
private let _englishFallbackBundle = Bundle(path: CommandLine.arguments[1])

__LOOKUP__

private func translate(key: String, _ args: [CVarArg]) -> String {
    precondition(args.isEmpty)
    return _LocalizedStringFor(key, primary: primary, secondary: secondary) ?? "UndefinedKey"
}
public final class L10n {
__PROPERTIES__
__TR_FUNCTION__
}

__STRINGS_FUNCTION__

private struct ItemCollectionId: Equatable { let id: Int64 }
private enum RemoveOption: Equatable { case delete, archive }
private enum ConfirmResult { case basic, thrid }
private struct Removal: Equatable {
    let id: ItemCollectionId
    let option: RemoveOption
}
private final class StartedOperation {
    private let complete: () -> Void
    init(_ complete: @escaping () -> Void) { self.complete = complete }
    func start() -> Bool { complete(); return true }
}
private final class Stickers {
    var removals: [Removal] = []
    var starts = 0
    func removeStickerPackInteractively(id: ItemCollectionId, option: RemoveOption) -> StartedOperation {
        removals.append(.init(id: id, option: option))
        return StartedOperation { self.starts += 1 }
    }
}
private final class Engine { let stickers = Stickers() }
private final class Context {
    let window = 1
    let engine = Engine()
}
private struct Confirmation {
    let window: Int
    let header: String
    let information: String?
    let ok: String
    let cancel: String
    let success: (ConfirmResult) -> Void
    let cancelHandler: () -> Void
}
private var confirmation: Confirmation? = nil
private let appName = "Telegram"
private func verifyAlert_button(for window: Int, header: String = appName, information: String?, ok: String = "OK", cancel: String = strings().alertCancel, successHandler: @escaping (ConfirmResult) -> Void, cancelHandler: @escaping () -> Void = {}) {
    confirmation = Confirmation(window: window, header: header, information: information, ok: ok, cancel: cancel, success: successHandler, cancelHandler: cancelHandler)
}
private let context = Context()
private let removePack: (ItemCollectionId) -> Void = __REMOVE_CLOSURE__
private func check(_ name: String, _ value: Bool) { record(name, value) }

private var assertions = 0
private var failures: [String] = []
private func record(_ name: String, _ value: Bool, file: StaticString = #filePath, line: UInt = #line) {
    assertions += 1
    if !value { failures.append(name) }
    XCTAssertTrue(value, name, file: file, line: line)
}

final class RegressionTests: XCTestCase {
    @objc func testRegressionScenarios() {
        check("English fallback bundle is readable", _englishFallbackBundle != nil)
        check("selected accessor falls back to bundled English", strings().__SELECTED_ACCESSOR__ == __SELECTED_TEXT__)
        primary = Language(strings: [__KEY__: "PRIMARY"])
        secondary = Language(strings: [__KEY__: "SECONDARY"])
        check("primary translation takes precedence", strings().__SELECTED_ACCESSOR__ == "PRIMARY")
        primary = Language(strings: [:])
        check("secondary translation is used", strings().__SELECTED_ACCESSOR__ == "SECONDARY")
        primary = Language(strings: [__KEY__: ""])
        check("empty primary translation is skipped", strings().__SELECTED_ACCESSOR__ == "SECONDARY")
        secondary = Language(strings: [__KEY__: ""])
        check("empty translations use English fallback", strings().__SELECTED_ACCESSOR__ == __SELECTED_TEXT__)
        primary = Language(strings: [:])
        secondary = nil
        let id = ItemCollectionId(id: 123)
        removePack(id)
        check("removal waits for confirmation", context.engine.stickers.removals.isEmpty && context.engine.stickers.starts == 0)
        check("window and default title preserved", confirmation?.window == context.window && confirmation?.header == "Telegram")
        check("Delete and Cancel labels preserved", confirmation?.ok == "Delete" && confirmation?.cancel == "Cancel")
        check("emoji-specific confirmation replaces archive promise", confirmation?.information == __EXPECTED_TEXT__)
        confirmation?.cancelHandler()
        check("cancel does not remove the pack", context.engine.stickers.removals.isEmpty && context.engine.stickers.starts == 0)
        confirmation?.success(.thrid)
        check("third result does not remove the pack", context.engine.stickers.removals.isEmpty && context.engine.stickers.starts == 0)
        confirmation?.success(.basic)
        check("confirmed removal keeps .delete and the selected ID", context.engine.stickers.removals == [.init(id: id, option: .delete)] && context.engine.stickers.starts == 1)
        check("ordinary sticker archive wording unchanged", strings().installedStickersRemoveDescription == __ARCHIVE_TEXT__)
    }
}

let suite = XCTestSuite(forTestCaseClass: RegressionTests.self)
suite.run()
let nativeRun = suite.testRun!
print("RESULT " + String(data: try! JSONSerialization.data(withJSONObject: [
    "test_cases": nativeRun.executionCount,
    "scenarios": assertions,
    "assertions": assertions,
    "failed_assertions": failures.count,
    "failures": failures,
    "xctest_failures": nativeRun.totalFailureCount
], options: [.sortedKeys]), encoding: .utf8)!)
exit(nativeRun.hasSucceeded && failures.isEmpty ? 0 : 1)
