import Foundation

struct NewPollState {
    var limitDuration: Bool
    var deadlineTimeout: Int32?
    var deadlineDate: Date?
    var hideResults: Bool

    func copy(limitDuration: Bool) -> NewPollState {
        var result = self
        result.limitDuration = limitDuration
        return result
    }

__LIMIT_METHOD__

    func outgoing() -> (timeout: Int32?, date: Int32?, hidden: Bool) {
__TIMEOUT__
        return (computedDeadlineTimeout, __DEADLINE__, __HIDDEN__)
    }
}

var checks = 0
var failures = 0
func check(_ value: @autoclosure () -> Bool, _ label: String) {
    checks += 1
    if !value() {
        failures += 1
        print("FAIL: \(label)")
    }
}

let future = Date(timeIntervalSinceNow: 3600)
let past = Date(timeIntervalSinceNow: -30)
let settings: [(String, Int32?, Date?)] = [
    ("fresh", nil, nil),
    ("preset", 86400, nil),
    ("custom", nil, future),
    ("expired custom", nil, past),
    ("retained custom and preset", 86400, future)
]
for (name, timeout, date) in settings {
    for hidden in [false, true] {
        let draft = NewPollState(limitDuration: false, deadlineTimeout: timeout, deadlineDate: date, hideResults: hidden)
        let disabled = draft.outgoing()
        check(disabled.timeout == nil, "\(name) OFF no timeout, hidden=\(hidden)")
        check(disabled.date == nil, "\(name) OFF no absolute date, hidden=\(hidden)")
        check(!disabled.hidden, "\(name) OFF no hidden duration child, hidden=\(hidden)")

        let enabledDraft = draft.withUpdatedLimitDuration(true)
        let enabled = enabledDraft.outgoing()
        check(enabled.date == date.map { Int32($0.timeIntervalSince1970) }, "\(name) ON restores custom date")
        check(enabled.hidden == hidden, "\(name) ON restores hide choice")
        if let date {
            if date > Date() {
                check(enabled.timeout != nil && (3590...3600).contains(enabled.timeout!), "\(name) ON custom relative duration")
            } else {
                check(enabled.timeout == nil, "\(name) expired date keeps existing timeout behavior")
            }
        } else {
            check(enabled.timeout == timeout, "\(name) ON keeps preset timeout")
        }

        let disabledAgain = enabledDraft.withUpdatedLimitDuration(false)
        let outgoingAgain = disabledAgain.outgoing()
        check(outgoingAgain.timeout == nil && outgoingAgain.date == nil && !outgoingAgain.hidden, "\(name) ON to OFF suppresses effective settings")
        check(disabledAgain.deadlineTimeout == timeout && disabledAgain.deadlineDate == date && disabledAgain.hideResults == hidden, "\(name) OFF retains form choices")
    }
}
print("\(checks) checks, \(failures) failures")
exit(failures == 0 ? 0 : 1)
