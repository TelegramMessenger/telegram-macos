final class ForwardMessagesObject {
    let context: any AccountContextProtocol
    let messages: [Message]
    let album: Bool
    let getMessages: (([MessageId], Bool) -> Signal<[Message], NoError>)?
    var messageIds: [MessageId] { messages.map { $0.id } }
    var scheduleDate: Date? = nil
    var withoutSound = false
    var threadIds: [PeerId: Int64] = [:]
    init(_ context: any AccountContextProtocol, messages: [Message], album: Bool = false, getMessages: (([MessageId], Bool) -> Signal<[Message], NoError>)? = nil) {
        self.context = context
        self.messages = messages
        self.album = album
        self.getMessages = getMessages
    }
    func attributes(_ peerId: PeerId, sendPaidMessageStars: StarsAmount?) -> [MessageAttribute] { [] }
    func run(to peerIds: [PeerId], threadId: Int64? = nil, comment: ChatTextInputState? = nil, observedResult: @escaping (ForwardMessagesResult) -> Void) -> Signal<Never, String> {
        performForward(to: peerIds, threadId: threadId, comment: comment, sendPaidMessageStars: [:], observedResult: observedResult)
    }

    __PERFORM_FORWARD__
}

final class SavedForwardOptionsTests: XCTestCase {
    var context: Context!
    let other = PeerId(2)
    let third = PeerId(3)
    var saved: Message { Message(id: MessageId(peerId: context.peerId, id: 11)) }
    var external: Message { Message(id: MessageId(peerId: other, id: 21)) }
    var comment: ChatTextInputState { ChatTextInputState(inputText: "keep this comment #tag") }

    override func setUp() {
        ConfirmationProbe.reset()
        context = Context()
        for id in [context.peerId, other, third] { context.account.postbox.peers[id] = Peer(id: id) }
        for message in [saved, external] { context.account.postbox.messages[message.id] = message }
    }

    @discardableResult
    func install(_ location: ChatLocation, mode: ChatMode = .history, ready: Signal<Bool, NoError> = .single(true)) -> ChatInterfaceController {
        let controller = ChatInterfaceController(location, readySignal: ready)
        controller.chatInteraction.mode = mode
        context.bindings.navigation.controller = controller
        context.bindings.navigation.stack = [controller]
        return controller
    }

    func forward(_ messages: [Message], to peer: PeerId? = nil, thread: Int64? = nil, comment: ChatTextInputState? = nil, album: Bool = false, loader: (([MessageId], Bool) -> Signal<[Message], NoError>)? = nil, expectedError: String? = nil) -> [ForwardMessagesResult] {
        let object = ForwardMessagesObject(context, messages: messages, album: album, getMessages: loader)
        let done = expectation(description: "forward terminal event")
        var results: [ForwardMessagesResult] = []
        var failure: String?
        let disposable = object.run(to: [peer ?? context.peerId], threadId: thread, comment: comment, observedResult: { results.append($0) }).start(error: {
            failure = $0
            done.fulfill()
        }, completed: { done.fulfill() })
        wait(for: [done], timeout: 2)
        disposable.dispose()
        XCTAssertEqual(failure, expectedError)
        return results
    }

    func assertResults(_ actual: [ForwardMessagesResult], _ expected: [ForwardMessagesResult], file: StaticString = #filePath, line: UInt = #line) {
        XCTAssertEqual(actual.map { String(describing: $0) }, expected.map { String(describing: $0) }, file: file, line: line)
    }

    func assertNoEnqueue(file: StaticString = #filePath, line: UInt = #line) {
        XCTAssertTrue(context.account.enqueueCalls.isEmpty, "Draft preparation must not enqueue", file: file, line: line)
        XCTAssertEqual(context.account.enqueueSubscriptions, 0, file: file, line: line)
    }

    func assertNoNavigation(file: StaticString = #filePath, line: UInt = #line) {
        XCTAssertTrue(context.recorder.factories.isEmpty, file: file, line: line)
        XCTAssertTrue(context.recorder.topics.isEmpty, file: file, line: line)
        XCTAssertTrue(context.bindings.navigation.pushed.isEmpty, file: file, line: line)
    }

    func action(_ ids: [MessageId], text: ChatTextInputState? = nil) -> ChatInitialAction {
        .forward(messageIds: ids, text: text, behavior: .automatic)
    }

    func assertDraft(_ controller: ChatInterfaceController, ids: [MessageId], text: ChatTextInputState, file: StaticString = #filePath, line: UInt = #line) {
        XCTAssertEqual(controller.chatInteraction.presentation.interfaceState.forwardMessageIds, ids, file: file, line: line)
        XCTAssertEqual(controller.chatInteraction.presentation.effectiveInput, text, file: file, line: line)
        XCTAssertFalse(controller.chatInteraction.presentation.hasSelection, file: file, line: line)
        assertNoEnqueue(file: file, line: line)
    }

    func testSavedToCurrentSavedPreparesDraftWithoutSending() {
        let current = install(.peer(context.peerId))
        current.chatInteraction.presentation.interfaceState.forwardMessageIds = [external.id]
        assertResults(forward([saved]), [.draftPrepared])
        assertDraft(current, ids: [saved.id], text: ChatTextInputState(inputText: ""))
        assertNoNavigation()
    }

    func testSavedToCurrentSavedKeepsNonemptyComment() {
        let current = install(.peer(context.peerId))
        current.chatInteraction.presentation.interfaceState.inputState = ChatTextInputState(inputText: "old draft")
        assertResults(forward([saved], comment: comment), [.draftPrepared])
        assertDraft(current, ids: [saved.id], text: comment)
        assertNoNavigation()
    }

    func testSavedToCurrentSavedPreservesExistingInputWithoutComment() {
        let current = install(.peer(context.peerId))
        current.chatInteraction.presentation.interfaceState.inputState = comment
        assertResults(forward([saved]), [.draftPrepared])
        assertDraft(current, ids: [saved.id], text: comment)
    }

    func testSavedToCurrentSavedPreservesExistingInputWithEmptyComment() {
        let current = install(.peer(context.peerId))
        current.chatInteraction.presentation.interfaceState.inputState = comment
        assertResults(forward([saved], comment: ChatTextInputState(inputText: "")), [.draftPrepared])
        assertDraft(current, ids: [saved.id], text: comment)
    }

    func assertSavedSpecialControllerOpensHistoryDraft(mode: ChatMode, editState: ChatEditState? = nil, recording: Bool = false, searchTag: Bool = false, suppliedComment: ChatTextInputState?, file: StaticString = #filePath, line: UInt = #line) throws {
        let previous = install(.peer(context.peerId), mode: mode)
        previous.chatInteraction.presentation.isRecording = recording
        previous.chatInteraction.presentation.hasSearchTag = searchTag
        previous.chatInteraction.presentation.interfaceState.inputState = ChatTextInputState(inputText: "existing normal draft")
        previous.chatInteraction.presentation.interfaceState.forwardMessageIds = [external.id]
        previous.chatInteraction.presentation.interfaceState.editState = editState
        let previousInterface = previous.chatInteraction.presentation.interfaceState
        let previousEffectiveInput = previous.chatInteraction.presentation.effectiveInput
        assertResults(forward([saved], comment: suppliedComment), [.destinationReady], file: file, line: line)
        XCTAssertEqual(previous.chatInteraction.presentation.interfaceState, previousInterface, file: file, line: line)
        XCTAssertEqual(previous.chatInteraction.presentation.effectiveInput, previousEffectiveInput, file: file, line: line)
        XCTAssertEqual(previous.chatInteraction.presentation.isRecording, recording, file: file, line: line)
        XCTAssertEqual(previous.chatInteraction.presentation.hasSearchTag, searchTag, file: file, line: line)
        XCTAssertFalse(previous.chatInteraction.presentation.hasSelection, file: file, line: line)
        assertNoEnqueue(file: file, line: line)
        let call = try XCTUnwrap(context.recorder.factories.first, file: file, line: line)
        XCTAssertEqual(context.recorder.factories.count, 1, file: file, line: line)
        XCTAssertEqual(call.location, .peer(context.peerId), file: file, line: line)
        XCTAssertEqual(call.initialAction, action([saved.id], text: suppliedComment), file: file, line: line)
        XCTAssertFalse(call.addition, file: file, line: line)
        let opened = try XCTUnwrap(context.bindings.navigation.pushed.first, file: file, line: line)
        XCTAssertFalse(opened === previous, file: file, line: line)
        XCTAssertEqual(opened.chatInteraction.mode, .history, file: file, line: line)
        XCTAssertNil(opened.chatInteraction.presentation.interfaceState.editState, file: file, line: line)
        XCTAssertEqual(opened.initialAction, call.initialAction, file: file, line: line)
        XCTAssertTrue(context.recorder.topics.isEmpty, file: file, line: line)
    }

    func testSavedFromPinnedSelfOpensNormalHistoryDraft() throws {
        try assertSavedSpecialControllerOpensHistoryDraft(mode: .pinned, suppliedComment: comment)
    }

    func testSavedFromScheduledSelfOpensNormalHistoryDraft() throws {
        try assertSavedSpecialControllerOpensHistoryDraft(mode: .scheduled, suppliedComment: comment)
    }

    func testSavedWhileEditingSelfPreservesEditWithoutUsingEditTextAsComment() throws {
        let edit = ChatEditState(messageId: saved.id, inputState: ChatTextInputState(inputText: "unsaved edit text"))
        try assertSavedSpecialControllerOpensHistoryDraft(mode: .history, editState: edit, suppliedComment: nil)
    }

    func testSavedWhileEditingSelfPreservesEditAndCarriesExplicitComment() throws {
        let edit = ChatEditState(messageId: saved.id, inputState: ChatTextInputState(inputText: "unsaved edit text"))
        try assertSavedSpecialControllerOpensHistoryDraft(mode: .history, editState: edit, suppliedComment: comment)
    }

    func assertRecordingBlocksSavedDraft(location: ChatLocation, thread: Int64? = nil, messages: [Message]? = nil, file: StaticString = #filePath, line: UInt = #line) {
        let current = install(location)
        let recording = RecordingState()
        current.chatInteraction.presentation.recordingState = recording
        current.chatInteraction.presentation.interfaceState.inputState = comment
        current.chatInteraction.presentation.interfaceState.forwardMessageIds = [external.id]
        let before = current.chatInteraction.presentation
        assertResults(forward(messages ?? [saved], thread: thread, comment: comment), [.restricted], file: file, line: line)
        XCTAssertEqual(current.chatInteraction.presentation, before, file: file, line: line)
        XCTAssertTrue(current.chatInteraction.presentation.recordingState === recording, file: file, line: line)
        XCTAssertFalse(recording.discarded, file: file, line: line)
        XCTAssertTrue(context.bindings.navigation.controller === current, file: file, line: line)
        XCTAssertEqual(context.bindings.navigation.stack.count, 1, file: file, line: line)
        XCTAssertEqual(ConfirmationProbe.count, 0, file: file, line: line)
        XCTAssertNil(ConfirmationProbe.accept, file: file, line: line)
        XCTAssertEqual(ConfirmationProbe.notices, ["Finish or discard the current recording before forwarding to Saved Messages."], file: file, line: line)
        assertNoEnqueue(file: file, line: line)
        assertNoNavigation(file: file, line: line)
    }

    func testSavedWhileRecordingSelfDoesNotNavigateOrAskToDiscard() {
        assertRecordingBlocksSavedDraft(location: .peer(context.peerId))
    }

    func testSavedWhileRecordingInOtherChatDoesNotNavigateOrAskToDiscard() {
        assertRecordingBlocksSavedDraft(location: .peer(other))
    }

    func testSavedThreadWhileRecordingDoesNotNavigateOrAskToDiscard() {
        assertRecordingBlocksSavedDraft(location: .peer(context.peerId), thread: 71)
    }

    func testMixedSavedSourcesWhileRecordingDoNotNavigateOrAskToDiscard() {
        assertRecordingBlocksSavedDraft(location: .peer(context.peerId), messages: [external, saved])
    }

    func testSavedForwardCanBeRetriedAfterRecordingFinishes() {
        let current = install(.peer(context.peerId))
        current.chatInteraction.presentation.isRecording = true
        assertResults(forward([saved]), [.restricted])
        current.chatInteraction.presentation.isRecording = false
        assertResults(forward([saved], comment: comment), [.draftPrepared])
        assertDraft(current, ids: [saved.id], text: comment)
        assertNoNavigation()
        XCTAssertEqual(ConfirmationProbe.count, 0)
    }

    func testExternalQuickSaveDoesNotInterruptRecording() {
        let current = install(.peer(context.peerId))
        let recording = RecordingState()
        current.chatInteraction.presentation.recordingState = recording
        assertResults(forward([external]), [.accepted])
        XCTAssertTrue(current.chatInteraction.presentation.recordingState === recording)
        XCTAssertFalse(recording.discarded)
        XCTAssertEqual(context.account.enqueueSubscriptions, 1)
        XCTAssertEqual(ConfirmationProbe.count, 0)
        XCTAssertTrue(ConfirmationProbe.notices.isEmpty)
        assertNoNavigation()
    }

    func testNavigationGateDeclineKeepsRecordingAndCurrentController() {
        let current = install(.peer(context.peerId))
        let recording = RecordingState()
        current.chatInteraction.presentation.recordingState = recording
        context.bindings.navigation.push(ChatInterfaceController(.peer(other)))
        XCTAssertEqual(ConfirmationProbe.count, 1)
        ConfirmationProbe.cancel?()
        XCTAssertTrue(context.bindings.navigation.controller === current)
        XCTAssertTrue(context.bindings.navigation.pushed.isEmpty)
        XCTAssertFalse(recording.discarded)
        XCTAssertTrue(current.chatInteraction.presentation.recordingState === recording)
    }

    func testNavigationGateConfirmDiscardsRecordingBeforePushing() {
        let current = install(.peer(context.peerId))
        let recording = RecordingState()
        current.chatInteraction.presentation.recordingState = recording
        let next = ChatInterfaceController(.peer(other))
        context.bindings.navigation.push(next)
        XCTAssertEqual(ConfirmationProbe.count, 1)
        XCTAssertTrue(context.bindings.navigation.pushed.isEmpty)
        ConfirmationProbe.accept?()
        XCTAssertTrue(context.bindings.navigation.controller === next)
        XCTAssertTrue(recording.discarded)
        XCTAssertNil(current.chatInteraction.presentation.recordingState)
    }

    func testSavedFromTagFilteredSelfOpensMainComposerWithoutReplacingFilter() throws {
