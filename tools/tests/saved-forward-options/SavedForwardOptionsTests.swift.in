    func testOnlyFirstCombinedEmissionPreparesDraft() {
        let current = install(.peer(context.peerId))
        let pipe = ValuePipe<[Message]>()
        let object = ForwardMessagesObject(context, messages: [saved], getMessages: { _, _ in pipe.signal() })
        let done = expectation(description: "first combined result completes")
        var results: [ForwardMessagesResult] = []
        let disposable = object.run(to: [context.peerId], observedResult: { results.append($0) }).start(error: { XCTFail($0) }, completed: { done.fulfill() })
        pipe.putNext([saved])
        wait(for: [done], timeout: 2)
        pipe.putNext([external])
        disposable.dispose()
        assertResults(results, [.draftPrepared])
        assertDraft(current, ids: [saved.id], text: ChatTextInputState(inputText: ""))
        XCTAssertEqual(current.chatInteraction.updates, 1)
    }

    func testSenderForwardOptionsReachEnqueueForEveryFlagCombination() throws {
        for (hideNames, hideCaptions) in [(false, false), (true, false), (false, true), (true, true)] {
            context.account.enqueueCalls.removeAll()
            let disposable = Sender.forwardMessages(messageIds: [saved.id], context: context, peerId: context.peerId, replyId: nil, threadId: 71, hideNames: hideNames, hideCaptions: hideCaptions).start()
            disposable.dispose()
            let call = try XCTUnwrap(context.account.enqueueCalls.first)
            XCTAssertEqual(call.peerId, context.peerId)
            guard case let .forward(source, thread, _, attributes, _) = try XCTUnwrap(call.messages.first) else { return XCTFail("Expected forward") }
            XCTAssertEqual(source, saved.id)
            XCTAssertEqual(thread, 71)
            let options = attributes.compactMap { $0 as? ForwardOptionsMessageAttribute }
            XCTAssertEqual(options, hideNames || hideCaptions ? [ForwardOptionsMessageAttribute(hideNames: hideNames || hideCaptions, hideCaptions: hideCaptions)] : [])
        }
    }

    func testSenderAlbumPreservesFlagsGroupingOrderAndOtherAttributes() throws {
        let ids = [MessageId(peerId: context.peerId, id: 13), saved.id, MessageId(peerId: context.peerId, id: 12)]
        let disposable = Sender.forwardMessages(messageIds: ids, context: context, peerId: other, replyId: nil, threadId: 71, hideNames: false, hideCaptions: true, silent: true, atDate: Date(timeIntervalSince1970: 2000), repeatPeriod: 60, sendAsPeerId: third, sendPaidMessageStars: StarsAmount(value: 5)).start()
        disposable.dispose()
        let call = try XCTUnwrap(context.account.enqueueCalls.first)
        XCTAssertEqual(call.peerId, other)
        var sources: [MessageId] = []
        for message in call.messages {
            guard case let .forward(source, thread, grouping, attributes, _) = message else { return XCTFail("Expected forward") }
            sources.append(source)
            XCTAssertEqual(thread, 71)
            XCTAssertEqual(grouping, .auto)
            XCTAssertEqual(attributes.compactMap { $0 as? ForwardOptionsMessageAttribute }, [ForwardOptionsMessageAttribute(hideNames: true, hideCaptions: true)])
            XCTAssertEqual(attributes.compactMap { $0 as? NotificationInfoMessageAttribute }.first?.flags, [.muted])
            XCTAssertEqual(attributes.compactMap { $0 as? OutgoingScheduleInfoMessageAttribute }.first?.scheduleTime, 2000)
            XCTAssertEqual(attributes.compactMap { $0 as? OutgoingScheduleInfoMessageAttribute }.first?.repeatPeriod, 60)
            XCTAssertEqual(attributes.compactMap { $0 as? SendAsMessageAttribute }.first?.peerId, third)
            XCTAssertEqual(attributes.compactMap { $0 as? PaidStarsMessageAttribute }.first?.stars, StarsAmount(value: 5))
        }
        XCTAssertEqual(sources, ids.sorted())
    }
}
