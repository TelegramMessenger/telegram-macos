    func assertMainSavedComposerOpened(text: ChatTextInputState?, file: StaticString = #filePath, line: UInt = #line) throws {
        assertNoEnqueue(file: file, line: line)
        XCTAssertTrue(context.recorder.topics.isEmpty, file: file, line: line)
        XCTAssertEqual(context.recorder.factories.count, 1, file: file, line: line)
        let call = try XCTUnwrap(context.recorder.factories.first, file: file, line: line)
        XCTAssertEqual(call.location, .peer(context.peerId), file: file, line: line)
        XCTAssertNil(call.location.threadId, file: file, line: line)
        XCTAssertEqual(call.initialAction, action([saved.id], text: text), file: file, line: line)
        let opened = try XCTUnwrap(context.bindings.navigation.pushed.first, file: file, line: line)
        XCTAssertEqual(opened.chatInteraction.chatLocation, .peer(context.peerId), file: file, line: line)
        XCTAssertEqual(opened.chatInteraction.mode, .history, file: file, line: line)
        XCTAssertNil(opened.chatInteraction.presentation.interfaceState.editState, file: file, line: line)
        XCTAssertEqual(opened.initialAction, call.initialAction, file: file, line: line)
    }

    func testSavedToCurrentSavedThreadOpensMainSavedComposer() throws {
        let previous = install(.thread(ChatReplyThreadMessage(peerId: context.peerId, threadId: 71)), mode: .savedThread)
        let previousInterface = previous.chatInteraction.presentation.interfaceState
        assertResults(forward([saved], thread: 71, comment: comment), [.destinationReady])
        try assertMainSavedComposerOpened(text: comment)
        XCTAssertEqual(previous.chatInteraction.presentation.interfaceState, previousInterface)
        XCTAssertFalse(context.bindings.navigation.pushed.first === previous)
    }

