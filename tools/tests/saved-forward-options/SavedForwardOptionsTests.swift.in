    func assertWaitsForReadiness(thread: Int64?, currentThread: Bool, file: StaticString = #filePath, line: UInt = #line) {
        let pipe = ValuePipe<Bool>()
        if currentThread {
            install(.thread(ChatReplyThreadMessage(peerId: context.peerId, threadId: thread!)), mode: .savedThread)
        } else {
            install(.peer(other))
        }
        context.recorder.newControllerReady = pipe.signal()
        let object = ForwardMessagesObject(context, messages: [saved])
        let done = expectation(description: "wait for true readiness")
        var results: [ForwardMessagesResult] = []
        var completed = false
        let disposable = object.run(to: [context.peerId], threadId: thread, observedResult: { results.append($0) }).start(error: { XCTFail($0, file: file, line: line) }, completed: { completed = true; done.fulfill() })
        XCTAssertTrue(results.isEmpty, file: file, line: line)
        XCTAssertFalse(completed, file: file, line: line)
        pipe.putNext(false)
        XCTAssertTrue(results.isEmpty, file: file, line: line)
        XCTAssertFalse(completed, file: file, line: line)
        pipe.putNext(true)
        wait(for: [done], timeout: 2)
        pipe.putNext(true)
        disposable.dispose()
        assertResults(results, [.destinationReady], file: file, line: line)
        assertNoEnqueue(file: file, line: line)
        XCTAssertEqual(context.recorder.factories.first?.location, .peer(context.peerId), file: file, line: line)
        XCTAssertEqual(context.bindings.navigation.pushed.first?.chatInteraction.mode, .history, file: file, line: line)
        XCTAssertTrue(context.recorder.topics.isEmpty, file: file, line: line)
    }

    func testRegularSavedDraftWaitsForControllerReadiness() { assertWaitsForReadiness(thread: nil, currentThread: false) }
    func testRequestedSavedThreadWaitsForMainComposerReadiness() { assertWaitsForReadiness(thread: 71, currentThread: false) }
    func testCurrentSavedThreadWaitsForMainComposerReadiness() { assertWaitsForReadiness(thread: 71, currentThread: true) }

    func testExternalToSavedStillSendsImmediately() throws {
        let current = install(.peer(context.peerId))
        assertResults(forward([external]), [.accepted])
        XCTAssertEqual(context.account.enqueueCalls.count, 1)
        XCTAssertEqual(context.account.enqueueSubscriptions, 1)
        let call = try XCTUnwrap(context.account.enqueueCalls.first)
        XCTAssertEqual(call.peerId, context.peerId)
        guard case let .forward(source, thread, grouping, attributes, _) = try XCTUnwrap(call.messages.first) else { return XCTFail("Expected forwarded message") }
        XCTAssertEqual(source, external.id)
        XCTAssertNil(thread)
        XCTAssertEqual(grouping, .none)
        XCTAssertFalse(attributes.contains { $0 is ForwardOptionsMessageAttribute })
        XCTAssertTrue(current.chatInteraction.presentation.interfaceState.forwardMessageIds.isEmpty)
        XCTAssertFalse(current.chatInteraction.presentation.hasSelection)
        assertNoNavigation()
    }

    func testExternalToSavedThreadStillSendsCommentAndMessageImmediately() throws {
        install(.peer(other))
        assertResults(forward([external], thread: 71, comment: comment), [.accepted])
        XCTAssertEqual(context.account.enqueueCalls.count, 2)
        XCTAssertEqual(context.account.enqueueSubscriptions, 2)
        let commentCall = try XCTUnwrap(context.account.enqueueCalls.first)
        guard case let .message(text, _, _, _, thread, _, _, _, _, _) = try XCTUnwrap(commentCall.messages.first) else { return XCTFail("Expected comment") }
        XCTAssertEqual(text, comment.inputText)
        XCTAssertEqual(thread, 71)
        let forwardCall = try XCTUnwrap(context.account.enqueueCalls.last)
        guard case let .forward(source, forwardedThread, _, _, _) = try XCTUnwrap(forwardCall.messages.first) else { return XCTFail("Expected forward") }
        XCTAssertEqual(source, external.id)
        XCTAssertEqual(forwardedThread, 71)
        XCTAssertTrue(context.account.enqueueCalls.allSatisfy { $0.peerId == context.peerId })
        assertNoNavigation()
    }

