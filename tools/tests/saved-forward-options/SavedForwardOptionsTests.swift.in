import Foundation
import XCTest
import SwiftSignalKit

struct PeerId: Hashable, Comparable {
    let value: Int64
    var namespace: Int32 = 0
    init(_ value: Int64) { self.value = value }
    static func < (lhs: Self, rhs: Self) -> Bool { lhs.value < rhs.value }
}

struct MessageId: Hashable, Comparable {
    let peerId: PeerId
    let id: Int32
    static func < (lhs: Self, rhs: Self) -> Bool {
        lhs.peerId == rhs.peerId ? lhs.id < rhs.id : lhs.peerId < rhs.peerId
    }
}

struct Message {
    let id: MessageId
    var isPublicPoll = false
}

struct Peer {
    let id: PeerId
    var isChannel = false
    var isCommunity = false
    var isMonoForum = false
    var canSend = true
    func canSendMessage() -> Bool { canSend }
}

struct StarsAmount: Equatable { let value: Int64 }
struct EngineMessageReplySubject {}

struct ParsingType: OptionSet {
    let rawValue: Int
    static let Hashtags = Self(rawValue: 1)
    static let Links = Self(rawValue: 2)
}

struct ChatTextInputState: Equatable {
    var inputText: String
    func messageTextEntities(_ parsingType: ParsingType) -> [String] { [inputText] }
}

protocol MessageAttribute {}
struct TextEntitiesMessageAttribute: MessageAttribute { let entities: [String] }
struct SendAsMessageAttribute: MessageAttribute { let peerId: PeerId }
struct ForwardOptionsMessageAttribute: MessageAttribute, Equatable {
    let hideNames: Bool
    let hideCaptions: Bool
}
struct NotificationInfoMessageAttribute: MessageAttribute {
    struct Flags: OptionSet {
        let rawValue: Int
        static let muted = Self(rawValue: 1)
    }
    let flags: Flags
}
struct PaidStarsMessageAttribute: MessageAttribute {
    let stars: StarsAmount
    let postponeSending: Bool
}
struct OutgoingScheduleInfoMessageAttribute: MessageAttribute {
    let scheduleTime: Int32
    let repeatPeriod: Int32?
}

enum EnqueueMessage {
    enum Grouping { case auto, none }
    case forward(source: MessageId, threadId: Int64?, grouping: Grouping, attributes: [MessageAttribute], correlationId: Int64?)
    case message(text: String, attributes: [MessageAttribute], inlineStickers: [Int: Int], mediaReference: Int?, threadId: Int64?, replyToMessageId: Int?, replyToStoryId: Int?, localGroupingKey: Int64?, correlationId: Int64?, bubbleUpEmojiOrStickersets: [Int])
}

enum Namespaces {
    enum Peer { static let SecretChat: Int32 = 1 }
}
enum FastSettings {
    static func isChannelMessagesMuted(_ peerId: PeerId) -> Bool { false }
}

final class Postbox {
    var peers: [PeerId: Peer] = [:]
    var messages: [MessageId: Message] = [:]
    var groups: [MessageId: [Message]] = [:]
    var requestedMessages: [MessageId] = []
    var requestedGroups: [MessageId] = []
    func transaction<T>(_ body: @escaping (Postbox) -> T) -> Signal<T, NoError> {
        Signal { subscriber in
            subscriber.putNext(body(self))
            subscriber.putCompletion()
            return EmptyDisposable
        }
    }
    func getPeer(_ id: PeerId) -> Peer? { peers[id] }
    func getMessage(_ id: MessageId) -> Message? {
        requestedMessages.append(id)
        return messages[id]
    }
    func getMessageGroup(_ id: MessageId) -> [Message]? {
        requestedGroups.append(id)
        return groups[id]
    }
    func loadedPeerWithId(_ id: PeerId) -> Signal<Peer, NoError> {
        peers[id].map(Signal.single) ?? .complete()
    }
}

final class CachedChannelData { var sendAsPeerId: PeerId? }
func getCachedDataView(peerId: PeerId, postbox: Postbox) -> Signal<Any?, NoError> { .single(nil) }

struct EnqueueCall {
    let peerId: PeerId
    let messages: [EnqueueMessage]
}

final class Account {
    let peerId: PeerId
    let postbox = Postbox()
    var enqueueCalls: [EnqueueCall] = []
    var enqueueSubscriptions = 0
    var enqueueResult: Signal<[MessageId?], NoError>?
    init(peerId: PeerId) { self.peerId = peerId }
}

func enqueueMessages(account: Account, peerId: PeerId, messages: [EnqueueMessage]) -> Signal<[MessageId?], NoError> {
    account.enqueueCalls.append(EnqueueCall(peerId: peerId, messages: messages))
    return Signal { subscriber in
        account.enqueueSubscriptions += 1
        let result: Signal<[MessageId?], NoError> = account.enqueueResult ?? Signal.single(messages.enumerated().map { Optional(MessageId(peerId: peerId, id: Int32(1000 + $0.offset))) })
        return result.start(next: subscriber.putNext, completed: subscriber.putCompletion)
    }
}

enum Sender {
    __SENDER_FORWARD__

    static func enqueue(message: EnqueueMessage, context: any AccountContextProtocol, peerId: PeerId) -> Signal<[MessageId?], NoError> {
        enqueueMessages(account: context.account, peerId: peerId, messages: [message])
    }
}

enum ChatInitialAction: Equatable {
    enum Behavior { case automatic }
    case forward(messageIds: [MessageId], text: ChatTextInputState?, behavior: Behavior)
}

struct ChatReplyThreadMessage: Equatable {
    let peerId: PeerId
    let threadId: Int64
}

enum ChatLocation: Equatable {
    case peer(PeerId)
    case thread(ChatReplyThreadMessage)
    var peerId: PeerId {
        switch self {
        case let .peer(id): return id
        case let .thread(value): return value.peerId
        }
    }
    var threadId: Int64? {
        switch self {
        case .peer: return nil
        case let .thread(value): return value.threadId
        }
    }
}

struct ChatEditState: Equatable {
    let messageId: MessageId
    let inputState: ChatTextInputState
}

struct InterfaceState: Equatable {
    var forwardMessageIds: [MessageId] = []
    var inputState = ChatTextInputState(inputText: "")
    var editState: ChatEditState?
    func withUpdatedForwardMessageIds(_ ids: [MessageId]) -> Self {
        var copy = self
        copy.forwardMessageIds = ids
        return copy
    }
    func withUpdatedInputState(_ state: ChatTextInputState) -> Self {
        var copy = self
        copy.inputState = state
        return copy
    }
}

enum ChatState {
    case normal
    case editing
    case recording
    case action
    case selecting
}

struct PresentationState: Equatable {
    var hasSelection = true
    var recordingState: RecordingState?
    var isRecording: Bool {
        get { recordingState != nil }
        set { recordingState = newValue ? RecordingState() : nil }
    }
    var hasSearchTag = false
    var interfaceState = InterfaceState()
    var state: ChatState {
        if hasSelection { return .selecting }
        if isRecording { return .recording }
        if interfaceState.editState != nil { return .editing }
        if hasSearchTag { return .action }
        return .normal
    }
    var effectiveInput: ChatTextInputState { interfaceState.editState?.inputState ?? interfaceState.inputState }
    func withoutSelectionState() -> Self {
        var copy = self
        copy.hasSelection = false
        return copy
    }
    func updatedInterfaceState(_ update: (InterfaceState) -> InterfaceState) -> Self {
        var copy = self
        copy.interfaceState = update(interfaceState)
        return copy
    }
}

final class ChatInteraction {
    let chatLocation: ChatLocation
    var mode: ChatMode = .history
    var peerId: PeerId { chatLocation.peerId }
    var presentation = PresentationState()
    var updates = 0
    init(_ location: ChatLocation) { chatLocation = location }
    func update(_ transform: (PresentationState) -> PresentationState) {
        presentation = transform(presentation)
        updates += 1
    }
}

final class RecordingState: Equatable {
    var discarded = false
    static func == (lhs: RecordingState, rhs: RecordingState) -> Bool { lhs === rhs }
    func discard(from interaction: ChatInteraction, closingOtherModals: Bool) {
        discarded = true
        interaction.presentation.recordingState = nil
    }
}

class Controller {
    var ableToNextController: (Controller, @escaping (Controller, Bool) -> Void) -> Void = { controller, completed in completed(controller, true) }
}
class ChatInterfaceController: Controller {
    let context = Context()
    private var isConfirmingDiscardRecording = false
    __RECORDING_CONFIRM__
    let chatInteraction: ChatInteraction
    let ready = Promise<Bool>()
    let initialAction: ChatInitialAction?
    init(_ location: ChatLocation, initialAction: ChatInitialAction? = nil, readySignal: Signal<Bool, NoError> = .single(true)) {
        chatInteraction = ChatInteraction(location)
        self.initialAction = initialAction
        ready.set(readySignal)
        super.init()
        __NAVIGATION_GATE__
    }
}

final class Navigation {
    var controller: Controller = Controller()
    var stack: [Controller] = []
    var pushed: [ChatInterfaceController] = []
    func enumerateControllers(_ body: (Controller, Int) -> Bool) {
        for (index, controller) in stack.enumerated() {
            if body(controller, index) { break }
        }
    }
    func push(_ controller: ChatInterfaceController) {
        self.controller.ableToNextController(controller, { [weak self] controller, accepted in
            guard accepted, let self, let controller = controller as? ChatInterfaceController else { return }
            self.stack.append(controller)
            self.pushed.append(controller)
            self.controller = controller
        })
    }
}

final class Bindings {
    let navigation = Navigation()
    func rootNavigation() -> Navigation { navigation }
}

enum ChatMode: Equatable {
    case history
    case pinned
    case scheduled
    case savedThread
}
struct FactoryCall {
    let location: ChatLocation
    let initialAction: ChatInitialAction
    let addition: Bool
}
struct TopicCall {
    let threadId: Int64
    let peerId: PeerId
    let initialAction: ChatInitialAction?
    let isMonoforum: Bool
}
final class Recorder {
    var factories: [FactoryCall] = []
    var topics: [TopicCall] = []
    var newControllerReady: Signal<Bool, NoError> = .single(true)
}

protocol AccountContextProtocol {
    var peerId: PeerId { get }
    var account: Account { get }
    var bindings: Bindings { get }
    var recorder: Recorder { get }
    var window: Int { get }
}
final class Context: AccountContextProtocol {
    let peerId = PeerId(1)
    let account = Account(peerId: PeerId(1))
    let bindings = Bindings()
    let recorder = Recorder()
    let window = 0
}

struct ShareUIHooks {
    static let shared = ShareUIHooks()
    func makeChatController(_ context: any AccountContextProtocol, _ location: ChatLocation, _ action: ChatInitialAction) -> ChatInterfaceController {
        make(context, location, action, addition: false)
    }
    func makeChatAdditionController(_ context: any AccountContextProtocol, _ location: ChatLocation, _ action: ChatInitialAction) -> ChatInterfaceController {
        make(context, location, action, addition: true)
    }
    private func make(_ context: any AccountContextProtocol, _ location: ChatLocation, _ action: ChatInitialAction, addition: Bool) -> ChatInterfaceController {
        context.recorder.factories.append(FactoryCall(location: location, initialAction: action, addition: addition))
        return ChatInterfaceController(location, initialAction: action, readySignal: context.recorder.newControllerReady)
    }
}

enum ForumUI {
    static func openTopic(_ threadId: Int64, peerId: PeerId, context: any AccountContextProtocol, messageId: MessageId? = nil, animated: Bool = false, addition: Bool = false, initialAction: ChatInitialAction? = nil, isMonoforum: Bool = false) -> Signal<Bool, NoError> {
        context.recorder.topics.append(TopicCall(threadId: threadId, peerId: peerId, initialAction: initialAction, isMonoforum: isMonoforum))
        return context.recorder.newControllerReady
    }
}

final class ConfirmationProbe {
    static var count = 0
    static var accept: (() -> Void)?
    static var cancel: (() -> Void)?
    static var notices: [String] = []
    static func reset() { count = 0; accept = nil; cancel = nil; notices = [] }
}
func verifyAlert_button(for window: Int, information: String, ok: String, cancel: String, successHandler: @escaping (Bool) -> Void, cancelHandler: @escaping () -> Void, onDeinit: @escaping () -> Void) {
    ConfirmationProbe.count += 1
    ConfirmationProbe.accept = { successHandler(true); onDeinit() }
    ConfirmationProbe.cancel = { cancelHandler(); onDeinit() }
}
func showModalText(for window: Int, text: String) { ConfirmationProbe.notices.append(text) }
struct Strings {
    let pollForwardError = "poll-forward-error"
    let chatRecordingCancel = "discard recording?"
    let alertDiscard = "Discard"
    let alertNO = "No"
}
func strings() -> Strings { Strings() }
struct Theme {
    struct Icons { let successModalProgress = 0 }
    let icons = Icons()
}
let theme = Theme()
func delay(_ interval: Double, closure: @escaping () -> Void) {}
func showModalSuccess(for window: Int, icon: Int, delay: Double) -> Signal<Never, NoError> { .complete() }

