struct MediaId: Equatable {
    let namespace: Int32
    let id: Int64
}

struct TelegramMediaImageFlags: OptionSet {
    let rawValue: Int32
}

final class TelegramMediaImage: Equatable {
    init(imageId: MediaId, representations: [Int], immediateThumbnailData: Data?, reference: Int?, partialReference: Int?, flags: TelegramMediaImageFlags) {
    }

    static func ==(lhs: TelegramMediaImage, rhs: TelegramMediaImage) -> Bool {
        return true
    }
}

final class TelegramMediaFile: Equatable {
    let number: Int
    let previewRepresentations: [Int] = []

    init(_ number: Int) {
        self.number = number
    }

    static func ==(lhs: TelegramMediaFile, rhs: TelegramMediaFile) -> Bool {
        return lhs.number == rhs.number
    }
}

struct FoundStickerItem: Equatable {
    let file: TelegramMediaFile
}

enum InputMediaContextEntry: Equatable {
    case sticker(thumb: TelegramMediaImage, file: TelegramMediaFile)
}

