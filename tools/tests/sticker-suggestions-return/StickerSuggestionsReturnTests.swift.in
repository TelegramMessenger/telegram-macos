import CoreGraphics
import Foundation

final class NSEvent {
    struct ModifierFlags: OptionSet {
        let rawValue: UInt
        static let command = ModifierFlags(rawValue: 1 << 20)
    }
}

enum KeyboardKey: String {
    case Return
    case Tab
    case Escape
    case LeftArrow
    case RightArrow
    case DownArrow
    case UpArrow
}

enum HandlerPriority: Int {
    case low = 0
    case medium = 1
    case high = 2
    case modal = 3
    case supreme = 4
}

enum KeyHandlerResult {
    case invoked
    case rejected
    case invokeNext
}

final class Window {
    var handlers: [String: (NSEvent) -> KeyHandlerResult] = [:]

    func set(handler: @escaping (NSEvent) -> KeyHandlerResult, with object: NSObject, for key: KeyboardKey, priority: HandlerPriority = .low, modifierFlags: NSEvent.ModifierFlags? = nil) {
        self.handlers["\(key.rawValue)/\(priority.rawValue)/\(modifierFlags?.rawValue ?? 0)"] = handler
    }

    func removeAllHandlers(for object: NSObject) {
        self.handlers = [:]
    }

    func press(_ key: KeyboardKey) -> KeyHandlerResult? {
        return self.handlers["\(key.rawValue)/\(HandlerPriority.modal.rawValue)/0"]?(NSEvent())
    }
}

protocol AccountContextProtocol: AnyObject {
    var window: Window { get }
    var isInGlobalSearch: Bool { get }
}

final class AccountContext: AccountContextProtocol {
    let window = Window()
    var isInGlobalSearch = false
}

