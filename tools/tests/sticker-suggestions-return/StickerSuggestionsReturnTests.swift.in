final class TableView {
    var list: [TableRowItem] = []
    weak var delegate: TableViewDelegate?
    var selectedhash: AnyHashable? = nil
    var highlitedHash: AnyHashable? = nil

    var count: Int {
        return self.list.count
    }

    func item(at index: Int) -> TableRowItem {
        return self.list[index]
    }

    func item(stableId: AnyHashable) -> TableRowItem? {
        return self.list.first(where: { $0.stableId == stableId })
    }

    func index(of item: TableRowItem) -> Int? {
        return self.list.firstIndex(where: { $0 === item })
    }

    func reloadData(row: Int, animated: Bool) {
    }

    func cancelHighlight() {
        self.highlitedHash = nil
    }

    func scroll(to state: TableScrollState, inset: NSEdgeInsets, toVisible: Bool) {
    }

    func highlightNext(_ scroll: Bool = true, _ animated: Bool = false, turnDirection: Bool = true) {
    }

    func highlightPrev(_ scroll: Bool = true, _ animated: Bool = false, turnDirection: Bool = true) {
    }

__TABLE__
}

