enum ChatPresentationInputQuery {
    case none
    case emoji(String, firstWord: Bool)
    case stickers(String)
}

struct ChatTextInputState {
    let inputText: String
}

struct ChatPresentationInterfaceState {
    var effectiveInputContext: ChatPresentationInputQuery
    var effectiveInput: ChatTextInputState
}

final class ChatInteraction {
    var presentation = ChatPresentationInterfaceState(effectiveInputContext: .stickers("🙂"), effectiveInput: ChatTextInputState(inputText: "🙂"))
    var sent: [Int] = []
    var cleared = 0

    func sendAppFile(_ file: TelegramMediaFile, _ silent: Bool, _ query: String?, _ schedule: Bool, _ collectionId: Int?, _ customAction: Int?, _ messageEffect: Int?) {
        self.sent.append(file.number)
    }

    func clearInput() {
        self.cleared += 1
    }
}

enum TableScrollFocus {
    case focus(Bool)

    init(focus: Bool) {
        self = .focus(focus)
    }
}

enum TableScrollState {
    case top(id: AnyHashable, innerId: AnyHashable?, animated: Bool, focus: TableScrollFocus, inset: CGFloat)
    case bottom(id: AnyHashable, innerId: AnyHashable?, animated: Bool, focus: TableScrollFocus, inset: CGFloat)
}

protocol TableViewDelegate: AnyObject {
    func selectionDidChange(row: Int, item: TableRowItem, byClick: Bool, isNew: Bool) -> Void
    func selectionWillChange(row: Int, item: TableRowItem, byClick: Bool) -> Bool
    func isSelectable(row: Int, item: TableRowItem) -> Bool
}

class TableRowItem {
    weak var table: TableView?
    let initialSize: NSSize
    var redraws = 0

    init(_ initialSize: NSSize) {
        self.initialSize = initialSize
    }

    var stableId: AnyHashable {
        return 0
    }

    var index: Int {
        return self.table?.index(of: self) ?? -1
    }

    var height: CGFloat {
        return 60
    }

    var accessibilityLabel: String? {
        return nil
    }

    func viewClass() -> AnyClass {
        return TableRowItem.self
    }

    func prepare(_ selected: Bool) {
    }

    func redraw(animated: Bool = false) {
        self.redraws += 1
    }
}

