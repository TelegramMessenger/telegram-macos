staleRows.genericView.tableView.items = []
verifyAccepted(staleRows, sizes: [2], caption: "caption", grouped: true, label: "prepared grouping does not depend on table rows")
private let ungroupedRows = Controller(state(2, grouped: false), text: "comment")
ungroupedRows.genericView.tableView.items = [MediaGroupPreviewRowItem()]
verifyBlocked(ungroupedRows, label: "table group row cannot bypass prepared ungrouped state")

private let forwarding = Controller(state(2, mode: .media, spoiler: true, sort: .up), text: "caption")
forwarding.contextChatInteraction.presentation.messageEffect = 7
forwarding.send(silent: true, schedule: .init(date: Date(timeIntervalSince1970: 100)), spoiler: false)
expect(forwarding.chatInteraction.batches.map { $0.spoiler }, [false], "explicit spoiler override preserved")
expect(forwarding.chatInteraction.batches.map { $0.leading }, [true], "media caption position preserved")
expect(forwarding.chatInteraction.batches.map { $0.silent }, [true], "silent forwarding preserved")
expect(forwarding.chatInteraction.batches.map { $0.scheduled }, [true], "schedule forwarding preserved")
expect(forwarding.chatInteraction.batches.map { $0.effect }, [7], "effect forwarding preserved")
private let fileSort = Controller(state(2, sort: .up), text: "caption")
fileSort.send()
expect(fileSort.chatInteraction.batches.map { $0.leading }, [false], "file caption position remains below files")
private let paid = Controller(state(2, mode: .media, payAmount: 5), text: "caption")
verifyAccepted(paid, sizes: [1], caption: "caption", grouped: false, label: "paid media wrapper")
expect((paid.chatInteraction.batches.first?.medias.first as? TelegramMediaPaidContent)?.extendedMedia.count, 2, "paid media contents preserved")

print("SUMMARY: \(checks) checks, \(failures) failures")
exit(failures == 0 ? 0 : 1)
