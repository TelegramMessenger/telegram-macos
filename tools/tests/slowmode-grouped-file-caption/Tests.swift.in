enum TelegramMediaFileAttribute {
    case Animated
    case Audio(isVoice: Bool, duration: Int32, title: String?, performer: String?, waveform: Data?)
}
struct CollageHooks {
    static let shared = CollageHooks()
    let fileAttributes: (String, String, Bool, Bool) -> [TelegramMediaFileAttribute] = { _, path, _, _ in
        switch (path as NSString).pathExtension {
        case "mp3": return [.Audio(isVoice: false, duration: 1, title: nil, performer: nil, waveform: nil)]
        case "ogg": return [.Audio(isVoice: true, duration: 1, title: nil, performer: nil, waveform: nil)]
        case "gifv": return [.Animated]
        default: return []
        }
    }
}
func MIMEType(_ path: String, isExt: Bool = false) -> String {
    let ext = isExt ? path : (path as NSString).pathExtension
    switch ext {
    case "mp3": return "audio/mpeg"
    case "ogg": return "audio/ogg"
    case "gifv": return "video/mp4"
    case "mp4": return "video/mp4"
    case "webp": return "image/webp"
    case "jpg": return "image/jpeg"
    default: return "application/pdf"
    }
}
