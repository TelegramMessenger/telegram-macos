    controller.archiveStatuses[.resource(archiveMedia.resource as! LocalFileArchiveMediaResource)] = status
    controller.send()
    expect(controller.chatInteraction.batches.count, 0, "archive not ready \(status)")
    expect(controller.analyticsMediaJourney?.blocks, [.preparation], "archive preparation analytics \(status)")
}
