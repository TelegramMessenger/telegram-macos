}

private final class Controller {
    let genericView = PreviewSenderView()
    let chatInteraction = ChatInteraction()
    let contextChatInteraction = ChatInteraction()
    let context = Context()
    let pendingActions = PreviewSenderPendingActions()
    let stateValue: Atomic<PreviewState>
    var analyticsMediaJourney: AnalyticsMediaJourney? = AnalyticsMediaJourney()
    var analyticsContext: Int? = nil
    var archiveStatuses: [ArchiveSource: ArchiveStatus] = [:]
    var sent = false
    var sourceIsCurrent = true
    var closed = false
    var sendCurrentMedia: ((Bool, ChatInteraction.Schedule?, Bool?, AnalyticsMediaJourney.Spec.SubmitVia) -> Void)?
    init(_ state: PreviewState, text: String, slowMode: SlowMode? = SlowMode()) {
        self.stateValue = Atomic(value: state)
        self.chatInteraction.presentation.slowMode = slowMode
        self.genericView.textView.interactions.presentation = Updated_ChatTextInputState(inputText: NSAttributedString(string: text))
        self.genericView.tableView.items = previewMediaEntries(state).map { entry in
            switch entry {
            case let .media(_, _, _, media, _, _, _), let .archive(_, _, _, media):
                return MediaPreviewRowItem(media)
            case .mediaGroup:
                return MediaGroupPreviewRowItem()
            case .section:
                return TableRowItem()
            }
        }
        for case let media as TelegramMediaFile in state.medias {
            if let archive = media.resource as? LocalFileArchiveMediaResource {
                self.archiveStatuses[.resource(archive)] = .done(URL(fileURLWithPath: "/fixtures/archive.zip"))
            }
        }
        installSend()
    }
    func validateSendSource() -> Bool { sourceIsCurrent }
    func capturePendingAction() -> () -> Bool { pendingActions.capture() }
    func closeModal() { closed = true }
__INPUT_PLACEHOLDER__
    var displayedPlaceholder: String { inputPlaceholder }
    func installSend() {
        let stateValue = self.stateValue
        let chatInteraction = self.chatInteraction
        let context = self.context
__SEND_PREFIX__
__MAKE_MEDIA__
                let submission: Submission? = nil
__DISPATCH__
            }
        }
    }
    func send(silent: Bool = false, schedule: ChatInteraction.Schedule? = nil, spoiler: Bool? = nil) {
        sendCurrentMedia?(silent, schedule, spoiler, .unknown)
    }
}

private var checks = 0
private var failures = 0
private func expect<T: Equatable>(_ actual: T, _ expected: T, _ label: String) {
    checks += 1
    if actual != expected {
        failures += 1
        print("FAIL \(label): \(actual) != \(expected)")
    }
}
private func state(_ count: Int, mode: PreviewSendingState.State = .file, grouped: Bool = true, media: (() -> Media)? = nil, spoiler: Bool = false, sort: PreviewSendingState.Sort = .down, payAmount: Int64? = nil) -> PreviewState {
    let medias: [Media] = (0..<count).map { _ -> Media in
        if let media { return media() }
        if mode == .media { return TelegramMediaImage() }
        return TelegramMediaFile()
    }
    return PreviewState(urls: (0..<count).map { URL(fileURLWithPath: "/fixtures/\($0).pdf") }, medias: medias, currentState: PreviewSendingState(state: mode, isCollage: grouped, isSpoiler: spoiler, sort: sort, payAmount: payAmount))
}
private func verifyAccepted(_ controller: Controller, sizes: [Int], caption: String, grouped: Bool, additional: String? = nil, label: String) {
    controller.send()
    let batches = controller.chatInteraction.batches
    expect(batches.map { $0.medias.count }, sizes, label + " batch sizes")
    expect(batches.map { $0.caption.inputText }, sizes.map { _ in caption }, label + " caption")
    expect(batches.map { $0.grouped }, sizes.map { _ in grouped }, label + " grouping")
    expect(batches.map { $0.additional?.inputText }, sizes.indices.map { $0 == 0 ? additional : nil }, label + " separate text")
    expect(controller.genericView.sendButton.tooltips, [], label + " no slow-mode tooltip")
    expect(controller.genericView.textView.shakes, 0, label + " no shake")
}
private func verifyBlocked(_ controller: Controller, label: String, cooldown: Bool = false) {
    controller.send()
    expect(controller.chatInteraction.batches.count, 0, label + " no send")
    expect(controller.genericView.sendButton.tooltips, cooldown ? [] : [strings().slowModeMultipleError], label + " tooltip")
    expect(controller.genericView.textView.selections, cooldown ? 0 : 1, label + " selection")
    expect(controller.genericView.textView.shakes, 1, label + " shake")
    expect(controller.analyticsMediaJourney?.blocks, [.slowMode], label + " analytics")
}

for (paths, expected) in [
    (["a.pdf", "b.pdf"], true),
    (["a.jpg", "b.jpg"], true),
    (["a.mp3", "b.mp3"], true),
    (["a.mp3", "b.pdf"], false),
    (["a.ogg", "b.ogg"], false),
    (["a.webp", "b.webp"], false),
    (["a.gifv", "b.gifv"], false),
    ([String](), false)
] {
    expect(canCollagesFromUrl(paths.map { URL(fileURLWithPath: "/fixtures/" + $0) }), expected, "grouping eligibility \(paths)")
}
for count in [2, 3, 9, 10] {
    let controller = Controller(state(count), text: "short caption")
    expect(controller.genericView.tableView.count, count, "grouped PDFs keep file rows \(count)")
    expect(controller.displayedPlaceholder, strings().previewSenderCommentPlaceholder, "grouped PDFs keep placeholder \(count)")
    verifyAccepted(controller, sizes: [count], caption: "short caption", grouped: true, label: "grouped PDF \(count)")
    let messages = controller.chatInteraction.batches.flatMap { $0.messages }
    expect(messages.map { $0.text }, Array(repeating: "", count: count - 1) + ["short caption"], "grouped PDF \(count) caption on last file")
    expect(Set(messages.compactMap { $0.localGroupingKey }).count, 1, "grouped PDF \(count) one grouping key")
}

for count in [1, 2, 10] {
    verifyAccepted(Controller(state(count, mode: .media), text: "caption"), sizes: [count], caption: "caption", grouped: count > 1, label: "media \(count)")
}
private let interactive = Controller(state(2, mode: .media), text: "caption")
interactive.send()
expect(interactive.chatInteraction.batches.flatMap { $0.messages.map { $0.text } }, ["caption", ""], "interactive caption remains on first media")

for grouped in [false, true] {
    verifyAccepted(Controller(state(1, grouped: grouped), text: "caption"), sizes: [1], caption: "caption", grouped: false, label: "single PDF \(grouped)")
}
private let archive = Controller(state(1, mode: .archive, grouped: false, media: { TelegramMediaFile(mimeType: "application/zip", resource: LocalFileArchiveMediaResource()) }), text: "archive caption")
verifyAccepted(archive, sizes: [1], caption: "archive caption", grouped: false, label: "archive")

for mode in [PreviewSendingState.State.file, .media] {
    let cleared = Controller(state(2, mode: mode), text: "")
    cleared.send()
    expect(cleared.chatInteraction.batches.count, 1, "clearing caption still permits grouped \(mode)")
    verifyBlocked(Controller(state(2, mode: mode, grouped: false), text: "separate comment"), label: "ungrouped \(mode)")
    verifyAccepted(Controller(state(2, mode: mode, grouped: false), text: "separate comment", slowMode: nil), sizes: [2], caption: "", grouped: false, additional: "separate comment", label: "ungrouped outside slow-mode \(mode)")
    for count in [11, 20, 21] {
        verifyBlocked(Controller(state(count, mode: mode), text: "caption"), label: "multi-batch \(mode) \(count)")
        verifyBlocked(Controller(state(count, mode: mode), text: " \n "), label: "raw whitespace multi-batch \(mode) \(count)")
        let sizes = count == 11 ? [10, 1] : count == 20 ? [10, 10] : [10, 10, 1]
        verifyAccepted(Controller(state(count, mode: mode), text: ""), sizes: sizes, caption: "", grouped: true, label: "empty multi-batch \(mode) \(count)")
        let outside = Controller(state(count, mode: mode), text: "caption", slowMode: nil)
        outside.send()
        expect(outside.chatInteraction.batches.map { $0.medias.count }, sizes, "outside slow-mode multi-batch sizes \(mode) \(count)")
        expect(outside.chatInteraction.batches.map { $0.additional?.inputText }, sizes.map { _ in nil as String? }, "outside slow-mode multi-batch no separate text \(mode) \(count)")
    }
}

for kind in ["sticker", "voice", "instant-video"] {
    let factory: () -> Media = {
        let media = TelegramMediaFile(mimeType: kind == "sticker" ? "image/webp" : "audio/ogg")
        media.isVoice = kind == "voice"
        media.isInstantVideo = kind == "instant-video"
        return media
    }
    for grouped in [false, true] {
        verifyBlocked(Controller(state(1, grouped: grouped, media: factory), text: "comment"), label: "single cannot-caption \(kind) \(grouped)")
    }
    verifyAccepted(Controller(state(1, grouped: false, media: factory), text: "comment", slowMode: nil), sizes: [1], caption: "", grouped: false, additional: "comment", label: "single cannot-caption outside slow-mode \(kind)")
}

private let sendingId = MessageId(peerId: PeerId(0), namespace: 0, id: 1)
for slowMode in [SlowMode(timeout: 1), SlowMode(timeout: 30), SlowMode(sendingIds: [sendingId])] {
    for text in ["", "caption"] {
        verifyBlocked(Controller(state(2), text: text, slowMode: slowMode), label: "active cooldown \(slowMode) \(text)", cooldown: true)
    }
}
for timeout: Int32 in [0, -1] {
    verifyAccepted(Controller(state(2), text: "caption", slowMode: SlowMode(timeout: timeout)), sizes: [2], caption: "caption", grouped: true, label: "expired timeout \(timeout)")
}

for text in ["", " \n\t ", "\u{2028}", " padded caption ", "подпись"] {
    verifyAccepted(Controller(state(2), text: text), sizes: [2], caption: text.trimmed, grouped: true, label: "grouped whitespace \(text.debugDescription)")
    let ungrouped = Controller(state(2, grouped: false), text: text)
    if text.isEmpty {
        verifyAccepted(ungrouped, sizes: [2], caption: "", grouped: false, label: "empty ungrouped")
    } else {
        verifyBlocked(ungrouped, label: "nonempty raw ungrouped \(text.debugDescription)")
    }
    let outside = Controller(state(2, grouped: false), text: text, slowMode: nil)
    verifyAccepted(outside, sizes: [2], caption: "", grouped: false, additional: text.trimmed.isEmpty ? nil : text.trimmed, label: "outside whitespace \(text.debugDescription)")
}
for grouped in [false, true] {
    verifyBlocked(Controller(state(0, grouped: grouped), text: "caption"), label: "empty preview nonempty input \(grouped)")
    verifyAccepted(Controller(state(0, grouped: grouped), text: "caption", slowMode: nil), sizes: [0], caption: "caption", grouped: false, label: "empty preview routing unchanged \(grouped)")
}
