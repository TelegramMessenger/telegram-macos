for condition in ["closed", "sent", "stale"] {
    let controller = Controller(state(2), text: "caption")
    if condition == "closed" { controller.pendingActions.close() }
    if condition == "sent" { controller.sent = true }
    if condition == "stale" { controller.sourceIsCurrent = false }
    controller.send()
    expect(controller.chatInteraction.batches.count, 0, "\(condition) guard preserved")
}
