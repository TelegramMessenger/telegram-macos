enum ChatTextInputAttribute: Equatable { case bold(Range<Int>) }
private let boldKey = NSAttributedString.Key("test-bold")
public final class ChatTextInputState {
    let inputText: String
    let selectionRange: Range<Int>
    let attributes: [ChatTextInputAttribute]
    var inlineMedia: [MediaId: Media] { [:] }
    init() {
        self.inputText = ""
        self.selectionRange = 0..<0
        self.attributes = []
    }
    init(inputText: String) {
        self.inputText = inputText
        self.selectionRange = inputText.length..<inputText.length
        self.attributes = []
    }
    init(attributedText: NSAttributedString, selectionRange: Range<Int>) {
        self.inputText = attributedText.string
        self.selectionRange = selectionRange
        var attributes: [ChatTextInputAttribute] = []
        attributedText.enumerateAttribute(boldKey, in: NSMakeRange(0, attributedText.length)) { value, range, _ in
            if value != nil { attributes.append(.bold(range.location..<(range.location + range.length))) }
        }
        self.attributes = attributes
    }
    func subInputState(from range: NSRange) -> ChatTextInputState {
        precondition(range.location == 0 && range.length == inputText.length)
        let text = NSMutableAttributedString(string: inputText)
        for case let .bold(range) in attributes {
            text.addAttribute(boldKey, value: true, range: NSRange(range))
        }
        let trimmed = text.attributedSubstring(from: range).trimmed
        return ChatTextInputState(attributedText: trimmed, selectionRange: 0..<0)
    }
}
