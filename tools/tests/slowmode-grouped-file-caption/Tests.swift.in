final class ChatInteraction {
    struct Schedule { let date: Date }
    enum Unblock { case unblockText(Int32) }
    var presentation = Presentation()
    var peer: Peer? = Peer()
    var batches: [Batch] = []
    func boostToUnrestrict(_ reason: Unblock) {}
    func sendMediasObserved(_ media: [Media], _ caption: ChatTextInputState, _ grouped: Bool, _ additional: ChatTextInputState?, _ silent: Bool, _ atDate: Schedule?, _ spoiler: Bool, _ effect: Int?, _ leading: Bool, submission: Submission?, part: Int) {
        batches.append(Batch(medias: media, caption: caption, grouped: grouped, additional: additional, spoiler: spoiler, leading: leading, silent: silent, scheduled: atDate != nil, effect: effect, part: part, messages: enqueueCaption(media: media, input: caption, isCollage: grouped)))
    }
}
