var storedGroups: [MessageId: [Message]] = [:]
var storedMessages: [MessageId: Message] = [:]

final class Transaction {
    func getMessageGroup(_ id: MessageId) -> [Message]? {
        return storedGroups[id]
    }
    func getMessage(_ id: MessageId) -> Message? {
        return storedMessages[id]
    }
}

final class Postbox {
    func transaction<T>(_ f: (Transaction) -> T) -> Signal<T, NoError> {
        return Signal(value: f(Transaction()))
    }
}

final class Account {
    let postbox = Postbox()
}

protocol AccountContextProtocol: AnyObject {
    var account: Account { get }
    var peerId: PeerId { get }
}

final class AccountContext: AccountContextProtocol {
    let account = Account()
    let peerId: PeerId
    let window = 0
    init(peerId: PeerId) {
        self.peerId = peerId
    }
}

extension AccountContextProtocol {
    var concrete: AccountContext {
        return self as! AccountContext
    }
    var engine: TelegramEngine {
        return TelegramEngine()
    }
}

