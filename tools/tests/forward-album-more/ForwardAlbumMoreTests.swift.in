    return true
}

func forwardMenuItems(data: MenuData, message: Message, useGroupIfNeeded: Bool, chatInteraction: ChatInteraction, context: AccountContext) -> [ContextMenuItem] {
    let isService = false
    var secondBlock: [ContextMenuItem] = []
    __FORWARD_BLOCK__
    return secondBlock
}

struct Entry {
    let name: String
    let run: () -> Void
}

func entries(of forward: ContextMenuItem) -> [Entry] {
    var result: [Entry] = []
    if let handler = forward.handler {
        result.append(Entry(name: forward.title, run: handler))
    }
    func walk(_ items: [ContextMenuItem], _ path: String) {
        for item in items {
            if let handler = item.handler {
                result.append(Entry(name: path + item.title, run: handler))
            }
            if let row = item as? ReactionPeerMenu, case let .forward(callback, _) = row.destination {
                result.append(Entry(name: path + item.title + " > topic", run: { callback(row.peer.id, 7) }))
            }
            if let submenu = item.submenu {
                walk(submenu.items, path + item.title + " > ")
                if let provider = submenu.asyncItemsProvider {
                    var loaded: [ContextMenuItem] = []
                    _ = provider { loaded = $0 }
                    walk(loaded, path + item.title + " > ")
                }
            }
        }
    }
    walk(forward.submenu?.items ?? [], forward.title + " > ")
    return result
}

var passed = 0
var failures = 0

func check(_ name: String, _ condition: Bool) {
    if condition {
        passed += 1
    } else {
        failures += 1
        print("FAILED: \(name)")
    }
}

let me = Peer(1, "Me")
let friend = Peer(2, "Friend")
let secret = Peer(3, "Secret", namespace: Namespaces.Peer.SecretChat)
let group = Peer(4, "Group")
let channel = Peer(5, "Channel")
let folderChat = Peer(6, "Folder chat")
let work = ChatListFilter(title: "Work")
let account = AccountContext(peerId: me.id)

let albumKey: Int64 = 77
let first = Message(11, groupingKey: albumKey)
let second = Message(12, groupingKey: albumKey)
let third = Message(13, groupingKey: albumKey)
let album = [first, second, third]
let single = Message(21)
let missing = Message(31)

for message in album {
    storedMessages[message.id] = message
    storedGroups[message.id] = album
}
storedMessages[single.id] = single
storedGroups[single.id] = [single]

let chat = ChatMode(customChatContents: nil)
let hashtagFoundAlbum = ChatMode(customChatContents: HashtagSearchContents(results: album))
let hashtagFoundCaption = ChatMode(customChatContents: HashtagSearchContents(results: [first]))

struct Case {
    let name: String
    let mode: ChatMode
    let message: Message
    let groupped: [Message]?
    let useGroupIfNeeded: Bool
    let expected: [Int32]
}

let cases: [Case] = [
    Case(name: "chat: album menu opened on the caption of the first item", mode: chat, message: first, groupped: album, useGroupIfNeeded: true, expected: [11, 12, 13]),
    Case(name: "chat: album menu opened on the caption of the last item", mode: chat, message: third, groupped: album, useGroupIfNeeded: true, expected: [11, 12, 13]),
    Case(name: "chat: menu of one item in an album", mode: chat, message: second, groupped: album, useGroupIfNeeded: false, expected: [12]),
    Case(name: "chat: menu of the captioned item in an album", mode: chat, message: first, groupped: album, useGroupIfNeeded: false, expected: [11]),
    Case(name: "chat: album item shown on its own row", mode: chat, message: second, groupped: album, useGroupIfNeeded: true, expected: [11, 12, 13]),
    Case(name: "chat: message not in an album", mode: chat, message: single, groupped: [single], useGroupIfNeeded: true, expected: [21]),
    Case(name: "chat: message missing from the database", mode: chat, message: missing, groupped: nil, useGroupIfNeeded: true, expected: []),
    Case(name: "hashtag search: album menu opened on the caption", mode: hashtagFoundAlbum, message: first, groupped: album, useGroupIfNeeded: true, expected: [11, 12, 13]),
    Case(name: "hashtag search: menu of one item in an album", mode: hashtagFoundAlbum, message: second, groupped: album, useGroupIfNeeded: false, expected: [12]),
    Case(name: "hashtag search: only the captioned item found", mode: hashtagFoundCaption, message: first, groupped: album, useGroupIfNeeded: true, expected: [11]),
]

func makeForward(_ item: Case) -> (ContextMenuItem?, ChatControllerStub) {
    let chatInteraction = ChatInteraction(context: account, mode: item.mode)
    let controller = ChatControllerStub(context: account, chatInteraction: chatInteraction)
    let data = MenuData(message: item.message, chatInteraction: chatInteraction, groupped: item.groupped, accountPeer: me, recentUsedPeers: [friend, secret], favoritePeers: [group], dialogs: [channel], folders: [work], folderPeers: { _ in .single([folderChat]) })
    let block = forwardMenuItems(data: data, message: item.message, useGroupIfNeeded: item.useGroupIfNeeded, chatInteraction: chatInteraction, context: account)
    return (block.first(where: { $0.title == "Forward" }), controller)
}

for item in cases {
    let (forward, _) = makeForward(item)
    check("\(item.name): the menu has Forward", forward != nil)
    guard let forward = forward else {
        continue
    }
    let names = entries(of: forward).map { $0.name }
    check("\(item.name): Forward has More...", names.contains("Forward > More..."))
    check("\(item.name): Forward lists the quick chats and the folder", ["Forward > Saved Messages", "Forward > Friend", "Forward > Group", "Forward > Channel", "Forward > Folders > Work > Folder chat"].allSatisfy(names.contains))
    var results: [[Int32]] = []
    for (index, name) in names.enumerated() {
        let (fresh, controller) = makeForward(item)
        let all = fresh.map { entries(of: $0) } ?? []
        sent = []
        withExtendedLifetime(controller) {
            if index < all.count, all[index].name == name {
                all[index].run()
            }
        }
        check("\(item.name): \(name) sends one forward", sent.count == 1)
        check("\(item.name): \(name) sends \(item.expected)", sent.first == item.expected)
        results.append(sent.first ?? [])
    }
    check("\(item.name): every Forward entry sends the same messages", Set(results.map { $0.map(String.init).joined(separator: ",") }).count == 1)
}

check("nothing was reported instead of forwarded", reported.isEmpty)

print("\(passed) passed, \(failures) failed")
exit(failures == 0 ? 0 : 1)
