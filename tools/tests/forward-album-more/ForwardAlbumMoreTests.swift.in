    private let getMessages: (([MessageId], Bool) -> Signal<[Message], NoError>)?

    __OBJECT_CONVENIENCE_INIT__

    __OBJECT_INIT__

    func possibilityPerformTo(_ peer: Peer) -> Bool {
        return true
    }

    func forwardedIds() -> [Int32] {
        let context = self.context
        __OBJECT_ALBUM__
        __OBJECT_IDS_LINE__
        __OBJECT_LOOKUP__
        var ids: [Int32] = []
        _ = messages.start(next: { found in
            ids = found.map { $0.id.id }
        })
        return ids
    }
}

