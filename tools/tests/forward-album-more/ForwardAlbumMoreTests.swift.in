final class ChatInteraction {
    let context: AccountContext
    let mode: ChatMode
    var presentation = Presentation()
    var peerId: PeerId {
        return context.peerId
    }
    __FORWARD_MESSAGES_OBSERVED__
    init(context: AccountContext, mode: ChatMode) {
        self.context = context
        self.mode = mode
    }
    func getMessages(_ messageIds: [MessageId], _ album: Bool) -> Signal<[Message], NoError> {
        __GET_MESSAGES__
    }
    func captureAnalyticsContext(sourcePeerId: PeerId? = nil) -> AnalyticsContext {
        return Analytics.shared.unresolvedContext()
    }
    func captureDeferredSendAction() -> ChatDeferredSendAction {
        return ChatDeferredSendAction(isCurrent: { true })
    }
    func quickForward(_ object: ChatHistoryForwardMessagesObject, peerId: PeerId, threadId: Int64?, analyticsContext: AnalyticsContext, action: ChatDeferredSendAction) {
        guard action.takeIfCurrent() else {
            return
        }
        sent.append(object.forwardedIds())
    }
    func reportMessages(_ report: Int, _ ids: [MessageId]) {
        reported.append(ids)
    }
}

