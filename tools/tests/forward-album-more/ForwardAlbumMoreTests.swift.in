import Foundation

enum NoError {}

final class Disposable {}

struct Signal<T, E> {
    let value: T
    static func single(_ value: T) -> Signal<T, E> {
        return Signal(value: value)
    }
    func start(next: (T) -> Void) -> Disposable {
        next(value)
        return Disposable()
    }
}

precedencegroup PipeRight {
    associativity: left
    higherThan: AssignmentPrecedence
}

infix operator |> : PipeRight

func |> <T, U>(value: T, function: (T) -> U) -> U {
    return function(value)
}

func deliverOnMainQueue<T, E>(_ signal: Signal<T, E>) -> Signal<T, E> {
    return signal
}

func mapToSignal<T, U, E>(_ f: @escaping (T) -> Signal<U, E>) -> (Signal<T, E>) -> Signal<U, E> {
    return { signal in f(signal.value) }
}

final class AnalyticsScope {}

final class AnalyticsPresentation {
    func end() {}
}

final class AnalyticsContext {
    let scope: AnalyticsScope? = nil
    var isExcluded: Bool {
        return false
    }
    func restricting(peerId: PeerId) -> AnalyticsContext {
        return self
    }
    func beginPresentation() -> AnalyticsPresentation {
        return AnalyticsPresentation()
    }
    func preservingPresentation<Value, Failure>(_ signal: Signal<Value, Failure>) -> Signal<Value, Failure> {
        return signal
    }
}

struct TelegramEngine {}

final class Analytics {
    static let shared = Analytics()
    func unresolvedContext() -> AnalyticsContext {
        return AnalyticsContext()
    }
    func captureContext(engine: TelegramEngine, peerId: PeerId, inherited: AnalyticsContext? = nil) -> AnalyticsContext {
        return inherited ?? AnalyticsContext()
    }
}

enum AnalyticsFlows {
    enum ChatForwardPicker {
        enum EntryPoint {
            case messageSelection
            case messageMenu
            case moreMenu
            case replacementMenu
            case rowAction
        }
    }
}

final class AnalyticsForwardPickerJourney {
    init(context: AnalyticsContext, entry: AnalyticsFlows.ChatForwardPicker.EntryPoint) {}
    func restrict(to context: AnalyticsContext) {}
    func discard() {}
}

