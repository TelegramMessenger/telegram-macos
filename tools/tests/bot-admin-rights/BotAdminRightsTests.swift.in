import Foundation

struct TelegramChatAdminRightsFlags: OptionSet, Hashable {
    let rawValue: Int32
    static let canChangeInfo = TelegramChatAdminRightsFlags(rawValue: 1 << 0)
    static let canPostMessages = TelegramChatAdminRightsFlags(rawValue: 1 << 1)
    static let canEditMessages = TelegramChatAdminRightsFlags(rawValue: 1 << 2)
    static let canDeleteMessages = TelegramChatAdminRightsFlags(rawValue: 1 << 3)
    static let canBanUsers = TelegramChatAdminRightsFlags(rawValue: 1 << 4)
    static let canInviteUsers = TelegramChatAdminRightsFlags(rawValue: 1 << 5)
    static let canPinMessages = TelegramChatAdminRightsFlags(rawValue: 1 << 6)
    static let canAddAdmins = TelegramChatAdminRightsFlags(rawValue: 1 << 7)
    static let canBeAnonymous = TelegramChatAdminRightsFlags(rawValue: 1 << 8)
    static let canManageCalls = TelegramChatAdminRightsFlags(rawValue: 1 << 9)
    static let canManageTopics = TelegramChatAdminRightsFlags(rawValue: 1 << 10)
    static let canPostStories = TelegramChatAdminRightsFlags(rawValue: 1 << 11)
    static let canEditStories = TelegramChatAdminRightsFlags(rawValue: 1 << 12)
    static let canDeleteStories = TelegramChatAdminRightsFlags(rawValue: 1 << 13)
    static let canManageDirect = TelegramChatAdminRightsFlags(rawValue: 1 << 14)
    static let canManageWelcomeMessages = TelegramChatAdminRightsFlags(rawValue: 1 << 15)
}

enum RightsItem {
    enum Sub: Hashable {
        case messages
        case stories
    }
    case direct(TelegramChatAdminRightsFlags)
    case sub(Sub, [TelegramChatAdminRightsFlags])
}

struct State {
    var rights: TelegramChatAdminRightsFlags
}

final class Arguments {
    let toggleRight: (RightsItem, Bool) -> Void
    init(toggleRight: @escaping (RightsItem, Bool) -> Void) {
        self.toggleRight = toggleRight
    }
}

let defaults: TelegramChatAdminRightsFlags = [__DEFAULTS__]
var stateValue = State(rights: defaults)

func updateState(_ f: (State) -> State) {
    stateValue = f(stateValue)
}

let arguments = Arguments(toggleRight: __TOGGLE__)

func click(_ right: TelegramChatAdminRightsFlags) {
    let state = stateValue
    let rights: RightsItem = .direct(right)
    let action: () -> Void = {
        __ACTION__
    }
    action()
}

var failures = 0

func check(_ condition: Bool, _ name: String) {
    if condition {
        print("ok   \(name)")
    } else {
        failures += 1
        print("FAIL \(name)")
    }
}

let rows: [(String, TelegramChatAdminRightsFlags)] = [__ROWS__]

check(!rows.isEmpty, "the screen lists rights rows")

for (name, right) in rows {
    stateValue = State(rights: defaults)
    let initially = defaults.contains(right)
    click(right)
    check(stateValue.rights.contains(right) == !initially, "\(name): one click turns it \(initially ? "off" : "on")")
    check(stateValue.rights.subtracting(right) == defaults.subtracting(right), "\(name): other rights stay as they were")
    click(right)
    check(stateValue.rights == defaults, "\(name): a second click puts it back")
}

stateValue = State(rights: defaults)
for (_, right) in rows where defaults.contains(right) {
    click(right)
}
check(stateValue.rights.intersection(defaults).isEmpty, "every right that starts on can be turned off")

check(__ADD_SENDS_STATE__, "Add sends the rights from the current state")

if failures > 0 {
    print("\(failures) failed")
    exit(1)
}
print("all passed")
