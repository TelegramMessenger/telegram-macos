    let string: String

    init(inputText: String) {
        self.string = inputText
    }
}

extension String {
    static func initialize(string: String) -> String {
        return string
    }
}

struct _ExportedInvitation: Equatable {
    var title: String?
    var requestApproval = false
    var isRevoked = false
    var date: Int32 = 0
    var startDate: Int32?
    var expireDate: Int32?
    var usageLimit: Int32?
    var count: Int32?
    var pricing: StarsSubscriptionPricing?

    var isExpired: Bool {
        if let expireDate = self.expireDate {
            return expireDate < Int32(Date().timeIntervalSince1970)
        }
        return false
    }

    var isLimitReached: Bool {
        return false
    }
}

