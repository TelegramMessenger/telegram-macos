import Foundation
import XCTest

enum KeyHandlerResult: Equatable { case invoked, rejected, invokeNext }
enum Key { case F, Tab }
struct Flags: OptionSet { let rawValue: Int; static let command = Flags(rawValue: 1) }
final class Window {
    var handler: ((Int) -> KeyHandlerResult)?
    func set(handler: @escaping (Int) -> KeyHandlerResult, with owner: AnyObject, for key: Key, modifierFlags: Flags) {
        precondition(key == .F && modifierFlags == [.command])
        self.handler = handler
    }
}
__MODES__
protocol PeerMediaSearchable { func toggleSearch() }
final class Child: PeerMediaSearchable {
    var calls = 0
    func toggleSearch() { calls += 1 }
}
final class MediaController {
    var mode: PeerMediaCollectionMode?
    var externalSearchData: Bool?
    var window: Window?
    let child = Child()
    var membersCalls = 0
    __HAS_SEARCH__
    func controller(for mode: PeerMediaCollectionMode) -> AnyObject { child }
    func searchGroupUsers() { membersCalls += 1 }
    func register() { __REGISTER__ }
    func buttonAction() {
        let action: () -> Void = __BUTTON_ACTION__
        action()
    }
}
private func check(_ name: String, _ value: Bool) { record(name, value) }

private var assertions = 0
private var failures: [String] = []
private func record(_ name: String, _ value: Bool, file: StaticString = #filePath, line: UInt = #line) {
    assertions += 1
    if !value { failures.append(name) }
    XCTAssertTrue(value, name, file: file, line: line)
}

final class RegressionTests: XCTestCase {
    @objc func testRegressionScenarios() {
        let modes: [PeerMediaCollectionMode] = [.stories, .gifts, .savedMessages, .members, .archiveStories, .photoOrVideo, .saved, .file, .webpage, .music, .voice, .gifs, .commonGroups, .similarChannels, .similarBots, .polls]
        for mode in modes {
            for external in [false, true] {
                let keyboard = MediaController()
                let window = Window()
                keyboard.window = window
                keyboard.mode = mode
                keyboard.externalSearchData = external ? true : nil
                keyboard.register()
                let button = MediaController()
                button.mode = mode
                button.externalSearchData = external ? true : nil
                button.buttonAction()
                let available = !external && ![PeerMediaCollectionMode.stories, .gifts, .archiveStories, .commonGroups].contains(mode)
                let result = window.handler?(0)
                let expectedMembers = available && mode == .members ? 1 : 0
                let expectedChild = available && mode != .members ? 1 : 0
                check("\(mode) external=\(external)", result == (available ? .invoked : .rejected) && keyboard.membersCalls == expectedMembers && keyboard.child.calls == expectedChild && keyboard.membersCalls == button.membersCalls && keyboard.child.calls == button.child.calls)
            }
        }
        let window = Window()
        var released: MediaController? = MediaController()
        released?.window = window
        released?.mode = .members
        released?.register()
        weak var weakController = released
        released = nil
        check("released owner rejected", weakController == nil && window.handler?(0) == .rejected)
    }
}

let suite = XCTestSuite(forTestCaseClass: RegressionTests.self)
suite.run()
let nativeRun = suite.testRun!
print("RESULT " + String(data: try! JSONSerialization.data(withJSONObject: [
    "test_cases": nativeRun.executionCount,
    "scenarios": assertions,
    "assertions": assertions,
    "failed_assertions": failures.count,
    "failures": failures,
    "xctest_failures": nativeRun.totalFailureCount
], options: [.sortedKeys]), encoding: .utf8)!)
exit(nativeRun.hasSucceeded && failures.isEmpty ? 0 : 1)
