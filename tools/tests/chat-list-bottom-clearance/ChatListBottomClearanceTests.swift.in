func floorToScreenPixels(_ value: CGFloat) -> CGFloat { floor(value) }
func floorToScreenPixels(_ scale: CGFloat, _ value: CGFloat) -> CGFloat { floor(value * scale) / scale }

extension CAMediaTimingFunctionName {
    static let spring = CAMediaTimingFunctionName.easeOut
}

extension NSView {
    var backingScaleFactor: CGFloat { 2 }

    func _changeBounds(from: NSRect, to: NSRect, animated: Bool, duration: Double, timingFunction: CAMediaTimingFunctionName, completion: (Bool) -> Void) {
        bounds = to
        completion(true)
    }
}

