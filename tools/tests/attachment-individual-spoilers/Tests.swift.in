final class GroupedLayout {
    var messages: [Message]
    var target: Int?
    var count: Int { messages.count }
    var dimensions: NSSize { NSSize(width: 280, height: CGFloat(count * 40)) }
    init(_ messages: [Message]) { self.messages = messages }
    func measure(_ size: NSSize, preview: Bool = false) {}
    func frame(at index: Int) -> NSRect { NSRect(x: 0, y: index * 40, width: 280, height: 40) }
    func moveItemIfNeeded(at index: Int, point: NSPoint) -> Int? {
        guard let target else { return nil }
        messages.move(at: index, to: target)
        self.target = nil
        return target
    }
}
