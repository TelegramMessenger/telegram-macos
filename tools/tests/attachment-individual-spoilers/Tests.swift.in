func take<T>(_ count: Int) -> (Signal<T, NoError>) -> Signal<T, NoError> { { $0 } }
func map<A, B>(_ f: @escaping (A) -> B) -> (Signal<A, NoError>) -> Signal<B, NoError> { { .single(f($0.value)) } }
final class Atomic<Value> {
    var value: Value
    init(value: Value) { self.value = value }
    func with<T>(_ f: (Value) -> T) -> T { f(value) }
    func swap(_ updated: Value) -> Value { let old = value; value = updated; return old }
}
final class ValuePromise<T> {
    var value: T?
    func set(_ value: T) { self.value = value }
}
