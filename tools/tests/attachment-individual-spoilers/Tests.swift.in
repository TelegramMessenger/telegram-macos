var failures: [String] = []
var checks = 0
func check(_ condition: @autoclosure () -> Bool, _ message: String) { checks += 1; if !condition() { failures.append(message) } }
func fixture(_ count: Int, grouped: Bool = true) -> TestController {
    let value = TestController()
    let urls = (0 ..< count).map { URL(fileURLWithPath: "/synthetic/\($0 / 2)/same-\($0 % 2).jpg") }
    value.mediaByUrl = Dictionary(uniqueKeysWithValues: urls.enumerated().map { ($0.element, $0.offset % 2 == 0 ? TelegramMediaImage("photo\($0.offset)", id: $0.offset) as Media : TelegramMediaFile("video\($0.offset)", video: true) as Media) })
    value.urls = urls
    value.genericView.state = value.genericView.state.withUpdatedIsCollage(grouped)
    value.installChatSender()
    return value
}
func menu(_ controller: TestController, at index: Int) -> [ContextMenuItem] {
    let rows = controller.rows()
    if controller.genericView.state.state == .media && controller.genericView.state.isCollage {
        return rows[index / 10].menuItems(in: NSPoint(x: 30, y: CGFloat((index % 10) * 40 + 16))).value
    }
    return rows[index].menuItems(in: NSPoint(x: 30, y: 20)).value
}
func toggle(_ controller: TestController, at index: Int) {
    let items = menu(controller, at: index)
    check(items.count == 1, "attachment \(index) has one individual spoiler action")
    items.first?.handler()
}
func previewFlags(_ controller: TestController) -> [Bool] {
    controller.rows().flatMap { row -> [Bool] in
        if let row = row as? MediaGroupPreviewRowItem { return row.parameters.map { $0.forceSpoiler } }
        if let row = row as? MediaPreviewRowItem { return [row.parameters?.forceSpoiler == true] }
        return []
    }
}
func sentFlags(_ controller: TestController) -> [Bool] { controller.context.account.batches.flatMap { $0.filter { $0.media != nil }.map { $0.spoiler } } }
func resetSent(_ controller: TestController) { controller.context.account.batches = [] }

let basic = fixture(3)
let originals = basic.urls
toggle(basic, at: 1)
check(previewFlags(basic) == [false, true, false], "one grouped video hides without hiding neighbors")
check(menu(basic, at: 1).first?.text == strings().previewSenderSpoilerTooltipDisable, "selected tile offers disable")
check(menu(basic, at: 0).first?.text == strings().previewSenderSpoilerTooltipEnable, "visible tile offers enable")
check(basic.rows()[0].menuItems(in: NSPoint(x: 0, y: 0)).value.isEmpty, "album gutter has no target")
let before = previewMediaEntries(basic.state())
toggle(basic, at: 0)
let after = previewMediaEntries(basic.state())
check(before != after, "entry equality changes after individual selection")
toggle(basic, at: 0)
basic.urls = [originals[2], originals[0], originals[1]]
check(previewFlags(basic) == [false, false, true], "URL identity follows reorder with duplicate basenames")
basic.urls.remove(at: 1)
check(previewFlags(basic) == [false, true], "delete preceding item preserves selected URL")
let replaced = URL(fileURLWithPath: "/synthetic/editor/edited.mp4")
basic.mediaByUrl[replaced] = TelegramMediaFile("edited", video: true)
basic.replaceAttachmentUrl(at: 1, with: replaced)
check(previewFlags(basic) == [false, true], "editor replacement inherits spoiler")
basic.replaceAttachmentUrl(at: 1, with: replaced)
check(previewFlags(basic) == [false, true], "same-URL editor replacement retains override")
basic.urls.remove(at: 1)
basic.urls.append(replaced)
check(previewFlags(basic) == [false, false], "deleted URL does not resurrect individual spoiler on re-add")
toggle(basic, at: 1)
basic.genericView.state = basic.genericView.state.withUpdatedSort(.up).withUpdatedIsCollage(false)
check(previewFlags(basic) == [false, true], "sort and ungrouping preserve per-URL choices")
check(basic.rows()[1].accessibilityCustomActions?.count == 3, "single video exposes spoiler, edit and delete accessibility actions")
basic.submit(additional: "comment")
check(sentFlags(basic) == [false, true], "ungrouped send serializes one spoiler")
let sent = basic.context.account.batches.flatMap { $0 }
check(sent.first?.text == "comment" && sent.first?.spoiler == false, "additional text never receives media spoiler")
check(sent.filter { $0.media != nil }.allSatisfy { $0.localGroupingKey == nil }, "ungrouped sends stay ungrouped")
check(sent.filter { $0.media != nil }.allSatisfy { $0.attributes.contains { $0 is NotificationInfoMessageAttribute } && $0.attributes.contains { $0 is OutgoingScheduleInfoMessageAttribute } && $0.attributes.contains { $0 is EffectMessageAttribute } && $0.attributes.contains { $0 is InvertMediaMessageAttribute } }, "silent schedule effect and caption-position attributes survive")
check(sent.filter { $0.media != nil }.map { $0.text } == ["caption", ""], "per-media spoiler does not move caption")
resetSent(basic)
basic.genericView.globalMenu().first?.handler()
check(previewFlags(basic) == [true, true], "global enable replaces mixed selection")
basic.genericView.globalMenu().first?.handler()
check(previewFlags(basic) == [false, false], "global disable clears all selections")
toggle(basic, at: 0)
basic.submit(override: true)
check(sentFlags(basic) == [true, true], "send-as-spoiler overrides individual choices")
resetSent(basic)
basic.submit(override: false)
check(sentFlags(basic) == [false, false], "explicit false send override clears selected flags")
check(previewFlags(basic) == [true, false], "send override does not mutate preview selection")
basic.genericView.state = basic.genericView.state.withUpdatedState(.file)
check(previewFlags(basic) == [false, false] && menu(basic, at: 0).isEmpty, "file mode suppresses spoiler previews and actions")
resetSent(basic)
basic.submit(override: true)
check(sentFlags(basic) == [false, false], "file-mode send-as-spoiler cannot leak photo flags")
basic.genericView.state = basic.genericView.state.withUpdatedState(.media)
check(previewFlags(basic) == [true, false], "return to media restores prior choices")

let global = fixture(3)
global.genericView.globalMenu().first?.handler()
toggle(global, at: 1)
check(previewFlags(global) == [true, false, true], "individual disable overrides enabled global default")
check(global.genericView.globalMenu().first?.text == strings().previewSenderSpoilerTooltipEnable, "mixed state offers global enable even with enabled default")
let visibleReplacement = URL(fileURLWithPath: "/synthetic/editor/visible.jpg")
global.mediaByUrl[visibleReplacement] = TelegramMediaImage("visible")
global.replaceAttachmentUrl(at: 1, with: visibleReplacement)
check(previewFlags(global) == [true, false, true], "editor replacement preserves explicit false override")
global.submit()
check(sentFlags(global) == [true, false, true], "global default plus individual exclusion serializes correctly")
global.genericView.globalMenu().first?.handler()
check(previewFlags(global) == [true, true, true], "global enable clears explicit false overrides")
global.genericView.globalMenu().first?.handler()
check(previewFlags(global) == [false, false, false], "global disable clears explicit true and false overrides")

let batches = fixture(23)
let batchUrls = batches.urls
for index in [0, 9, 10, 12, 20, 22] { toggle(batches, at: index) }
let expected = (0 ..< 23).map { [0, 9, 10, 12, 20, 22].contains($0) }
check(previewFlags(batches) == expected, "all three preview albums use their own flags")
check(batches.rows().compactMap { $0 as? MediaGroupPreviewRowItem }.flatMap { $0.urls } == batchUrls, "album URL slices align beyond ten attachments")
batches.submit()
check(batches.context.account.batches.map { $0.count } == [10, 10, 3], "batch sizes remain ten ten three")
check(sentFlags(batches) == expected, "batch-local spoiler indices map to correct outgoing media")
check(batches.context.account.batches.allSatisfy { Set($0.compactMap { $0.localGroupingKey }).count == 1 }, "each album keeps one grouping key")
check(Set(batches.context.account.batches.compactMap { $0.first?.localGroupingKey }).count == 3, "each album has a distinct grouping key")
check(batches.context.account.batches.flatMap { $0.compactMap { $0.media?.name } } == batches.getMedias().map { $0.name }, "send preserves URL/media order across batches")
resetSent(batches)
batches.installStorySender()
batches.submit()
check(sentFlags(batches) == expected, "story reply sender forwards per-media indices")
check(batches.context.account.batches.flatMap { $0 }.allSatisfy { $0.replyToStoryId?.id == 7 }, "story reply subject remains intact")

let drag = fixture(13)
toggle(drag, at: 11)
let groupItem = drag.rows()[1] as! MediaGroupPreviewRowItem
let rowView = MediaGroupPreviewRowView()
rowView.frame = NSRect(x: 0, y: 0, width: 320, height: 400)
rowView.item = groupItem
rowView.contents = (0 ..< groupItem.layout.count).map { _ in Node() }
rowView.draggingIndex = 1
groupItem.layout.target = 0
let beforeDrag = drag.urls
rowView.mouseUp(with: NSEvent(locationInWindow: NSPoint(x: 30, y: 20)))
var afterDrag = beforeDrag
afterDrag.move(at: 11, to: 10)
check(drag.urls == afterDrag, "second album drag changes only intended global URL positions")
check(rowView.rendered.map { $0.0 } == groupItem.layout.messages.map { $0.media[0].name }, "immediate drag redraw matches layout")
check(rowView.rendered.map { $0.1 } == Array(afterDrag[10...]), "immediate drag redraw URL identity is not stale")
check(rowView.rendered.map { $0.2 } == [true, false, false], "drag moves preview spoiler parameters with media")

let eligibility = fixture(7, grouped: false)
let types: [Media] = [TelegramMediaImage("image"), TelegramMediaFile("video", video: true), TelegramMediaFile("gif", video: true), TelegramMediaFile("round", video: true, round: true), TelegramMediaFile("sticker", video: true, sticker: true), TelegramMediaFile("animated", animatedSticker: true), TelegramMediaFile("document")]
for index in types.indices { eligibility.mediaByUrl[eligibility.urls[index]] = types[index] }
for index in 0 ..< 3 { toggle(eligibility, at: index) }
for index in 3 ..< 7 { check(menu(eligibility, at: index).isEmpty, "ineligible media \(index) has no spoiler action") }
check(previewFlags(eligibility) == [true, true, true, false, false, false, false], "photo ordinary video and GIF eligible; round stickers documents excluded")
eligibility.submit(override: true)
check(sentFlags(eligibility) == [true, true, true, false, false, false, false], "send-as-spoiler respects media eligibility")
let direct = Context()
_ = Sender.enqueue(media: types, caption: .init(inputText: "legacy"), context: direct, peerId: PeerId(0), replyId: nil, threadId: nil, isSpoiler: true)
check(direct.account.batches.first?.map { $0.spoiler } == [true, true, true, false, false, false, false], "legacy Bool enqueue overload remains compatible and eligible")

let race = fixture(3, grouped: false)
let prepared = Atomic(value: race.state())
race.bindPreparedState(prepared)
race.bindInteractiveState()
check(race.isMediaStateCurrent(), "matching prepared state starts current")
toggle(race, at: 1)
check(!race.isMediaStateCurrent(), "selection invalidates send until its prepared state arrives")
_ = prepared.swap(race.state())
check(race.isMediaStateCurrent(), "matching selection preparation releases send gate")
race.genericView.stateValueInteractiveUpdate?(race.genericView.state.withUpdatedState(.archive).withUpdatedIsCollage(true))
check(race.genericView.state.state == .archive && !race.genericView.state.isCollage, "interactive archive normalization writes authoritative state")
check(!race.isMediaStateCurrent(), "mode normalization invalidates prepared gate")
_ = prepared.swap(race.state())
check(race.isMediaStateCurrent(), "normalized archive state releases send gate")
race.genericView.stateValueInteractiveUpdate?(race.genericView.state.withUpdatedState(.media).withUpdatedIsCollage(true))
let documentUrl = URL(fileURLWithPath: "/synthetic/plain.txt")
race.mediaByUrl[documentUrl] = TelegramMediaFile("document")
race.urls.append(documentUrl)
check(!race.genericView.state.isCollage, "URL producer normalizes grouping in authoritative state")
_ = prepared.swap(race.state())
check(race.isMediaStateCurrent(), "normalized URL producer releases prepared gate")

let stale = fixture(4, grouped: false)
let staleUrls = stale.urls
let move = stale.tableReorder()
stale.urls.remove(at: 0)
move(2, 1)
check(stale.urls == [staleUrls[2], staleUrls[1], staleUrls[3]], "table drag resolves snapshot URL identities after deletion")
let moved = stale.urls
if @@TABLE_REORDER_GUARD@@ {
    move(-1, 0)
    move(100, 1)
}
check(@@TABLE_REORDER_GUARD@@ && stale.urls == moved, "table drag ignores invalid snapshot indices")
let staleAction = menu(stale, at: 1).first
stale.urls.remove(at: 1)
staleAction?.handler()
check(previewFlags(stale).allSatisfy { !$0 }, "deleted tile's pending menu cannot toggle survivor")

check(@@EDITOR_WIRING@@ == 3, "paint image and video editor paths all transfer URL spoiler state")
check(@@SEND_STATE_GUARD@@, "send waits for current prepared selection and stale transitions cannot overwrite it")
check(@@SNAPSHOT_BINDING@@, "ungrouped reorder closure resolves captured URLs not stale global positions")
let result: [String: Any] = ["checks": checks, "failures": failures, "passed": failures.isEmpty, "baseline_adapter": @@BASELINE_MODE@@]
let resultData = try! JSONSerialization.data(withJSONObject: result, options: [.prettyPrinted, .sortedKeys])
print(String(decoding: resultData, as: UTF8.self))
exit(failures.isEmpty ? 0 : 1)
