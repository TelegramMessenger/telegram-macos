final class ChatListFolderDragPresentation { var animationId = 0; var playback: Int?; var previewLayer: CALayer?; var dragFrame = NSRect.zero; let origin: NSView; var hiddenViews: [(NSView, CGFloat)]; var invalidated = false; var completed: ((Bool) -> Void)?; var timeout: Foundation.Timer?; var animationTimer: Foundation.Timer?; var panel: PreviewPanel?; var results: [Bool] = []; var deferCompletion = false; var deferredCompletion: (() -> Void)?; init(origin: NSView, decorations: [NSView]) { self.origin = origin; hiddenViews = ([origin] + decorations).map { ($0, $0.alphaValue) } }; var draggingImage: String { "avatar" }; func move(to: NSPoint) {}; func ended(at: NSPoint) { origin.alphaValue = 1 }; func accept(destination: (() -> NSView?)?) {}; func complete(added: Bool, completed: @escaping (Bool) -> Void) { results.append(added); origin.alphaValue = 1; if deferCompletion { deferredCompletion = { completed(added) } } else { completed(added) } }
__PRESENTATION__
}
public protocol NSDraggingSource: AnyObject {}
public class NSPasteboard { public struct PasteboardType: Hashable { let value: String; public init(_ value: String) { self.value = value } }; var values: [PasteboardType: String] = [:]; func string(forType type: PasteboardType) -> String? { values[type] } }
public class NSPasteboardItem: NSPasteboard { @discardableResult func setString(_ value: String, forType type: PasteboardType) -> Bool { values[type] = value; return true } }
public protocol NSDraggingInfo { var draggingSource: AnyObject? { get }; var draggingSourceOperationMask: NSDragOperation { get }; var draggingPasteboard: NSPasteboard { get }; var draggingLocation: NSPoint { get } }
public class NSDraggingItem { var draggingFrame = NSRect.zero; let writer: NSPasteboardItem; init(pasteboardWriter: NSPasteboardItem) { writer = pasteboardWriter }; func setDraggingFrame(_ frame: NSRect, contents: String) {} }
final class DragInfo: NSDraggingInfo { var draggingSource: AnyObject?; var draggingSourceOperationMask: NSDragOperation = .copy; let draggingPasteboard = NSPasteboard(); var draggingLocation = NSPoint(x: 30, y: 30) }
public class NSEvent { static var pressedMouseButtons: Int = 1; public struct ModifierFlags: OptionSet { public let rawValue: Int; public init(rawValue: Int) { self.rawValue = rawValue }; static let control = Self(rawValue: 1); static let command = Self(rawValue: 2); static let shift = Self(rawValue: 4); static let option = Self(rawValue: 8) }; var locationInWindow: NSPoint; var timestamp: TimeInterval; var clickCount: Int; var modifierFlags: ModifierFlags; init(_ x: Double = 30, _ y: Double = 30, time: Double = 0, clicks: Int = 1, flags: ModifierFlags = []) { locationInWindow = NSPoint(x: x, y: y); timestamp = time; clickCount = clicks; modifierFlags = flags } }
public class NSView { enum Position { case above }; var wantsLayer = false; var children: [NSView] = []; init() {}; init(frame: NSRect) { self.frame = frame }; func setAccessibilityElement(_ value: Bool) {}; func addSubview(_ view: NSView, positioned: Position, relativeTo: NSView?) { view.superview = self; children.append(view); if let layer = view.layer { self.layer?.addSublayer(layer) } }; func removeFromSuperview() { superview?.children.removeAll(where: { $0 === self }); layer?.removeFromSuperlayer(); superview = nil }; var alphaValue: CGFloat = 1; var window: Window? = Window(); var layer: CALayer? = CALayer(); var isHiddenOrHasHiddenAncestor: Bool { isHidden || (superview?.isHiddenOrHasHiddenAncestor ?? false) }; func convert(_ point: NSPoint, to view: NSView?) -> NSPoint { NSPoint(x: point.x + origin.x - (view?.origin.x ?? 0), y: point.y + origin.y - (view?.origin.y ?? 0)) }; var frame = NSRect(x: 0, y: 0, width: 300, height: 70) { didSet { layer?.frame = frame } }; var bounds: NSRect { NSRect(origin: .zero, size: frame.size) }; var simulatedVisibleRect: NSRect?; var visibleRect: NSRect { simulatedVisibleRect ?? bounds }; var isHidden = false; weak var superview: NSView?; var origin: NSPoint { NSPoint(x: frame.minX + (superview?.origin.x ?? 0), y: frame.minY + (superview?.origin.y ?? 0)) }; func convert(_ point: NSPoint, from view: NSView?) -> NSPoint { NSPoint(x: point.x + (view?.origin.x ?? 0) - origin.x, y: point.y + (view?.origin.y ?? 0) - origin.y) }; func convert(_ rect: NSRect, to view: NSView?) -> NSRect { NSRect(origin: convert(rect.origin, to: view), size: rect.size) }; func convert(_ rect: NSRect, from view: NSView?) -> NSRect { NSRect(origin: convert(rect.origin, from: view), size: rect.size) }; var events: [String] = []; var userInteractionEnabled = false; var snapshot: String { "avatar" }; var sessions: [(NSDraggingItem, NSDraggingSource)] = []; var forwardDown: ((NSEvent) -> Void)?; public func mouseDown(with event: NSEvent) { events.append("down"); forwardDown?(event) }; public func mouseDragged(with event: NSEvent) { events.append("dragged") }; public func mouseUp(with event: NSEvent) { events.append("up") }; public func scrollWheel(with event: NSEvent) { events.append("scroll") }; public func hitTest(_ point: NSPoint) -> NSView? { self }; public func draggingEntered(_ sender: NSDraggingInfo) -> NSDragOperation { [] }; public func draggingUpdated(_ sender: NSDraggingInfo) -> NSDragOperation { [] }; public func performDragOperation(_ sender: NSDraggingInfo) -> Bool { false }; @discardableResult func beginDraggingSession(with items: [NSDraggingItem], event: NSEvent, source: NSDraggingSource) -> NSDraggingSession { sessions.append((items[0], source)); return NSDraggingSession() } }
class RowBase: NSView { var item: AnyObject?; var isResorting = false }
class ChatListRowItem { enum Mode { case chat, topic }; var mode: Mode = .chat; var peer: Peer?; let context: Context; var isGroup = false; var isAd = false; var isSecret = false; var hideContent = false; var sidebarSelection: Bool?; init(_ context: Context, _ peer: Peer) { self.context = context; self.peer = peer } }
final class Row: RowBase { let photo = NSView(); var isRevealActive = false; var activeImage: NSView?; var starBadgeView: NSView?; var communityHiddenView: NSView?; var groupActivityView: NSView?; var avatarTimerBadge: NSView?
__ROW__
    func visibilityChanged() { __VISIBILITY_CALL__ }
}
