    func animateAlpha(from: CGFloat, to: CGFloat, duration: Double) { let animation = CABasicAnimation(keyPath: "opacity"); animation.fromValue = from; animation.toValue = to; animation.duration = duration; add(animation, forKey: "testAlpha") }
    func animateScaleSpring(from: CGFloat, to: CGFloat, duration: Double) { let animation = CABasicAnimation(keyPath: "transform.scale"); animation.fromValue = from; animation.toValue = to; animation.duration = duration; add(animation, forKey: "testScale") }
}
