class ClipView: NSView { var offset = NSPoint.zero; var documentRect = NSRect(x: 0, y: 0, width: 600, height: 600); override var bounds: NSRect { NSRect(origin: offset, size: frame.size) }; func scroll(to point: NSPoint) { offset = point } }
public class NSScrollView: NSView { let contentView = ClipView(); var scrollChanges = 0; func reflectScrolledClipView(_ clip: ClipView) { scrollChanges += 1 } }
