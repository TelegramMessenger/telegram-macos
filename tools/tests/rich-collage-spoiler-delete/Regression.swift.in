import AppKit
import RichTextEditorCore

protocol CanvasBlock {
    var id: BlockID { get }
}

final class MediaGroupBlockBox: CanvasBlock {
    let id: BlockID
    var kind: MediaGroupKind
    var mediaIDs: [String]
    var spoilers: [Bool]
    var caption: [TextRun]
    init(_ group: MediaGroupBlock) {
        id = group.id
        kind = group.kind
        mediaIDs = group.mediaIDs
        spoilers = group.spoilers
        caption = group.caption
    }
    func model() -> MediaGroupBlock {
        MediaGroupBlock(id: id, kind: kind, mediaIDs: mediaIDs, caption: caption, spoilers: spoilers)
    }
}

final class OtherBox: CanvasBlock {
    let id = BlockID.generate()
}

final class MediaInteractionOverlayView: NSView {}

@@HOSTED@@

final class TileView: NSView {
    let mediaID: String
    let spoiler: Bool
    init(_ mediaID: String, _ spoiler: Bool, _ size: CGSize) {
        self.mediaID = mediaID
        self.spoiler = spoiler
        super.init(frame: CGRect(origin: .zero, size: size))
    }
    required init?(coder: NSCoder) { fatalError() }
}

final class DocumentCanvasView {
    var boxes: [any CanvasBlock]
    var selectedCollageTile: (group: BlockID, index: Int)?
    var needsLayout = false
    var edits = 0
    var snapshot: [MediaGroupBlock] = []
    init(_ group: MediaGroupBlock) {
        boxes = [MediaGroupBlockBox(group)]
    }
    func editing(_ action: () -> Void) {
        edits += 1
        snapshot = boxes.compactMap { ($0 as? MediaGroupBlockBox)?.model() }
        action()
    }
    func deleteMediaBox(at index: Int) { boxes.remove(at: index) }
    var mediaGroupTileViews: [String: HostedMediaBlock] = [:]
    let mediaBlockHost = NSView()
    var mediaBlockViewWillRemove: ((NSView) -> Void)?
    var mediaGroupTileProvider: (String, Bool, CGSize) -> NSView? = { TileView($0, $1, $2) }
    func syncTiles(_ box: MediaGroupBlockBox) {
        let frames = box.mediaIDs.enumerated().map { CGRect(x: CGFloat($0.offset) * 100, y: 0, width: 100, height: 100) }
        let origin = CGPoint.zero
        var present = Set<String>()
        @@TILES@@
    }
    @@REMOVE@@
}

var passed = 0
var failed = 0
func check(_ value: @autoclosure () -> Bool, _ label: String) {
    if value() {
        passed += 1
        print("PASS \(label)")
    } else {
        failed += 1
        print("FAIL \(label)")
    }
}

for count in 1...10 {
    let masks = count <= 5 ? Array(0..<(1 << count)) : [0, 1, 2, 1 << (count - 1), (1 << count) - 1, 0b0101010101]
    for mask in masks {
        for removed in 0..<count {
            let id = BlockID.generate()
            let ids = (0..<count).map { "media-\($0)" }
            let flags = (0..<count).map { mask & (1 << $0) != 0 }
            let group = MediaGroupBlock(id: id, kind: .collage, mediaIDs: ids, caption: [TextRun(text: "Caption")], spoilers: flags)
            let view = DocumentCanvasView(group)
            view.selectedCollageTile = (id, removed)
            view.removeCollageTile(group: id, index: removed)
            let name = "count=\(count) mask=\(mask) remove=\(removed)"
            check(view.edits == 1 && view.needsLayout && view.selectedCollageTile == nil, name + " one edit and layout")
            check(view.snapshot == [group], name + " pre-edit model captured without mutation")
            if count == 1 {
                check(view.boxes.isEmpty, name + " last tile removes block")
            } else {
                var remaining = ids
                remaining.remove(at: removed)
                var remainingFlags = flags
                remainingFlags.remove(at: removed)
                let box = view.boxes[0] as! MediaGroupBlockBox
                check(box.mediaIDs == remaining, name + " media order")
                check(box.spoilers == remainingFlags, name + " parallel flags")
                let roundTrip = box.model()
                check(roundTrip.mediaIDs == remaining && roundTrip.spoilers == remainingFlags, name + " persistence normalization preserves identity")
                check(roundTrip.id == id && roundTrip.kind == group.kind && roundTrip.caption == group.caption, name + " unchanged block identity kind caption")
            }
        }
    }
}
for supplied in [[Bool](), [true], [false, true, false, true]] {
    let group = MediaGroupBlock(id: .generate(), kind: .slideshow, mediaIDs: ["a", "b", "c"], spoilers: supplied)
    let view = DocumentCanvasView(group)
    var expected = group.spoilers
    expected.remove(at: 0)
    view.removeCollageTile(group: group.id, index: 0)
    check((view.boxes[0] as! MediaGroupBlockBox).model().spoilers == expected, "normalized input flags \(supplied)")
}
let group = MediaGroupBlock(id: .generate(), mediaIDs: ["a", "b", "c"], spoilers: [false, true, false])
for index in [-1, 3, 100] {
    let view = DocumentCanvasView(group)
    view.removeCollageTile(group: group.id, index: index)
    check(view.edits == 0 && !view.needsLayout && (view.boxes[0] as! MediaGroupBlockBox).model() == group, "invalid index \(index) no-op")
}
let missing = DocumentCanvasView(group)
missing.removeCollageTile(group: .generate(), index: 0)
check(missing.edits == 0, "unknown group no-op")
let other = OtherBox()
missing.boxes = [other]
missing.removeCollageTile(group: other.id, index: 0)
check(missing.edits == 0 && missing.boxes.count == 1, "non-media box no-op")
let cached = DocumentCanvasView(group)
let cachedBox = cached.boxes[0] as! MediaGroupBlockBox
cached.syncTiles(cachedBox)
let initialFirst = cached.mediaGroupTileViews["\(group.id.rawValue)#0"]!.view
cached.syncTiles(cachedBox)
check(cached.mediaGroupTileViews["\(group.id.rawValue)#0"]!.view === initialFirst, "unchanged tile remains pooled")
cached.removeCollageTile(group: group.id, index: 0)
cached.syncTiles(cachedBox)
let changedFirst = cached.mediaGroupTileViews["\(group.id.rawValue)#0"]!.view as! TileView
check(changedFirst.mediaID == "b" && changedFirst.spoiler, "same-size tile refreshes identity and spoiler after deletion")
check(changedFirst !== initialFirst && initialFirst.superview == nil, "stale tile detached")
cachedBox.spoilers[0] = false
cached.syncTiles(cachedBox)
let unspoiled = cached.mediaGroupTileViews["\(group.id.rawValue)#0"]!.view as! TileView
check(!unspoiled.spoiler && unspoiled !== changedFirst, "same-size spoiler restore refreshes cached view")
cachedBox.mediaIDs = group.mediaIDs
cachedBox.spoilers = group.spoilers
cached.syncTiles(cachedBox)
let restoredFirst = cached.mediaGroupTileViews["\(group.id.rawValue)#0"]!.view as! TileView
check(restoredFirst.mediaID == "a" && !restoredFirst.spoiler, "restored model rebinds unchanged-size cached tile")
print("SUMMARY \(passed) passed \(failed) failed")
exit(failed == 0 ? 0 : 1)
