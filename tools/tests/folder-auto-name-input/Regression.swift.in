import Foundation

struct Updated_ChatTextInputState: Equatable {
    var inputText: NSAttributedString
    var selectionRange: Range<Int>
}

enum FilterType: CaseIterable {
    case generic, unmuted, unread, channels, groups, bots, contacts, nonContacts
}

struct ChatListFilter: Equatable {
    var title: String
    var entities: [String]
    var enableAnimations: Bool
    var type: FilterType
    var includePeers: [Int]
    var color: Int?
    func withUpdatedTitle(string: String, entities: [String], enableAnimations: Bool) -> ChatListFilter {
        var value = self
        value.title = string
        value.entities = entities
        value.enableAnimations = enableAnimations
        return value
    }
}

struct State: Equatable {
    var filter: ChatListFilter
    var inputState: Updated_ChatTextInputState
    var changedName: Bool
    var nameAnimation: Bool
}

final class StateValue {
    var state: State
    var changes = 0
    init(_ state: State) { self.state = state }
    func with<T>(_ f: (State) -> T) -> T { f(state) }
}

struct Environment {
    func titleInputState(_ filter: ChatListFilter) -> Updated_ChatTextInputState {
        Updated_ChatTextInputState(inputText: NSAttributedString(string: filter.title), selectionRange: filter.title.utf16.count..<filter.title.utf16.count)
    }
}

struct LocalizedStrings {
    var chatListFilterTilteDefaultUnmuted = "Не выключенные"
    var chatListFilterTilteDefaultUnread = "Непрочитанные"
    var chatListFilterTilteDefaultChannels = "Каналы"
    var chatListFilterTilteDefaultGroups = "Группы"
    var chatListFilterTilteDefaultBots = "Боты"
    var chatListFilterTilteDefaultContacts = "Контакты"
    var chatListFilterTilteDefaultNonContacts = "Другие"
}
func strings() -> LocalizedStrings { LocalizedStrings() }
func chatListFilterType(_ filter: ChatListFilter) -> FilterType { filter.type }
final class Controller {
    var afterTransaction: ((Controller) -> Void)?
}

func makeController(_ stateValue: StateValue) -> Controller {
    let controller = Controller()
    let environment = Environment()
    let updateState: ((State) -> State) -> Void = { transform in
        let previous = stateValue.state
        stateValue.state = transform(previous)
        if previous != stateValue.state { stateValue.changes += 1 }
    }
    @@AFTER_TRANSACTION@@
    return controller
}

var passed = 0
var failed = 0
func check(_ value: @autoclosure () -> Bool, _ label: String) {
    if value() {
        passed += 1
        print("PASS \(label)")
    } else {
        failed += 1
        print("FAIL \(label)")
    }
}
let names: [FilterType: String] = [.unmuted: "Не выключенные", .unread: "Непрочитанные", .channels: "Каналы", .groups: "Группы", .bots: "Боты", .contacts: "Контакты", .nonContacts: "Другие"]
for animated in [false, true] {
    for (type, expected) in names {
        let filter = ChatListFilter(title: "", entities: [], enableAnimations: animated, type: type, includePeers: [42], color: 3)
        let state = StateValue(State(filter: filter, inputState: .init(inputText: NSAttributedString(string: ""), selectionRange: 0..<0), changedName: false, nameAnimation: animated))
        let controller = makeController(state)
        controller.afterTransaction?(controller)
        check(state.state.filter.title == expected, "\(type) model title")
        check(state.state.inputState.inputText.string == expected, "\(type) displayed title")
        check(state.state.inputState.selectionRange == expected.utf16.count..<expected.utf16.count, "\(type) cursor is valid")
        check(!state.state.inputState.inputText.string.isEmpty, "\(type) validation sees title")
        check(!state.state.changedName, "\(type) automatic name remains automatic")
        check(state.state.filter.enableAnimations == animated, "\(type) animation preference preserved")
        check(state.state.filter.includePeers == [42] && state.state.filter.color == 3, "\(type) other filter data preserved")
        let changeCount = state.changes
        controller.afterTransaction?(controller)
        check(state.changes == changeCount, "\(type) repeated transaction stabilizes")
        state.state.filter.type = .groups
        controller.afterTransaction?(controller)
        check(state.state.filter.title == "Группы" && state.state.inputState.inputText.string == "Группы", "\(type) category change updates both")
        state.state.changedName = true
        state.state.filter.title = "Моя папка 🦊"
        state.state.filter.entities = ["custom-emoji"]
        state.state.inputState = .init(inputText: NSAttributedString(string: "Моя папка 🦊"), selectionRange: 2..<2)
        let manual = state.state
        controller.afterTransaction?(controller)
        check(state.state == manual, "\(type) manual name entities cursor preserved")
        state.state.inputState = .init(inputText: NSAttributedString(string: ""), selectionRange: 0..<0)
        state.state.filter.title = ""
        let cleared = state.state
        controller.afterTransaction?(controller)
        check(state.state == cleared, "\(type) manually cleared name not regenerated")
    }
}
let generic = StateValue(State(filter: .init(title: "", entities: [], enableAnimations: true, type: .generic, includePeers: [], color: nil), inputState: .init(inputText: NSAttributedString(string: ""), selectionRange: 0..<0), changedName: false, nameAnimation: true))
let genericController = makeController(generic)
genericController.afterTransaction?(genericController)
check(generic.changes == 0 && generic.state.inputState.inputText.string.isEmpty, "generic new folder stays empty")
print("SUMMARY \(passed) passed \(failed) failed")
exit(failed == 0 ? 0 : 1)
