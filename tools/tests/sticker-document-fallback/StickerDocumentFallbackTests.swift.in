__FLAGS__

enum TelegramMediaFileAttribute: Equatable {
__ATTRIBUTES__
}

protocol Media {}
class MediaResource {}
struct TelegramMediaImageRepresentation {
    let resource: MediaResource
}

final class TelegramMediaFile: Media {
    let fileId: MediaId
    let mimeType: String
    let size: Int64?
    let attributes: [TelegramMediaFileAttribute]
    let resource = MediaResource()
    let previewRepresentations: [TelegramMediaImageRepresentation]

    init(mimeType: String, size: Int64?, attributes: [TelegramMediaFileAttribute], namespace: Int32 = Namespaces.Media.CloudFile, thumbnail: Bool = true) {
        self.fileId = MediaId(namespace: namespace, id: 1)
        self.mimeType = mimeType
        self.size = size
        self.attributes = attributes
        self.previewRepresentations = thumbnail ? [.init(resource: MediaResource())] : []
    }

__CORE_PROPERTIES__
__DIMENSIONS__
__EMOJI_PREDICATE__
}

__DIMENSIONS_FUNCTION__
__HELPER__

extension Media {
__WEBM__
__PROBABLY_STICKER__
}

extension CGSize {
__GEOMETRY__
}

extension NSImage {
__IMAGE_ACCESSOR__
}

struct PeerId {
    let namespace: Int32
}
struct MessageId {
    let peerId: PeerId
}
struct Message {
    let anyMedia: Media?
    let id: MessageId
}

enum TranscribeState {
    case loading, revealed, collapsed
}
struct AdditionalData {
    let transribeState: TranscribeState? = nil
}
struct Entry {
    let additionalData = AdditionalData()
}
struct Interaction {
    let interactionContext = 0
}
enum RenderType {
    case bubble, list
}

class ChatRowItem {
    let message: Message?
    init(_ initialSize: CGSize, _ interaction: Interaction, _ context: Int, _ entry: Entry, theme: Int) {
        self.message = nil
    }
    init(message: Message?) {
        self.message = message
    }
__ROW_IS_STICKER__
}
class ChatMediaItem: ChatRowItem {}
class ChatGIFMediaItem: ChatRowItem {}
class ChatVoiceRowItem: ChatRowItem {}
class ChatVideoMessageItem: ChatRowItem {}
class ChatMusicRowItem: ChatRowItem {}
class ChatAnimatedStickerItem: ChatRowItem {}
class ChatFileMediaItem: ChatMediaItem {}
enum HTMLDocumentBubbles {
__HTML_ELIGIBILITY__
}
struct ChatHTMLDocumentRows {
    static func item(_ initialSize: CGSize, interaction: Interaction, entry: Entry, message: Message, theme: Int, fallback: () -> ChatRowItem) -> ChatRowItem {
        if let file = message.anyMedia as? TelegramMediaFile {
            precondition(!HTMLDocumentBubbles.isHTMLDocument(mimeType: file.mimeType, fileName: file.fileName, size: file.size))
        }
        return fallback()
    }
}

func rowForFile(_ file: TelegramMediaFile) -> ChatRowItem {
    let initialSize = CGSize(width: 400, height: 400)
    let interaction = Interaction()
    let entry = Entry()
    let theme = 0
    let message = Message(anyMedia: file, id: MessageId(peerId: PeerId(namespace: 0)))
__FACTORY__
}

func hasBubble(_ file: TelegramMediaFile) -> Bool {
    let media: Media = file
    let entry = Entry()
__BUBBLE__
    return true
}

func stateOverlay(_ file: TelegramMediaFile, renderType: RenderType) -> Bool {
    let media: Media = file
    let object = Entry()
__OVERLAY__
    return false
}

func canAddCaption(_ file: TelegramMediaFile) -> Bool {
    let media: Media = file
__CAPTION__
    return canAddCaption
}

