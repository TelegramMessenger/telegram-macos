import Foundation

struct TableSelection {
    enum Kind { case rows(ClosedRange<Int>); case columns(ClosedRange<Int>) }
    let table: BlockID
    let kind: Kind
}
struct TableBox {
    let table: TableBlock
    var id: BlockID { table.id }
    func currentBlock() -> Block { .table(table) }
}
extension ClosedRange where Bound == Int {
    func clamped(to other: ClosedRange<Int>) -> ClosedRange<Int> {
        max(lowerBound, other.lowerBound)...min(upperBound, other.upperBound)
    }
}
final class DocumentCanvasView {
    let table: TableBlock
    var tableSelection: TableSelection?
    init(_ table: TableBlock) { self.table = table }
    func activeTable() -> (box: TableBox, index: Int, row: Int, col: Int)? {
        (TableBox(table: table), 0, 0, 0)
    }
@@STRUCTURAL@@
@@REID@@
    static func paste(_ fragment: [Block]) -> [Block] {
@@PASTE@@
        return blocks
    }
}

var passed = 0
var failed = 0
func expect(_ condition: @autoclosure () -> Bool, _ name: String) {
    if condition() { passed += 1; print("PASS " + name) }
    else { failed += 1; print("FAIL " + name) }
}
func asTable(_ block: Block) -> TableBlock {
    guard case let .table(table) = block else { fatalError("Expected table") }
    return table
}
func identities(_ table: TableBlock) -> [BlockID] {
    [table.id] + table.rows.flatMap { row in
        [row.id] + row.cells.flatMap { cell in [cell.id] + cell.blocks.map(\.id) }
    }
}
func restoredIdentities(_ copy: TableBlock, from original: TableBlock) -> TableBlock {
    var copy = copy
    copy.id = original.id
    for r in copy.rows.indices {
        copy.rows[r].id = original.rows[r].id
        for c in copy.rows[r].cells.indices {
            copy.rows[r].cells[c].id = original.rows[r].cells[c].id
            for b in copy.rows[r].cells[c].blocks.indices {
                guard case var .paragraph(paragraph) = copy.rows[r].cells[c].blocks[b] else { fatalError("Expected paragraph") }
                paragraph.id = original.rows[r].cells[c].blocks[b].id
                copy.rows[r].cells[c].blocks[b] = .paragraph(paragraph)
            }
        }
    }
    return copy
}
func checkCopy(_ original: TableBlock, _ copy: TableBlock, _ name: String) {
    expect(copy.columns == original.columns && copy.compact == original.compact && copy.bordered == original.bordered, name + " table settings")
    expect(copy.rowCount == original.rowCount && zip(copy.rows, original.rows).allSatisfy { $0.cells.count == $1.cells.count }, name + " dimensions")
    expect(Set(identities(copy)).isDisjoint(with: Set(identities(original))), name + " all identities fresh")
    expect(Set(identities(copy)).count == identities(copy).count, name + " all identities unique")
    expect(restoredIdentities(copy, from: original) == original, name + " all nonidentity fields preserved")
}
func makeCell(_ id: String, alignment: TextAlignment, vertical: VerticalAlignment, header: Bool, colspan: Int = 1, rowspan: Int = 1) -> Cell {
    let paragraph = ParagraphBlock(id: BlockID(id + "-p"), style: .heading3, paragraph: .init(alignment: .right, headIndent: 7), runs: [TextRun(text: id, attributes: .init(bold: true, underline: true, link: "https://example.com"))])
    return Cell(id: BlockID(id), blocks: [.paragraph(paragraph)], background: .init(red: 0.1, green: 0.2, blue: 0.3, alpha: 0.4), horizontalAlignment: alignment, verticalAlignment: vertical, isHeader: header, colspan: colspan, rowspan: rowspan)
}
let original = TableBlock(id: BlockID("table"), columns: [.init(width: 70), .init(width: 130)], rows: [
    Row(id: BlockID("r0"), height: 85, cells: [makeCell("a", alignment: .left, vertical: .bottom, header: true), makeCell("b", alignment: .right, vertical: .middle, header: false)]),
    Row(id: BlockID("r1"), height: 92, cells: [makeCell("c", alignment: .justified, vertical: .top, header: false), makeCell("d", alignment: .natural, vertical: .bottom, header: true)])
], compact: true, bordered: false)
let snapshot = original
let pasted = asTable(DocumentCanvasView.paste([.table(original)])[0])
checkCopy(original, pasted, "whole table paste")
expect(original == snapshot, "original unchanged")
expect(pasted.rows[0].cells[0].horizontalAlignment == .left, "left alignment survives")
expect(pasted.rows[0].cells[1].horizontalAlignment == .right, "right alignment survives")
expect(pasted.rows[0].cells[0].verticalAlignment == .bottom, "bottom alignment survives")
expect(pasted.rows[0].cells[1].verticalAlignment == .middle, "middle alignment survives")
expect(pasted.rows[0].cells[0].isHeader && !pasted.rows[0].cells[1].isHeader && !pasted.rows[0].isHeader, "mixed cell headers survive")
let twice = asTable(DocumentCanvasView.paste([.table(original)])[0])
checkCopy(original, twice, "repeated paste")
expect(Set(identities(twice)).isDisjoint(with: Set(identities(pasted))), "repeated paste does not collide")
let canvas = DocumentCanvasView(original)
canvas.tableSelection = TableSelection(table: original.id, kind: .rows(0...0))
let rowFragment = asTable(canvas.structuralTableFragment()!)
let rowExpected = TableBlock(id: original.id, columns: original.columns, rows: [original.rows[0]], compact: original.compact, bordered: original.bordered)
checkCopy(rowExpected, rowFragment, "row copy")
checkCopy(rowFragment, asTable(DocumentCanvasView.paste([.table(rowFragment)])[0]), "row fragment paste")
canvas.tableSelection = TableSelection(table: original.id, kind: .columns(1...1))
let columnFragment = asTable(canvas.structuralTableFragment()!)
let columnExpected = TableBlock(id: original.id, columns: [original.columns[1]], rows: original.rows.map { Row(id: $0.id, height: $0.height, cells: [$0.cells[1]]) }, compact: original.compact, bordered: original.bordered)
checkCopy(columnExpected, columnFragment, "column copy")
checkCopy(columnFragment, asTable(DocumentCanvasView.paste([.table(columnFragment)])[0]), "column fragment paste")
let merged = TableBlock(id: BlockID("merged"), columns: [.init(width: 50), .init(width: 60)], rows: [Row(id: BlockID("m0"), cells: [makeCell("span", alignment: .right, vertical: .bottom, header: true, colspan: 2, rowspan: 2)]), Row(id: BlockID("m1"), cells: [])])
let mergedPaste = asTable(DocumentCanvasView.paste([.table(merged)])[0])
checkCopy(merged, mergedPaste, "merged table paste")
expect(mergedPaste.rows[0].cells[0].colspan == 2, "column span survives")
expect(mergedPaste.rows[0].cells[0].rowspan == 2, "row span survives")
for horizontal in TextAlignment.allCases {
    for vertical in VerticalAlignment.allCases {
        let table = TableBlock(id: BlockID.generate(), columns: [.init(width: 100)], rows: [Row(id: BlockID.generate(), cells: [makeCell("matrix", alignment: horizontal, vertical: vertical, header: false)])])
        let copy = asTable(DocumentCanvasView.paste([.table(table)])[0])
        expect(copy.rows[0].cells[0].horizontalAlignment == horizontal && copy.rows[0].cells[0].verticalAlignment == vertical, "alignment matrix \(horizontal.rawValue) \(vertical.rawValue)")
    }
}
let plain = TableBlock(id: BlockID.generate(), columns: [.init(width: 100)], rows: [Row(id: BlockID.generate(), cells: [Cell(id: BlockID.generate())])])
checkCopy(plain, asTable(DocumentCanvasView.paste([.table(plain)])[0]), "default empty cell")
let encoded = try JSONEncoder().encode(pasted)
let decoded = try JSONDecoder().decode(TableBlock.self, from: encoded)
expect(decoded == pasted, "real table model codec retains pasted fields")
print("RESULT \(passed) passed \(failed) failed")
exit(failed == 0 ? 0 : 1)
