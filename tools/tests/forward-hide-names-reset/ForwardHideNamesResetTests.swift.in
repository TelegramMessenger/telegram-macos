import Foundation

struct MessageId: Codable, Hashable {
    let peerId: Int64
    let namespace: Int32
    let id: Int32
}

enum EngineMessage {
    typealias Id = MessageId
}

extension MessageId {
    static func encodeArrayToData(_ ids: [MessageId]) -> Data {
        return try! JSONEncoder().encode(ids)
    }
    static func decodeArrayFromData(_ data: Data) -> [MessageId] {
        return (try? JSONDecoder().decode([MessageId].self, from: data)) ?? []
    }
}

extension Array where Element: Hashable {
    var uniqueElements: [Element] {
        var seen = Set<Element>()
        return self.filter { seen.insert($0).inserted }
    }
}

final class Message {
    let id: MessageId
    init(id: MessageId) {
        self.id = id
    }
}

struct StringCodingKey: CodingKey, ExpressibleByStringLiteral {
    let stringValue: String
    var intValue: Int? {
        return nil
    }
    init?(stringValue: String) {
        self.stringValue = stringValue
    }
    init?(intValue: Int) {
        return nil
    }
    init(stringLiteral value: String) {
        self.stringValue = value
    }
}

struct ChatTextInputState: Codable, Equatable {
    var inputText: String
    init() {
        self.inputText = ""
    }
    init(inputText: String) {
        self.inputText = inputText
    }
}

struct EngineMessageReplySubject: Codable, Equatable {
    let messageId: MessageId
}

struct ChatInterfaceMessageActionsState: Codable, Equatable {
    var closedButtonKeyboardMessageId: MessageId?
    var isEmpty: Bool {
        return self.closedButtonKeyboardMessageId == nil
    }
    init() {
        self.closedButtonKeyboardMessageId = nil
    }
    init(closedButtonKeyboardMessageId: MessageId?) {
        self.closedButtonKeyboardMessageId = closedButtonKeyboardMessageId
    }
}

struct ChatInterfaceHistoryScrollState: Codable, Equatable {
    let relativeOffset: Double
}

struct ChatEditState {
    let message: Message
    var inputState: ChatTextInputState?
    init(message: Message) {
        self.message = message
        self.inputState = nil
    }
    func withUpdated(state: ChatTextInputState) -> ChatEditState {
        var result = self
        result.inputState = state
        return result
    }
}

struct EffectRect: Codable, Equatable {
    let x: Double
}

struct ChatInterfaceMessageEffect: Codable, Equatable {
    var effect: Int64
    var fromRect: EffectRect?
    init(effect: Int64, fromRect: EffectRect?) {
        self.effect = effect
        self.fromRect = fromRect
    }
}

struct ChatInterfaceState: Codable {
    struct ChannelSuggestPost: Equatable {
        var tag: Int
    }

    __PROPERTIES__

    __ENCODE__

    __EMPTY_INIT__

    __INIT__

    __DECODE__

    __METHODS__
}

struct Presentation {
    let interfaceState: ChatInterfaceState
}

func dismissForward(_ state: ChatInterfaceState) -> ChatInterfaceState {
    return state__DISMISS__
}

func forwardToAnotherChat(_ state: ChatInterfaceState) -> ChatInterfaceState {
    return state__ANOTHER__
}

func setHideSendersName(_ hide: Bool, _ state: ChatInterfaceState) -> ChatInterfaceState {
    return state__HIDE_NAMES__
}

func setHideCaption(_ hide: Bool, _ current: ChatInterfaceState) -> ChatInterfaceState {
    __HIDE_CAPTION__
}

func afterSent(_ value: ChatInterfaceState) -> ChatInterfaceState {
    var value = value
    __AFTER_SENT__
    return value
}

func sendOptions(_ presentation: Presentation) -> (Bool, Bool) {
    __SEND_OPTIONS__
    return (hideNames, hideCaptions)
}

func forward(_ state: ChatInterfaceState, _ ids: [MessageId]) -> ChatInterfaceState {
    return state.withUpdatedForwardMessageIds(ids).withUpdatedForwardMessages(ids.map { Message(id: $0) })
}

func stored(_ state: ChatInterfaceState) -> [String: Any] {
    let data = try! JSONEncoder().encode(state)
    return try! JSONSerialization.jsonObject(with: data) as! [String: Any]
}

func relaunched(_ state: ChatInterfaceState) -> ChatInterfaceState {
    let data = try! JSONEncoder().encode(state)
    return try! JSONDecoder().decode(ChatInterfaceState.self, from: data)
}

var passed = 0
var failures = 0

func check(_ name: String, _ condition: Bool) {
    if condition {
        passed += 1
    } else {
        failures += 1
        print("FAILED: \(name)")
    }
}

func checkClean(_ name: String, _ state: ChatInterfaceState) {
    check("\(name): the forward shows the sender's name", !state.hideSendersName)
    check("\(name): the forward keeps captions", !state.hideCaptions)
    check("\(name): no remembered name choice", state.tempSenderName == nil)
    let options = sendOptions(Presentation(interfaceState: state))
    check("\(name): Send passes hideNames false", options.0 == false)
    check("\(name): Send passes hideCaptions false", options.1 == false)
}

let a = MessageId(peerId: 1, namespace: 0, id: 10)
let b = MessageId(peerId: 1, namespace: 0, id: 20)
let c = MessageId(peerId: 2, namespace: 0, id: 30)

let fresh = forward(ChatInterfaceState(), [a])
checkClean("a fresh forward", fresh)

let namesHidden = setHideSendersName(true, fresh)
check("Hide Sender's Name hides the name on the pending forward", namesHidden.hideSendersName)
check("Hide Sender's Name is passed to Send", sendOptions(Presentation(interfaceState: namesHidden)).0)

let captionsHidden = setHideCaption(true, fresh)
check("Hide Captions hides captions on the pending forward", captionsHidden.hideCaptions)
check("Hide Captions also hides the name when it wasn't chosen", captionsHidden.hideSendersName)

let bothHidden = setHideCaption(true, setHideSendersName(true, fresh))
check("both chosen: names hidden", bothHidden.hideSendersName)
check("both chosen: captions hidden", bothHidden.hideCaptions)

let cases: [(String, ChatInterfaceState)] = [
    ("Hide Sender's Name", namesHidden),
    ("Hide Captions", captionsHidden),
    ("Hide Sender's Name and Hide Captions", bothHidden),
]

for (name, hidden) in cases {
    let dismissed = dismissForward(hidden)
    check("\(name), X: the forward is gone", dismissed.forwardMessageIds.isEmpty)
    checkClean("\(name), X, then a new forward", forward(dismissed, [b]))
    checkClean("\(name), X, then a forward of the same message", forward(dismissed, [a]))

    let another = forwardToAnotherChat(hidden)
    check("\(name), Forward to Another Chat: the forward is gone here", another.forwardMessageIds.isEmpty)
    checkClean("\(name), Forward to Another Chat, then a new forward here", forward(another, [b]))

    let saved = stored(dismissed)
    check("\(name), X: the saved state has f.sn false", (saved["f.sn"] as? Bool) == false)
    check("\(name), X: the saved state has f.hc false", (saved["f.hc"] as? Bool) == false)
    checkClean("\(name), X, relaunch, then a new forward", forward(relaunched(dismissed), [b]))

    let pending = relaunched(hidden)
    check("\(name), relaunch with the forward pending: ids kept", pending.forwardMessageIds == [a])
    check("\(name), relaunch with the forward pending: names option kept", pending.hideSendersName == hidden.hideSendersName)
    check("\(name), relaunch with the forward pending: captions option kept", pending.hideCaptions == hidden.hideCaptions)

    let replaced = forward(hidden, [b, c])
    check("\(name), a forward over the pending one keeps its names option, as before", replaced.hideSendersName == hidden.hideSendersName)
    check("\(name), a forward over the pending one keeps its captions option, as before", replaced.hideCaptions == hidden.hideCaptions)

    let sent = afterSent(hidden)
    check("\(name), Send: the forward is gone", sent.forwardMessageIds.isEmpty)
    check("\(name), Send: names option cleared", !sent.hideSendersName)
    check("\(name), Send: captions option cleared", !sent.hideCaptions)
    checkClean("\(name), Send, then a new forward", forward(sent, [b]))
    checkClean("\(name), Send, relaunch, then a new forward", forward(relaunched(sent), [b]))
}

let freshCaptions = setHideCaption(true, fresh)
for (name, choice) in [("Show Sender's Name", false), ("Hide Sender's Name", true)] {
    let chosen = setHideSendersName(choice, fresh)
    check("\(name) is remembered while the forward is pending", chosen.tempSenderName == choice)
    let next = setHideCaption(true, forward(dismissForward(chosen), [b]))
    check("\(name), X, new forward, Hide Captions: the name follows as on a fresh forward", next.hideSendersName == freshCaptions.hideSendersName)
    let afterSend = setHideCaption(true, forward(afterSent(chosen), [b]))
    check("\(name), Send, new forward, Hide Captions: the name follows as on a fresh forward", afterSend.hideSendersName == freshCaptions.hideSendersName)
}

for (name, names, captions) in [("names", true, false), ("captions", false, true), ("names and captions", true, true)] {
    let leftover = ChatInterfaceState(timestamp: 5, inputState: ChatTextInputState(), replyMessageId: nil, replyMessage: nil, forwardMessageIds: [], messageActionsState: ChatInterfaceMessageActionsState(), dismissedPinnedMessageId: [], composeDisableUrlPreview: nil, historyScrollState: nil, dismissedForceReplyId: nil, editState: nil, forwardMessages: [], hideSendersName: names, themeEditing: false, hideCaptions: captions, revealedSpoilers: [], tempSenderName: nil, linkBelowMessage: true, largeMedia: nil, messageEffect: nil, suggestPost: nil)
    let saved = stored(leftover)
    check("an older build's leftover (\(name) hidden, no forward) is what gets saved", (saved["f.sn"] as? Bool) == names && (saved["f.hc"] as? Bool) == captions)
    checkClean("an older build's leftover (\(name) hidden, no forward), relaunch, then a new forward", forward(relaunched(leftover), [b]))
}

check("X with no options chosen leaves the options off", {
    let dismissed = dismissForward(fresh)
    return !dismissed.hideSendersName && !dismissed.hideCaptions && dismissed.tempSenderName == nil
}())

let editMessage = Message(id: c)
let busy = ChatInterfaceState(
    timestamp: 77,
    inputState: ChatTextInputState(inputText: "draft"),
    replyMessageId: EngineMessageReplySubject(messageId: c),
    replyMessage: Message(id: c),
    forwardMessageIds: [a],
    messageActionsState: ChatInterfaceMessageActionsState(closedButtonKeyboardMessageId: b),
    dismissedPinnedMessageId: [b],
    composeDisableUrlPreview: "https://example.com",
    historyScrollState: ChatInterfaceHistoryScrollState(relativeOffset: 12.5),
    dismissedForceReplyId: b,
    editState: ChatEditState(message: editMessage),
    forwardMessages: [Message(id: a)],
    hideSendersName: true,
    themeEditing: true,
    hideCaptions: true,
    revealedSpoilers: [a],
    tempSenderName: true,
    linkBelowMessage: false,
    largeMedia: true,
    messageEffect: ChatInterfaceMessageEffect(effect: 5, fromRect: EffectRect(x: 1)),
    suggestPost: ChatInterfaceState.ChannelSuggestPost(tag: 9)
)
let dismissedBusy = dismissForward(busy)
check("X keeps the timestamp", dismissedBusy.timestamp == busy.timestamp)
check("X keeps the typed text", dismissedBusy.inputState == busy.inputState)
check("X keeps the reply", dismissedBusy.replyMessageId == busy.replyMessageId && dismissedBusy.replyMessage?.id == c)
check("X keeps the keyboard state", dismissedBusy.messageActionsState == busy.messageActionsState)
check("X keeps dismissed pins", dismissedBusy.dismissedPinnedMessageId == busy.dismissedPinnedMessageId)
check("X keeps the link preview choice", dismissedBusy.composeDisableUrlPreview == busy.composeDisableUrlPreview)
check("X keeps the scroll position", dismissedBusy.historyScrollState == busy.historyScrollState)
check("X keeps the dismissed force reply", dismissedBusy.dismissedForceReplyId == busy.dismissedForceReplyId)
check("X keeps the edit", dismissedBusy.editState?.message === editMessage)
check("X keeps theme editing", dismissedBusy.themeEditing == busy.themeEditing)
check("X keeps revealed spoilers", dismissedBusy.revealedSpoilers == busy.revealedSpoilers)
check("X keeps the link position", dismissedBusy.linkBelowMessage == busy.linkBelowMessage)
check("X keeps the media size", dismissedBusy.largeMedia == busy.largeMedia)
check("X keeps the message effect", dismissedBusy.messageEffect == busy.messageEffect)
check("X keeps the suggested post", dismissedBusy.suggestPost == busy.suggestPost)
check("X clears the forward ids", dismissedBusy.forwardMessageIds.isEmpty)
checkClean("a busy composer, X, then a new forward", forward(dismissedBusy, [b]))

print("\(passed) passed, \(failures) failed")
exit(failures == 0 ? 0 : 1)
