    var isPremiumEmoji: Bool { return false }
}

struct ItemCollectionId: Codable, Hashable {}

struct MediaId: Hashable {
    let namespace: Int32
    let id: Int64
}

enum Namespaces {
    enum Media {
        static let CloudFile: Int32 = 0
    }
    enum Peer {
        static let CloudUser: Int32 = 0
    }
}

struct PeerId: Hashable {
    struct Id: Hashable {
        let value: Int64
        static func _internalFromInt64Value(_ value: Int64) -> Id { return Id(value: value) }
        func _internalGetInt64Value() -> Int64 { return self.value }
    }
    let namespace: Int32
    let id: Id
}

struct StickerPackReference: Equatable {}

enum MessageTextEntityType: Equatable {
    enum DateTimeFormat: Equatable {
        enum TimeFormat: Equatable { case short }
        enum DateFormat: Equatable { case short }
        case relative
        case full(timeFormat: TimeFormat?, dateFormat: DateFormat?, dayOfWeek: Bool)
    }
    case Unknown
    case Mention
    case Hashtag
    case BotCommand
    case Url
    case Email
    case Bold
    case Italic
    case Code
    case Pre(language: String?)
    case TextUrl(url: String)
    case TextMention(peerId: PeerId)
    case PhoneNumber
    case Strikethrough
    case BlockQuote(isCollapsed: Bool)
    case Underline
    case BankCard
    case Spoiler
    case CustomEmoji(stickerPack: StickerPackReference?, fileId: Int64)
    case FormattedDate(format: DateTimeFormat, date: Int32)
}

struct MessageTextEntity: Equatable {
    let range: Range<Int>
    let type: MessageTextEntityType
}

struct TextEntitiesMessageAttribute {
    let entities: [MessageTextEntity]
}

