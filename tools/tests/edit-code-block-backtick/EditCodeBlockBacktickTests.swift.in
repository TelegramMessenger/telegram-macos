        self.collectionId = collectionId
        self.fileId = fileId
        self.file = file
        self.emoji = emoji
    }
}

protocol EmbeddedCustomEmojiAttributeValue {
    var customEmojiAttribute: TextInputTextCustomEmojiAttribute? { get }
}

