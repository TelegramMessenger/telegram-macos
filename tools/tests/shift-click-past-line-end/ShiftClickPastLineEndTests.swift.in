    var frame: NSRect
    let range: NSRange

    init(line: CTLine, frame: NSRect, range: NSRange) {
        self.line = line
        self.frame = frame
        self.range = range
    }
}

final class TextViewLayout {
    var attributedString: NSAttributedString
    var lines: [TextViewLine] = []
    var selectedRange = TextSelectedRange()
    let interactions = TextViewInteractions()
    var mayItems = true

    init(_ attributedString: NSAttributedString) {
        self.attributedString = attributedString
    }

    var string: String {
        return attributedString.string
    }

__FIND_INDEX__

__FIND_CHARACTER_INDEX__
}

struct FoldingBlock {
    let text: TextViewLayout
}

final class FoldingTextLayout {
    let blocks: [FoldingBlock]

    init(_ texts: [TextViewLayout]) {
        self.blocks = texts.map { FoldingBlock(text: $0) }
    }

__MERGED__
}

