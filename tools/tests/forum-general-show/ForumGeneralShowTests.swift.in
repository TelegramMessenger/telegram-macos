    let peers = FakePeers(stored: topic)
    let screen = makeScreen(purpose: .edit(topic, 7), peers: peers)
    check("topic with a letter icon: no General switch", screen.generalRow == nil)
    check("topic with a letter icon: Done is enabled, as before", screen.doneEnabled)
    screen.done()
    check("topic with a letter icon: Done sends the title without an icon, as before", peers.requests == ["edit Alpha icon nil"])
}

do {
    let peers = FakePeers(stored: general(hidden: false))
    let screen = makeScreen(purpose: .create, peers: peers)
    check("new topic: no General switch", screen.generalRow == nil)
    screen.rename("Gamma")
    check("new topic: Done is enabled", screen.doneEnabled)
    screen.done()
    check("new topic: Done creates the topic and sends no hidden state", peers.requests == ["create Gamma"])
}

let row = openGeneral(FakePeers(stored: general(hidden: false))).generalRow
check("the switch moves only when the page state changes (autoswitch off), so it never shows a value Done won't send", row?.data.autoswitch == false)
check("the row stays a checkbox for VoiceOver (no separate switch action)", row != nil && row?.data.switchAction == nil)
check("the page renders with the forum's Manage Topics right", __PERMISSION_WIRED__)

print("\(passed) passed, \(failures) failed")
exit(failures == 0 ? 0 : 1)
