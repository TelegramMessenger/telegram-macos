final class FakePeers {
    var stored: MessageHistoryThreadData
    var requests: [String] = []
    var failEdit = false

    init(stored: MessageHistoryThreadData) {
        self.stored = stored
    }

    func editForumChannelTopic(id: PeerId, threadId: Int64, title: String, iconFileId: Int64?) -> Signal<Never, EditForumChannelTopicError> {
        return Signal { subscriber in
            self.requests.append("edit \(title) icon \(iconFileId.map { String($0) } ?? "nil")")
            if self.failEdit || (title == self.stored.info.title && (threadId == 1 || iconFileId == self.stored.info.icon)) {
                subscriber.putError(.generic)
            } else {
                self.stored.info.title = title
                self.stored.info.icon = iconFileId
                subscriber.putCompletion()
            }
        }
    }

    func setForumChannelTopicHidden(id: PeerId, threadId: Int64, isHidden: Bool) -> Signal<Never, EditForumChannelTopicError> {
        return Signal { subscriber in
            guard threadId == 1 else {
                self.requests.append("hidden on topic \(threadId)")
                subscriber.putError(.generic)
                return
            }
            self.requests.append("hidden \(isHidden)")
            self.stored.isHidden = isHidden
            subscriber.putCompletion()
        }
    }

    func createForumChannelTopic(id: PeerId, title: String, iconColor: Int32, iconFileId: Int64?) -> Signal<Int64, CreateForumChannelTopicError> {
        return Signal { subscriber in
            self.requests.append("create \(title)")
            subscriber.putNext(42)
            subscriber.putCompletion()
        }
    }
}

