    case desc(sectionId: Int32, index: Int32, text: InputDataTextType, data: InputDataGeneralTextData)
    case custom(sectionId: Int32, index: Int32, value: InputDataValue, identifier: InputDataIdentifier, equatable: InputDataEquatable?, comparable: InputDataComparableIndex?, item: (NSSize, InputDataEntryId) -> TableRowItem)
    case general(sectionId: Int32, index: Int32, value: InputDataValue, error: InputDataValueError?, identifier: InputDataIdentifier, data: InputDataGeneralData)
}

enum InputDataValidationFailAction {
    case shake
}

enum InputDataFailResult {
    case none
    case alert(String)
    case fields([InputDataIdentifier: InputDataValidationFailAction])
    case doSomething(next: (@escaping (InputDataValidation) -> Void) -> Void)
}

enum InputDataValidation {
    case none
    case fail(InputDataFailResult)
}

enum InputDoneValue {
    case enabled(String)
    case disabled(String)
}

struct InputDataSignalValue {
    let entries: [InputDataEntry]

    init(entries: [InputDataEntry] = []) {
        self.entries = entries
    }
}

final class InputDataController {
    let updateDoneValue: ([InputDataIdentifier: InputDataValue]) -> ((InputDoneValue) -> Void) -> Void
    var validateData: ([InputDataIdentifier: InputDataValue]) -> InputDataValidation = { _ in .fail(.none) }
    var shakes = 0

    init(dataSignal: Signal<InputDataSignalValue, NoError>, title: String, updateDoneValue: @escaping ([InputDataIdentifier: InputDataValue]) -> ((InputDoneValue) -> Void) -> Void, hasDone: Bool, identifier: String) {
        self.updateDoneValue = updateDoneValue
    }

    func process(_ validation: InputDataValidation) {
        switch validation {
        case let .fail(.doSomething(next)):
            next { [weak self] in self?.process($0) }
        case let .fail(.fields(fields)):
            shakes += fields.count
        case let .fail(.alert(text)):
            alerts.append(text)
        default:
            break
        }
    }
}

