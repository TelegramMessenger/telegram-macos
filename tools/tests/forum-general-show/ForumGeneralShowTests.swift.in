struct NSRect: Equatable {}

protocol Disposable {
    func dispose()
}

final class EmptyDisposable: Disposable {
    func dispose() {}
}

enum NoError {}

final class Subscriber<T, E> {
    private var finished = false
    private let next: ((T) -> Void)?
    private let error: ((E) -> Void)?
    private let completed: (() -> Void)?

    init(next: ((T) -> Void)?, error: ((E) -> Void)?, completed: (() -> Void)?) {
        self.next = next
        self.error = error
        self.completed = completed
    }

    func putNext(_ value: T) {
        if !finished {
            next?(value)
        }
    }

    func putError(_ value: E) {
        if !finished {
            finished = true
            error?(value)
        }
    }

    func putCompletion() {
        if !finished {
            finished = true
            completed?()
        }
    }
}

final class Signal<T, E> {
    private let generator: (Subscriber<T, E>) -> Void

    init(_ generator: @escaping (Subscriber<T, E>) -> Void) {
        self.generator = generator
    }

    static func complete() -> Signal<T, E> {
        return Signal { $0.putCompletion() }
    }

    static func single(_ value: T) -> Signal<T, E> {
        return Signal {
            $0.putNext(value)
            $0.putCompletion()
        }
    }

    @discardableResult
    func start(next: ((T) -> Void)? = nil, error: ((E) -> Void)? = nil, completed: (() -> Void)? = nil) -> Disposable {
        generator(Subscriber(next: next, error: error, completed: completed))
        return EmptyDisposable()
    }
}

precedencegroup PipeRight {
    associativity: left
    higherThan: DefaultPrecedence
}

infix operator |> : PipeRight

func |> <T, U>(value: T, function: (T) -> U) -> U {
    return function(value)
}

func then<T, E>(_ nextSignal: Signal<T, E>) -> (Signal<T, E>) -> Signal<T, E> {
    return { signal in
        return Signal { subscriber in
            signal.start(next: { subscriber.putNext($0) }, error: { subscriber.putError($0) }, completed: {
                nextSignal.start(next: { subscriber.putNext($0) }, error: { subscriber.putError($0) }, completed: {
                    subscriber.putCompletion()
                })
            })
        }
    }
}

func take<T, E>(_ count: Int) -> (Signal<T, E>) -> Signal<T, E> {
    return { signal in
        return Signal { subscriber in
            var taken = 0
            signal.start(next: { value in
                if taken < count {
                    taken += 1
                    subscriber.putNext(value)
                    if taken == count {
                        subscriber.putCompletion()
                    }
                }
            }, error: { subscriber.putError($0) }, completed: { subscriber.putCompletion() })
        }
    }
}

final class Atomic<T> {
    private var value: T

    init(value: T) {
        self.value = value
    }

    func with<R>(_ f: (T) -> R) -> R {
        return f(value)
    }

    func modify(_ f: (T) -> T) -> T {
        value = f(value)
        return value
    }
}

