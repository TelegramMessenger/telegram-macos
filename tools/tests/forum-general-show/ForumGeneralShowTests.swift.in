    let peers = FakePeers(stored: topic)
    let screen = makeScreen(purpose: .edit(topic, 7), peers: peers)
    screen.rename("Beta")
    check("topic with an emoji icon renamed: Done is enabled", screen.doneEnabled)
    screen.done()
    check("topic with an emoji icon renamed: Done sends the title with the icon", peers.requests == ["edit Beta icon \(customIcon)"])
}

