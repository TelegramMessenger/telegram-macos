enum ForumUI {
    static func makeIconFile(title: String, iconColor: Int32 = 0, isGeneral: Bool = false) -> TelegramMediaFile {
        if isGeneral {
            return TelegramMediaFile(fileId: MediaId(namespace: 0, id: 523134), mimeType: "bundle/jpeg", resource: LocalBundleResource())
        }
        let letter = Int64(title.unicodeScalars.first?.value ?? 65)
        return TelegramMediaFile(fileId: MediaId(namespace: 1, id: 7_000_000 + letter * 100 + Int64(iconColor % 100)), mimeType: "bundle/topic", resource: ForumTopicIconResource(iconColor: iconColor))
    }

    static func randomTopicColor() -> Int32 {
        return 0x6FB9F0
    }

    static func openTopic(_ threadId: Int64, peerId: PeerId, context: FakeContext) -> Signal<Bool, NoError> {
        return .single(true)
    }
}

