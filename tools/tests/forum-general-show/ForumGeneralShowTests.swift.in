struct GeneralRow {
    let identifier: InputDataIdentifier
    let value: InputDataValue
    let data: InputDataGeneralData
}

final class Screen {
    let peers: FakePeers
    let navigation: FakeNavigation
    let render: () -> [InputDataEntry]
    let name: () -> String
    let rename: (String) -> Void
    let setIcon: (Int64) -> Void
    let controller: InputDataController

    init(peers: FakePeers, navigation: FakeNavigation, render: @escaping () -> [InputDataEntry], name: @escaping () -> String, rename: @escaping (String) -> Void, setIcon: @escaping (Int64) -> Void, controller: InputDataController) {
        self.peers = peers
        self.navigation = navigation
        self.render = render
        self.name = name
        self.rename = rename
        self.setIcon = setIcon
        self.controller = controller
    }

    var generalRow: GeneralRow? {
        for entry in render() {
            if case let .general(_, _, value, _, identifier, data) = entry, identifier == _id_hide_general {
                return GeneralRow(identifier: identifier, value: value, data: data)
            }
        }
        return nil
    }

    var switchShown: Bool? {
        if let row = generalRow, case let .switchable(value) = row.data.type {
            return value
        }
        return nil
    }

    var doneEnabled: Bool {
        var enabled = false
        controller.updateDoneValue([_id_name: .string(name())])({ value in
            if case .enabled = value {
                enabled = true
            }
        })
        return enabled
    }

    func select(_ identifier: InputDataIdentifier, _ value: InputDataValue) {
        controller.process(controller.validateData([identifier: value]))
    }

    var switchEnabled: Bool {
        return generalRow?.data.enabled ?? false
    }

    func rowItemAction() {
        guard let row = generalRow else {
            return
        }
        if let action = row.data.action {
            action()
        } else {
            select(row.identifier, row.value)
        }
    }

    func clickRow() {
        guard let row = generalRow, row.data.enabled else {
            return
        }
        rowItemAction()
    }

    func clickSwitch() {
        guard let row = generalRow, row.data.enabled else {
            return
        }
        if let switchAction = row.data.switchAction {
            switchAction()
        } else {
            rowItemAction()
        }
    }

    func done() {
        if doneEnabled {
            controller.process(controller.validateData([_id_name: .string(name())]))
        }
    }

    func pressReturn() {
        controller.process(controller.validateData([_id_name: .string(name())]))
    }
}

let creator = EnginePeer.channel(TelegramChannel(rights: [.changeInfo, .pinMessages, .manageTopics]))

func makeScreen(purpose: ForumTopicInfoPurpose, peers: FakePeers, peer: EnginePeer? = creator) -> Screen {
    let context = FakeContext(peers: peers)
    let peerId = PeerId(id: 1)

    __INITIAL_STATE__

    let stateValue = Atomic(value: initialState)
    let updateState: ((State) -> State) -> Void = { f in
        _ = stateValue.modify(f)
    }

    final class Emojis {
        let genericView = NSView()
    }
    let emojis = Emojis()

    __ARGUMENTS_INIT__

    let signal = Signal<InputDataSignalValue, NoError>.complete()

    __EDIT_CHECKS__

    __CONTROLLER__

    __VALIDATE__

    return Screen(peers: peers, navigation: context.bindings.navigation, render: {
        return __RENDER__
    }, name: {
        return stateValue.with { $0.name }
    }, rename: { name in
        arguments.updateName(name)
    }, setIcon: { fileId in
        updateState { current in
            var current = current
            current.icon = .init(file: nil, fileId: fileId, fromRect: nil)
            return current
        }
    }, controller: controller)
}

var passed = 0
var failures = 0

func check(_ name: String, _ condition: Bool) {
    if condition {
        passed += 1
    } else {
        failures += 1
        print("FAILED: \(name)")
    }
}

func general(hidden: Bool, title: String = "General") -> MessageHistoryThreadData {
    return MessageHistoryThreadData(info: .init(title: title, icon: nil, iconColor: 0), isHidden: hidden)
}

func openGeneral(_ peers: FakePeers, peer: EnginePeer? = creator) -> Screen {
    alerts = []
    return makeScreen(purpose: .edit(peers.stored, 1), peers: peers, peer: peer)
}

let paths: [(String, (Screen) -> Void)] = [("row", { $0.clickRow() }), ("switch", { $0.clickSwitch() })]

for startHidden in [false, true] {
    let start = startHidden ? "hidden" : "shown"
    let screen = openGeneral(FakePeers(stored: general(hidden: startHidden)))
    check("General \(start): the page has the switch", screen.generalRow != nil)
    check("General \(start): the switch starts \(startHidden ? "off" : "on")", screen.switchShown == !startHidden)
    check("General \(start): the owner can use the switch", screen.switchEnabled)
    check("General \(start): Done starts disabled", !screen.doneEnabled)
    screen.done()
    check("General \(start): Done with nothing changed sends nothing", screen.peers.requests.isEmpty && screen.navigation.backs == 0)
    screen.pressReturn()
    check("General \(start): Return with nothing changed sends nothing", screen.peers.requests.isEmpty && screen.navigation.backs == 0)
    check("General \(start): Return with nothing changed shows no error", alerts.isEmpty)

    for (path, click) in paths {
        let peers = FakePeers(stored: general(hidden: startHidden))
        let screen = openGeneral(peers)
        click(screen)
        check("General \(start), \(path): one click flips the switch on the page", screen.switchShown == startHidden)
        check("General \(start), \(path): the click itself sends nothing", peers.requests.isEmpty)
        check("General \(start), \(path): the click doesn't close the page", screen.navigation.backs == 0)
        check("General \(start), \(path): Done is enabled after the click", screen.doneEnabled)
        screen.done()
        check("General \(start), \(path): Done sends only the new hidden state", peers.requests == ["hidden \(!startHidden)"])
        check("General \(start), \(path): Done closes the page once", screen.navigation.backs == 1)
        check("General \(start), \(path): no error", alerts.isEmpty)
        let reopened = openGeneral(peers)
        check("General \(start), \(path): the page opened again shows the saved switch", reopened.switchShown == startHidden)

        let byReturn = FakePeers(stored: general(hidden: startHidden))
        let returned = openGeneral(byReturn)
        click(returned)
        returned.pressReturn()
        check("General \(start), \(path): Return after the click sends only the new hidden state", byReturn.requests == ["hidden \(!startHidden)"])
        check("General \(start), \(path): Return after the click closes the page once", returned.navigation.backs == 1)

        let twice = openGeneral(FakePeers(stored: general(hidden: startHidden)))
        click(twice)
        click(twice)
        check("General \(start), \(path): a second click puts the switch back", twice.switchShown == !startHidden)
        check("General \(start), \(path): after two clicks Done is disabled again", !twice.doneEnabled)
        twice.done()
        check("General \(start), \(path): after two clicks nothing is sent", twice.peers.requests.isEmpty && twice.navigation.backs == 0)
    }
}

do {
    let peers = FakePeers(stored: general(hidden: false))
    let screen = openGeneral(peers)
    screen.rename("Lobby")
    check("General renamed: Done is enabled", screen.doneEnabled)
    screen.done()
    check("General renamed: Done sends only the title, without an icon", peers.requests == ["edit Lobby icon nil"])
    check("General renamed: Done closes the page once", screen.navigation.backs == 1)
}

for (path, click) in paths {
    let peers = FakePeers(stored: general(hidden: false))
    let screen = openGeneral(peers)
    screen.rename("Lobby")
    click(screen)
    check("General renamed, \(path): the click sends nothing", peers.requests.isEmpty)
    check("General renamed, \(path): the click doesn't close the page", screen.navigation.backs == 0)
    screen.done()
    check("General renamed, \(path): Done sends the title, then the hidden state", peers.requests == ["edit Lobby icon nil", "hidden true"])
    check("General renamed, \(path): Done closes the page once", screen.navigation.backs == 1)
    check("General renamed, \(path): both are stored", peers.stored.info.title == "Lobby" && peers.stored.isHidden)
}

do {
    let peers = FakePeers(stored: general(hidden: false))
    peers.failEdit = true
    let screen = openGeneral(peers)
    screen.rename("Lobby")
    screen.clickRow()
    screen.done()
    check("General, title refused: the error is shown", alerts.count == 1)
    check("General, title refused: the hidden state isn't sent after it", peers.requests == ["edit Lobby icon nil"])
    check("General, title refused: the page stays open", screen.navigation.backs == 0)
    check("General, title refused: the page still shows the switch off", screen.switchShown == false)
}

do {
    let peers = FakePeers(stored: general(hidden: false))
    let screen = openGeneral(peers)
    screen.rename("")
    screen.clickRow()
    check("General with an empty name: Done is disabled", !screen.doneEnabled)
    screen.done()
    check("General with an empty name: nothing is sent", peers.requests.isEmpty && screen.navigation.backs == 0)
    screen.pressReturn()
    check("General with an empty name: Return shakes the name and sends nothing", screen.controller.shakes == 1 && peers.requests.isEmpty && screen.navigation.backs == 0)
}

for (who, peer) in [("an admin without Manage Topics", EnginePeer.channel(TelegramChannel(rights: [.changeInfo, .pinMessages]))), ("an unknown chat", nil)] as [(String, EnginePeer?)] {
    for (path, click) in paths {
        let peers = FakePeers(stored: general(hidden: false))
        let screen = openGeneral(peers, peer: peer)
        check("General for \(who), \(path): the switch shows the topic as shown", screen.switchShown == true)
        check("General for \(who), \(path): the switch is disabled", !screen.switchEnabled)
        click(screen)
        check("General for \(who), \(path): a click doesn't change it", screen.switchShown == true)
        check("General for \(who), \(path): Done stays disabled", !screen.doneEnabled)
        screen.pressReturn()
        check("General for \(who), \(path): nothing is sent", peers.requests.isEmpty && screen.navigation.backs == 0)
    }
}

let customIcon: Int64 = 5_368_324_170_671_202_286

do {
    let topic = MessageHistoryThreadData(info: .init(title: "Alpha", icon: customIcon, iconColor: 0x6FB9F0), isHidden: false)
    let peers = FakePeers(stored: topic)
    let screen = makeScreen(purpose: .edit(topic, 7), peers: peers)
    check("topic with an emoji icon: no General switch", screen.generalRow == nil)
    check("topic with an emoji icon: Done starts disabled", !screen.doneEnabled)
    screen.setIcon(99)
    check("topic with an emoji icon: a new icon enables Done", screen.doneEnabled)
    screen.done()
    check("topic with an emoji icon: Done sends the title and the new icon only", peers.requests == ["edit Alpha icon 99"])
    check("topic with an emoji icon: Done closes the page", screen.navigation.backs == 1)
}

