final class SilentSendShortcutTests: XCTestCase {
    override func setUp() { FastSettings.commandEnter = false }
    private func event(_ flags: NSEvent.ModifierFlags = [.command, .shift], key: KeyboardKey = .Return, repeatKey: Bool = false, type: NSEvent.EventType = .keyDown) -> NSEvent {
        return NSEvent.keyEvent(with: type, location: .zero, modifierFlags: flags, timestamp: 0, windowNumber: 0, context: nil, characters: key == .KeypadEnter ? "\u{3}" : "\r", charactersIgnoringModifiers: "\r", isARepeat: repeatKey, keyCode: key.rawValue)!
    }
    private func item(_ interaction: ChatInteraction) throws -> ContextMenuItem {
        return try XCTUnwrap(sendMessageMenuItems(chatInteraction: interaction, send: { interaction.sendMessage($0, $1, nil) })?.first)
    }
    private func richFixture() -> InputFixture {
        let input = InputFixture()
        input.chatInteraction.richTextDraft = InstantPage()
        let responder = NSView()
        input.addSubview(responder)
        input.chatInteraction.interactionContext.window.firstResponder = responder
        input.installRichHandlers()
        return input
    }

    func testRecordingDoesNotSendOnSilentShortcut() {
        let fixture = ChatControllerFixture()
        let recording = RecordingState()
        fixture.chatInteraction.presentation.recordingState = recording
        NSApp.currentEvent = event()
        defer { NSApp.currentEvent = nil }
        XCTAssertEqual(fixture.returnKeyAction(), .invoked)
        XCTAssertEqual(recording.sends, 0)
    }
    func testRecordingKeypadAndRepeatDoNotSendOnSilentShortcut() {
        let fixture = ChatControllerFixture()
        let recording = RecordingState()
        fixture.chatInteraction.presentation.recordingState = recording
        defer { NSApp.currentEvent = nil }
        for key in [KeyboardKey.Return, .KeypadEnter] {
            NSApp.currentEvent = event(key: key, repeatKey: true)
            XCTAssertEqual(fixture.returnKeyAction(), .invoked)
        }
        XCTAssertEqual(recording.sends, 0)
    }
    func testRecordingOrdinaryReturnStillSends() {
        let fixture = ChatControllerFixture()
        let recording = RecordingState()
        fixture.chatInteraction.presentation.recordingState = recording
        NSApp.currentEvent = event([])
        defer { NSApp.currentEvent = nil }
        XCTAssertEqual(fixture.returnKeyAction(), .invoked)
        XCTAssertEqual(recording.sends, 1)
    }
    func testNoRecordingLetsSilentShortcutReachComposer() {
        let fixture = ChatControllerFixture()
        NSApp.currentEvent = event()
        defer { NSApp.currentEvent = nil }
        XCTAssertEqual(fixture.returnKeyAction(), .rejected)
    }
    func testOnlyExactCommandShiftReturnMatches() {
        XCTAssertTrue(ChatSilentSendShortcut.matches(event()))
        for flags: NSEvent.ModifierFlags in [[], [.command], [.shift], [.option], [.command, .option], [.command, .shift, .option], [.command, .shift, .control]] {
            XCTAssertFalse(ChatSilentSendShortcut.matches(event(flags)))
        }
    }
    func testKeypadCapsLockAndFunctionDoNotChangeShortcut() {
        XCTAssertTrue(ChatSilentSendShortcut.matches(event([.command, .shift, .capsLock, .numericPad, .function], key: .KeypadEnter)))
        XCTAssertFalse(ChatSilentSendShortcut.matches(event(key: .A)))
        XCTAssertFalse(ChatSilentSendShortcut.matches(event(type: .keyUp)))
    }
    func testSilentSendWorksWithEnterPreference() {
        let input = InputFixture()
        XCTAssertTrue(input.textViewEnterPressed(event()))
        XCTAssertEqual(input.chatInteraction.sends.map(\.silent), [true])
        XCTAssertEqual(input.chatInteraction.sends.first?.effect, 7)
        XCTAssertNil(input.chatInteraction.sends.first?.schedule)
    }
    func testSilentSendWorksWithCommandEnterPreference() {
        FastSettings.commandEnter = true
        let input = InputFixture()
        XCTAssertTrue(input.textViewEnterPressed(event()))
        XCTAssertEqual(input.chatInteraction.sends.map(\.silent), [true])
    }
    func testOrdinaryEnterStillSendsNormally() {
        let input = InputFixture()
        XCTAssertTrue(input.textViewEnterPressed(event([])))
        XCTAssertEqual(input.chatInteraction.sends.map(\.silent), [false])
    }
    func testOrdinaryCommandEnterStillSendsNormally() {
        FastSettings.commandEnter = true
        let input = InputFixture()
        XCTAssertTrue(input.textViewEnterPressed(event([.command])))
        XCTAssertEqual(input.chatInteraction.sends.map(\.silent), [false])
    }
    func testShiftReturnAndOptionReturnStillInsertNewline() {
        for preference in [false, true] {
            FastSettings.commandEnter = preference
            let input = InputFixture()
            XCTAssertFalse(input.textViewEnterPressed(event([.shift])))
            XCTAssertFalse(input.textViewEnterPressed(event([.option])))
            XCTAssertTrue(input.chatInteraction.sends.isEmpty)
        }
    }
    func testRepeatedShortcutDoesNotSendAgain() {
        for preference in [false, true] {
            FastSettings.commandEnter = preference
            let input = InputFixture()
            XCTAssertTrue(input.textViewEnterPressed(event(repeatKey: true)))
            XCTAssertTrue(input.chatInteraction.sends.isEmpty)
        }
    }
    func testSavedMessagesDoesNotFallThroughToOrdinarySend() {
        FastSettings.commandEnter = true
        let input = InputFixture()
        input.chatInteraction.presentation.peer?.id = 1
        XCTAssertTrue(input.textViewEnterPressed(event()))
        XCTAssertTrue(input.chatInteraction.sends.isEmpty)
    }
    func testEditingDoesNotFallThroughToSave() {
        FastSettings.commandEnter = true
        let input = InputFixture()
        input.chatInteraction.presentation.state = .editing
        XCTAssertTrue(input.textViewEnterPressed(event()))
        XCTAssertTrue(input.chatInteraction.sends.isEmpty)
    }
    func testBlockedSlowModeAndMissingPeerDoNotSend() {
        FastSettings.commandEnter = true
        let input = InputFixture()
        input.chatInteraction.presentation.slowMode = SlowMode(hasLocked: true)
        XCTAssertTrue(input.textViewEnterPressed(event()))
        input.chatInteraction.presentation.slowMode = nil
        input.chatInteraction.presentation.state = .blocked
        XCTAssertTrue(input.textViewEnterPressed(event()))
        input.chatInteraction.presentation.state = .normal
        input.chatInteraction.presentation.peer = nil
        XCTAssertTrue(input.textViewEnterPressed(event()))
        XCTAssertTrue(input.chatInteraction.sends.isEmpty)
    }
    func testEmptyDraftDoesNotSend() {
        let input = InputFixture()
        input.textView.text = " \n "
        XCTAssertTrue(input.textViewEnterPressed(event()))
        XCTAssertTrue(input.chatInteraction.sends.isEmpty)
    }
    func testForwardOnlyUsesSilentSend() {
        let input = InputFixture()
        input.textView.text = ""
        input.chatInteraction.presentation.interfaceState.forwardMessageIds = [10]
        XCTAssertTrue(input.textViewEnterPressed(event()))
        XCTAssertEqual(input.chatInteraction.sends.map(\.silent), [true])
    }
    func testLengthValidationStillRunsForSilentSend() {
        let input = InputFixture()
        input.chatInteraction.maxInputCharacters = 2
        XCTAssertTrue(input.textViewEnterPressed(event()))
        XCTAssertTrue(input.chatInteraction.sends.isEmpty)
        XCTAssertEqual(input.chatInteraction.interactionContext.window.alerts, 1)
    }
    func testNativeMenuHasRealKeyEquivalentAndModifierMask() throws {
        let menuItem = try item(ChatInteraction())
        XCTAssertEqual(menuItem.keyEquivalent, "\r")
        XCTAssertEqual(menuItem.keyEquivalentModifierMask, [.command, .shift])
        XCTAssertEqual(displayedMenuShortcut(menuItem), "⇧⌘↩")
    }
    func testMenuActionStillSendsSilentlyOnce() throws {
        let interaction = ChatInteraction()
        let menuItem = try item(interaction)
        menuItem.handler?()
        menuItem.handler?()
        XCTAssertEqual(interaction.sends.map(\.silent), [true])
    }
    func testStaleMenuActionDoesNotSendChangedDraft() throws {
        let interaction = ChatInteraction()
        let menuItem = try item(interaction)
        interaction.revision += 1
        menuItem.handler?()
        XCTAssertTrue(interaction.sends.isEmpty)
    }
    func testAvailabilityAgreesWithSilentMenuPresence() {
        let interaction = ChatInteraction()
        for state in [State.normal, .editing, .blocked] {
            for locked in [false, true] {
                for peer in [Peer(id: 1), Peer(id: 2), nil] {
                    interaction.presentation.state = state
                    interaction.presentation.slowMode = SlowMode(hasLocked: locked)
                    interaction.presentation.peer = peer
                    let items = sendMessageMenuItems(chatInteraction: interaction, send: { _, _ in })
                    XCTAssertEqual(ChatSilentSendShortcut.isAvailable(for: interaction), items?.contains { $0.title == strings().chatSendWithoutSound } ?? false)
                }
            }
        }
    }
    func testInlineRichDraftShortcutUsesSilentSend() {
        let input = richFixture()
        XCTAssertEqual(input.chatInteraction.interactionContext.window.invoke(event()), .invoked)
        XCTAssertEqual(input.chatInteraction.sends.map(\.silent), [true])
    }
    func testInlineRichDraftKeypadShortcutAndReinstall() {
        let input = richFixture()
        input.installRichHandlers()
        XCTAssertEqual(input.chatInteraction.interactionContext.window.invoke(event(key: .KeypadEnter)), .invoked)
        XCTAssertEqual(input.chatInteraction.sends.map(\.silent), [true])
    }
    func testInlineRichDraftDoesNotSendWhileAnotherFieldFocused() {
        FastSettings.commandEnter = true
        let input = richFixture()
        input.chatInteraction.interactionContext.window.firstResponder = NSTextView()
        XCTAssertEqual(input.chatInteraction.interactionContext.window.invoke(event()), .invokeNext)
        XCTAssertTrue(input.chatInteraction.sends.isEmpty)
    }
    func testInlineRichDraftDoesNotSendMarkedComposition() {
        FastSettings.commandEnter = true
        let input = richFixture()
        let marked = MarkedTextView()
        marked.marked = true
        input.addSubview(marked)
        input.chatInteraction.interactionContext.window.firstResponder = marked
        XCTAssertEqual(input.chatInteraction.interactionContext.window.invoke(event()), .invokeNext)
        XCTAssertTrue(input.chatInteraction.sends.isEmpty)
    }
    func testInlineRichDraftRepeatAndUnavailableAreConsumed() {
        FastSettings.commandEnter = true
        let input = richFixture()
        XCTAssertEqual(input.chatInteraction.interactionContext.window.invoke(event(repeatKey: true)), .invoked)
        input.chatInteraction.presentation.peer?.id = 1
        XCTAssertEqual(input.chatInteraction.interactionContext.window.invoke(event()), .invoked)
        XCTAssertTrue(input.chatInteraction.sends.isEmpty)
    }
    func testRichDraftIncludesMutedAttribute() {
        let interaction = ChatInteraction()
        sendRich(interaction, silent: true)
        let attributes = interaction.richAttributes[0]
        XCTAssertEqual(attributes.compactMap { $0 as? NotificationInfoMessageAttribute }.map(\.flags), [.muted])
        XCTAssertEqual(attributes.compactMap { $0 as? RichTextMessageAttribute }.count, 1)
    }
    func testNormalRichDraftDoesNotGainMutedAttribute() {
        let interaction = ChatInteraction()
        sendRich(interaction, silent: false)
        XCTAssertTrue(interaction.richAttributes[0].compactMap { $0 as? NotificationInfoMessageAttribute }.isEmpty)
    }
    func testScheduledRichDraftRetainsMutedAttribute() {
        let interaction = ChatInteraction()
        sendRich(interaction, silent: true, date: Date(timeIntervalSince1970: 1000))
        XCTAssertEqual(interaction.richAttributes[0].compactMap { $0 as? NotificationInfoMessageAttribute }.count, 1)
        XCTAssertEqual(interaction.richAttributes[0].compactMap { $0 as? OutgoingScheduleInfoMessageAttribute }.first?.scheduleTime, 1000)
    }
    func testSuggestionsDoNotConsumeSilentSendShortcut() {
        let fixture = SuggestionFixture()
        __MAIN_SUGGESTION_OPT_IN__
        fixture.install()
        XCTAssertEqual(fixture.context.window.invoke(event()), .rejected)
        XCTAssertEqual(fixture.invocations, 0)
    }
    func testAttachmentCaptionSuggestionsKeepExistingReturnBehavior() {
        FastSettings.commandEnter = true
        let fixture = SuggestionFixture()
        fixture.install()
        let result = fixture.context.window.invoke(event())
        var ordinaryAttachmentSends = 0
        if result == .rejected && FastSettings.checkSendingAbility(for: event()) {
            ordinaryAttachmentSends += 1
        }
        XCTAssertEqual(result, .invoked)
        XCTAssertEqual(fixture.invocations, 1)
        XCTAssertEqual(ordinaryAttachmentSends, 0)
    }
    func testUnscopedSuggestionShortcutWorksUnderBothPreferences() {
        for preference in [false, true] {
            FastSettings.commandEnter = preference
            let fixture = SuggestionFixture()
            fixture.install()
            XCTAssertEqual(fixture.context.window.invoke(event(key: .KeypadEnter)), .invoked)
            XCTAssertEqual(fixture.invocations, 1)
        }
    }
    func testOrdinaryReturnStillSelectsSuggestion() {
        let fixture = SuggestionFixture()
        fixture.install()
        XCTAssertEqual(fixture.context.window.invoke(event([])), .invoked)
        XCTAssertEqual(fixture.invocations, 1)
    }
    func testExpandedEditorInvokesExistingSilentMenuAction() throws {
        let fixture = ModalFixture()
        let interaction = ChatInteraction()
        fixture.items = [try item(interaction)]
        let responder = NSView()
        fixture.coordinator.editor.addSubview(responder)
        fixture.context.window.firstResponder = responder
        XCTAssertEqual(fixture.controller.returnKeyInvocation(nil, event()), .nothing)
        XCTAssertEqual(interaction.sends.map(\.silent), [true])
    }
    func testExpandedEditorPreservesOrdinaryReturn() {
        let fixture = ModalFixture()
        XCTAssertEqual(fixture.controller.returnKeyInvocation(nil, event([])), .invokeEvent)
        XCTAssertEqual(fixture.controller.returnKeyInvocation(nil, event([.shift])), .invokeEvent)
    }
    func testExpandedEditorIgnoresOtherFieldsMarkedTextAndRepeats() throws {
        let fixture = ModalFixture()
        let interaction = ChatInteraction()
        fixture.items = [try item(interaction)]
        let marked = MarkedTextView()
        fixture.context.window.firstResponder = marked
        XCTAssertEqual(fixture.controller.returnKeyInvocation(nil, event()), .invokeEvent)
        fixture.coordinator.editor.addSubview(marked)
        marked.marked = true
        XCTAssertEqual(fixture.controller.returnKeyInvocation(nil, event()), .invokeEvent)
        marked.marked = false
        XCTAssertEqual(fixture.controller.returnKeyInvocation(nil, event(repeatKey: true)), .nothing)
        XCTAssertTrue(interaction.sends.isEmpty)
    }
    func testCustomMenuInvokesShortcutNotHighlightedScheduleItem() throws {
        let fixture = MenuFixture()
        let interaction = ChatInteraction()
        let silent = AppMenuBasicItem(try item(interaction), action: { $0.handler?() })
        var scheduled = 0
        let schedule = AppMenuBasicItem(ContextMenuItem("Schedule"), action: { _ in scheduled += 1 })
        fixture.activeMenu?.tableView.items = [silent, schedule]
        fixture.activeMenu?.tableView.selected = schedule
        XCTAssertTrue(fixture.invoke(event()))
        XCTAssertEqual(interaction.sends.map(\.silent), [true])
        XCTAssertEqual(scheduled, 0)
    }
    func testCustomMenuShortcutIsExactAndIgnoresRepeat() throws {
        let fixture = MenuFixture()
        let interaction = ChatInteraction()
        fixture.activeMenu?.tableView.items = [AppMenuBasicItem(try item(interaction), action: { $0.handler?() })]
        XCTAssertFalse(fixture.invoke(event([.command])))
        XCTAssertFalse(fixture.invoke(event([.command, .shift, .option])))
        XCTAssertTrue(fixture.invoke(event(repeatKey: true)))
        XCTAssertTrue(interaction.sends.isEmpty)
    }
    func testCustomMenuDisabledHiddenAndSubmenuItemsDoNotInvoke() throws {
        let fixture = MenuFixture()
        let interaction = ChatInteraction()
        let menuItem = try item(interaction)
        fixture.activeMenu?.tableView.items = [AppMenuBasicItem(menuItem, action: { $0.handler?() })]
        menuItem.isEnabled = false
        XCTAssertFalse(fixture.invoke(event()))
        menuItem.isEnabled = true
        menuItem.isHidden = true
        XCTAssertFalse(fixture.invoke(event()))
        menuItem.isHidden = false
        menuItem.submenu = NSMenu()
        XCTAssertFalse(fixture.invoke(event()))
        XCTAssertTrue(interaction.sends.isEmpty)
    }
    func testGenericReturnLabelsKeepOtherShortcutsUnchanged() {
        let menuItem = ContextMenuItem("Test", keyEquivalent: .cmdc)
        XCTAssertNil(menuItem.returnKeyEquivalentText)
        XCTAssertEqual(displayedMenuShortcut(menuItem), "⌘C")
        menuItem.keyEquivalent = "\u{3}"
        menuItem.keyEquivalentModifierMask = [.control, .option]
        XCTAssertEqual(menuItem.returnKeyEquivalentText, "⌃⌥⌤")
    }
    func testNativeReturnHintOverridesEmptyCustomMenuEnum() throws {
        let menuItem = try item(ChatInteraction())
        XCTAssertEqual(menuItem.keyEquivalentValue, .none)
        XCTAssertEqual(displayedMenuShortcut(menuItem), "⇧⌘↩")
    }
    func testSilentRecordingShortcutDoesNotEnterTranscriptionEditing() {
        let fixture = ChatControllerFixture()
        fixture.chatInteraction.presentation.recordingState = RecordingState()
        let transcription = TranscriptionRecorder()
        fixture.chatInteraction.voiceTranscription = transcription
        NSApp.currentEvent = event()
        defer { NSApp.currentEvent = nil }
        XCTAssertEqual(fixture.returnKeyAction(), .invoked)
        XCTAssertEqual(transcription.edits, 0)
        XCTAssertEqual(fixture.chatInteraction.presentation.recordingState?.sends, 0)
    }
    func testOrdinaryRecordingReturnPreservesTranscriptionEditing() {
        let fixture = ChatControllerFixture()
        fixture.chatInteraction.presentation.recordingState = RecordingState()
        let transcription = TranscriptionRecorder()
        fixture.chatInteraction.voiceTranscription = transcription
        NSApp.currentEvent = event([])
        defer { NSApp.currentEvent = nil }
        XCTAssertEqual(fixture.returnKeyAction(), .invoked)
        XCTAssertEqual(transcription.edits, 1)
        XCTAssertEqual(fixture.chatInteraction.presentation.recordingState?.sends, 0)
    }
    func testOrdinaryRecordingReturnRetainsKeyboardSource() {
        let fixture = ChatControllerFixture()
        let recording = RecordingState()
        fixture.chatInteraction.presentation.recordingState = recording
        NSApp.currentEvent = event([])
        defer { NSApp.currentEvent = nil }
        XCTAssertEqual(fixture.returnKeyAction(), .invoked)
        XCTAssertEqual(recording.source, .keyboard)
    }
}
