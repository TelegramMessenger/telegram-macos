import Cocoa
import KeyboardKey
import SendingPreference
import XCTest

final class WindowRecorder {
    struct Handler {
        let object: NSObject
        let key: KeyboardKey
        let flags: NSEvent.ModifierFlags?
        let action: (NSEvent) -> KeyHandlerResult
    }

    var firstResponder: NSResponder?
    var handlers: [Handler] = []
    var alerts = 0
    var scheduleSelections: [(Date, Int32?) -> Void] = []

    func set(handler: @escaping (NSEvent) -> KeyHandlerResult, with object: NSObject, for key: KeyboardKey, priority: Priority, modifierFlags: NSEvent.ModifierFlags? = nil) {
        handlers.append(Handler(object: object, key: key, flags: modifierFlags, action: handler))
        if key == .Return {
            handlers.append(Handler(object: object, key: .KeypadEnter, flags: modifierFlags, action: handler))
        }
    }

    func remove(object: NSObject, for key: KeyboardKey, modifierFlags: NSEvent.ModifierFlags? = nil, forceCheckFlags: Bool = false) {
        handlers.removeAll { $0.object === object && ($0.key == key || (key == .Return && $0.key == .KeypadEnter)) && $0.flags == modifierFlags }
    }

    func invoke(_ event: NSEvent) -> KeyHandlerResult {
        for handler in handlers where handler.key.rawValue == event.keyCode && (handler.flags == nil || event.modifierFlags.contains(handler.flags!)) {
            let result = handler.action(event)
            if result != .rejected { return result }
        }
        return .rejected
    }
}

