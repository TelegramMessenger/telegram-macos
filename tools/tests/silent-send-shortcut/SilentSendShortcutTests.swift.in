public final class ChatInteraction {
    public struct Schedule { let date: Date; var repeatPeriod: Int32? }
    struct Send {
        let silent: Bool
        let schedule: Schedule?
        let effect: Int?
    }
    let interactionContext = Context()
    var context: Context { interactionContext }
    var presentation = Presentation()
    var mode: Mode = .history
    var richTextDraft: InstantPage?
    var voiceTranscription: TranscriptionRecorder?
    var maxInputCharacters = 4096
    var peerIsAccountPeer: Bool { presentation.peer?.id == interactionContext.account.peerId }
    var activitySpace = 1
    var sends: [Send] = []
    var scrolls = 0
    var revision = 0
    var richAttributes: [[MessageAttribute]] = []
    func sendMessage(_ silent: Bool, _ schedule: Schedule?, _ effect: Int?) { sends.append(Send(silent: silent, schedule: schedule, effect: effect)) }
    func scrollToLatest(_ animated: Bool) { scrolls += 1 }
    func setRichTextDraft(_ draft: InstantPage?, analyticsContext: AnalyticsContext? = nil) { richTextDraft = draft }
    func captureAnalyticsContext(inherited: AnalyticsContext? = nil) -> AnalyticsContext { inherited ?? AnalyticsContext() }
    func captureDeferredSendAction() -> ChatDeferredSendAction {
        let captured = revision
        return ChatDeferredSendAction { [weak self] in self?.revision == captured }
    }
}

