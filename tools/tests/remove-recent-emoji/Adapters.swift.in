final class FlippedView: NSView {
    override var isFlipped: Bool { true }
}
final class EBlockItem {
    var lineAttr: [[NSAttributedString]]
    var segment: EmojiSegment?
    var removeRecent: ((String) -> Void)?
    init(_ values: [NSAttributedString]) { lineAttr = [values] }
    init(_ size: NSSize, stableId: AnyHashable, attrLines: [[NSAttributedString]], segment: EmojiSegment, account: Account, selectHandler: (String, NSRect) -> Void, dragHandler: Int?, selectedOrders: [String: Int], selectionColor: NSColor?, removeRecent: ((String) -> Void)?) {
        lineAttr = attrLines
        self.segment = segment
        self.removeRecent = removeRecent
    }
}
final class EBlockRowView: NSView {
    struct Key: Hashable { let index: Int }
    struct Cell { let frame: NSRect; let emoji: NSAttributedString }
    let content = FlippedView(frame: NSRect(x: 12, y: 8, width: 100, height: 34))
    var lines: [Key: Cell] = [:]
    var item: AnyObject?
    override var isFlipped: Bool { true }
    convenience init(_ values: [String]) {
        self.init(attributed: values.map { NSAttributedString(string: $0) })
    }
    init(attributed values: [NSAttributedString]) {
        item = EBlockItem(values)
        super.init(frame: NSRect(x: 0, y: 0, width: 140, height: 50))
        addSubview(content)
        for (index, value) in values.enumerated() {
            lines[Key(index: index)] = Cell(frame: NSRect(x: index * 40, y: 0, width: 34, height: 34), emoji: value)
        }
    }
    required init?(coder: NSCoder) { fatalError() }
    __BUILTIN_HIT__
}

final class BuiltinMenu {
    let account = Account()
