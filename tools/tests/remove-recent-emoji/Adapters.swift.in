    init(view: EBlockRowView, removeRecent: ((String) -> Void)? = nil) {
        self.view = view
        self.removeRecent = removeRecent
    }
    __BUILTIN_MENU__
}

struct TelegramMediaFile: Equatable {
    let fileId: MediaId
    var isPremiumEmoji = false
    var emojiReference: Int? = nil
    var resource: LocalBundleResource? = nil
    init(fileId: MediaId, isPremiumEmoji: Bool = false, emojiReference: Int? = nil) {
        self.fileId = fileId
        self.isPremiumEmoji = isPremiumEmoji
        self.emojiReference = emojiReference
    }
    init(fileId: MediaId, partialReference: Int?, resource: LocalBundleResource, previewRepresentations: [Int], videoThumbnails: [Int], immediateThumbnailData: Data?, mimeType: String, size: Int?, attributes: [Int], alternativeRepresentations: [Int]) {
        self.fileId = fileId
        self.resource = resource
    }
    func _parse() -> TelegramMediaFile { self }
}
struct StickerPackItem: Equatable {
    struct Index: Equatable {
        let index: Int32
        let id: Int64
    }
    var index = Index(index: 0, id: 0)
    let file: TelegramMediaFile
    var indexKeys: [String] = []
    func getStringRepresentationsOfIndexKeys() -> [String] { indexKeys }
}
final class EmojiesSectionRowItem {
    __ROW_MODE__
    enum Source: Equatable { case builtin(String), custom(Int64) }
    struct SelectedItem: Equatable { let source: Source; let index: Int? }
    struct Item { let rect: NSRect; let item: StickerPackItem? }
    var removeRecent: ((MediaId) -> Void)?
    var items: [Item]
    var mode: Mode = .panel
    var selectedItems: [SelectedItem] = []
    var revealed = false
    var color: NSColor?
    var showAllItems: (() -> Void)?
    convenience init(_ size: NSSize, stableId: AnyHashable, context: SectionContext, revealed: Bool, installed: Bool, info: Int?, items: [StickerPackItem], mode: Mode, selectedItems: [SelectedItem], color: NSColor?, callback: Int?, largeCallback: Int?, drag: Int?, showAllItems: (() -> Void)? = nil, ignorePremium: Bool, removeRecent: ((MediaId) -> Void)? = nil) {
        self.init([])
        self.items = items.enumerated().map { index, item in
            Item(rect: NSRect(x: index * 40, y: 0, width: 34, height: 34), item: item)
        }
        self.mode = mode
        self.selectedItems = selectedItems
        self.revealed = revealed
        self.color = color
        self.showAllItems = showAllItems
        self.removeRecent = removeRecent
    }
    init(_ ids: [MediaId]) {
        items = ids.enumerated().map { index, id in
            Item(rect: NSRect(x: index * 40, y: 0, width: 34, height: 34), item: StickerPackItem(file: TelegramMediaFile(fileId: id)))
        }
    }
}
