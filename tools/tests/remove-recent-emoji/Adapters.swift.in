enum EmojiSegment: Int, Comparable {
    case Recent = 0, People = 1, RecentAnimated = 100
    var localizedString: String { self == .Recent ? "Frequently Used Emoji" : "People" }
    static func <(lhs: EmojiSegment, rhs: EmojiSegment) -> Bool { lhs.rawValue < rhs.rawValue }
}
__PICKER_MODE__

__ROW_SELECTION__

__REACTION_VALUE__
