    var toggles = 0
    weak var parentController: StoryParent?
    var menuItemsUpdated: (() -> Void)?
    func toggleSelection() { selected.toggle(); toggles += 1 }
    func addCollection(_ id: Int?) {}
    __STORY_MENU__
