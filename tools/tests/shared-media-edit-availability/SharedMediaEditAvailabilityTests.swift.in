    let arguments = MemberArguments()
    var canEdit = false
    for i in sortedParticipants.indices {
        let peer = TestPeer(id: sortedParticipants[i].peerId)
        __GROUP_ELIGIBILITY__
    }
    return canEdit
}
func channelCanEdit(_ channel: TelegramChannel, _ participants: [ChannelParticipant], disabledPeerIds: Set<Int> = []) -> Bool {
    let arguments = MemberArguments()
    let sortedParticipants = participants.map { RenderedParticipant(participant: $0) }
    var canEdit = false
    for i in sortedParticipants.indices {
        __CHANNEL_ELIGIBILITY__
    }
    return canEdit
}

final class SharedMediaEditAvailabilityTests: XCTestCase {
    let messageModes: [PeerMediaCollectionMode] = [.photoOrVideo, .file, .webpage, .music, .voice, .gifs]
    let unsupportedModes: [PeerMediaCollectionMode] = [.saved, .polls, .commonGroups, .savedMessages, .similarChannels, .similarBots, .gifts]
    func actions(_ controller: PeerMediaController<Context>) -> [ContextMenuItem] {
        controller.editButton?.contextMenu?()?.items.filter { !$0.isSeparatorItem } ?? []
    }
    @objc func testUnsupportedMenusAreAbsent() {
        for mode in unsupportedModes {
            let controller = PeerMediaController<Context>(mode)
            XCTAssertTrue(actions(controller).isEmpty, "\(mode)")
            XCTAssertTrue(controller.editButton!.isHidden, "\(mode)")
        }
    }
    @objc func testUnsupportedEditCannotBeInvoked() {
        for mode in unsupportedModes {
            let controller = PeerMediaController<Context>(mode)
            controller.update(with: .Edit)
            XCTAssertEqual(controller.state, .Normal, "\(mode)")
            XCTAssertNil(controller.interactions.presentation.ids, "\(mode)")
            XCTAssertFalse(controller.genericView.selecting, "\(mode)")
        }
    }
    @objc func testSupportedMenusEnterSelectionAndDoneLeaves() {
        for mode in messageModes + [.members, .stories, .archiveStories] {
            let controller = PeerMediaController<Context>(mode)
            XCTAssertEqual(actions(controller).map(\.title), ["Edit"], "\(mode)")
            actions(controller).first?.handler?()
            XCTAssertEqual(controller.state, .Edit, "\(mode)")
            XCTAssertEqual(controller.editButton?.text, "Done", "\(mode)")
            XCTAssertEqual(controller.genericView.selecting, messageModes.contains(mode), "\(mode)")
            controller.editButton?.press()
            XCTAssertEqual(controller.state, .Normal, "\(mode)")
            XCTAssertNil(controller.interactions.presentation.ids, "\(mode)")
            XCTAssertFalse(controller.genericView.selecting, "\(mode)")
        }
    }
    @objc func testUnsupportedTabCancelsSelection() {
        for mode in unsupportedModes {
            let controller = PeerMediaController<Context>(.photoOrVideo)
            controller.update(with: .Edit)
            controller.interactions.presentation.ids = [7, 11]
            controller.applyReadyController(mode: mode, animated: true)
            XCTAssertEqual(controller.state, .Normal, "\(mode)")
            XCTAssertNil(controller.interactions.presentation.ids, "\(mode)")
            XCTAssertFalse(controller.genericView.selecting, "\(mode)")
            XCTAssertTrue(controller.editButton!.isHidden, "\(mode)")
            controller.applyReadyController(mode: .photoOrVideo, animated: true)
            XCTAssertFalse(controller.editButton!.isHidden)
            XCTAssertNil(controller.interactions.presentation.ids)
        }
    }
    @objc func testSharedMessageTabsRetainSelection() {
        let controller = PeerMediaController<Context>(.photoOrVideo)
        controller.update(with: .Edit)
        controller.interactions.presentation.ids = [31]
        for mode in messageModes {
            controller.applyReadyController(mode: mode, animated: true)
            XCTAssertEqual(controller.state, .Edit)
            XCTAssertEqual(controller.interactions.presentation.ids, [31])
            XCTAssertTrue(controller.genericView.selecting)
            XCTAssertEqual(controller.editButton?.text, "Done")
        }
    }
    @objc func testSwitchingSelectionOwnersCancels() {
        for source in [.members, .stories, .archiveStories] as [PeerMediaCollectionMode] {
            let controller = PeerMediaController<Context>(source)
            controller.update(with: .Edit)
            controller.applyReadyController(mode: .photoOrVideo, animated: true)
            XCTAssertEqual(controller.state, .Normal)
            XCTAssertFalse(controller.genericView.selecting)
            XCTAssertFalse(controller.stories.selected)
            XCTAssertFalse(controller.archiveStories!.selected)
            XCTAssertFalse(controller.editing.value)
        }
    }
    @objc func testOnlyActiveStoryControllerToggles() {
        let controller = PeerMediaController<Context>(.stories)
        controller.update(with: .Edit)
        XCTAssertTrue(controller.stories.selected)
        XCTAssertFalse(controller.archiveStories!.selected)
        controller.update(with: .Normal)
        XCTAssertFalse(controller.stories.selected)
        XCTAssertEqual(controller.archiveStories?.toggles, 0)
    }
    @objc func testMessageEditingDoesNotToggleStoryChildren() {
        let controller = PeerMediaController<Context>(.photoOrVideo)
        controller.update(with: .Edit)
        controller.update(with: .Normal)
        XCTAssertEqual(controller.stories.toggles, 0)
        XCTAssertEqual(controller.archiveStories?.toggles, 0)
    }
    @objc func testDelayedMemberScrollCannotRestoreEditing() {
        let controller = PeerMediaController<Context>(.members)
        let table = controller.genericView.mainTable!
        controller.update(with: .Edit)
        controller.applyReadyController(mode: .saved, animated: true)
        table.finishScroll()
        XCTAssertFalse(controller.editing.value)
        XCTAssertEqual(controller.state, .Normal)
    }
    @objc func testMemberEditingDoesNotAwaitExitScroll() {
        let controller = PeerMediaController<Context>(.members)
        controller.update(with: .Edit)
        controller.genericView.mainTable!.finishScroll()
        XCTAssertTrue(controller.editing.value)
        controller.update(with: .Normal)
        XCTAssertFalse(controller.editing.value)
    }
    @objc func testCurrentMemberStateWinsDelayedCompletions() {
        let controller = PeerMediaController<Context>(.members)
        controller.update(with: .Edit)
        controller.update(with: .Normal)
        controller.update(with: .Edit)
        controller.genericView.mainTable!.finishScroll()
        XCTAssertTrue(controller.editing.value)
    }
    @objc func testChildMenusArePreservedWithoutFallback() {
        let controller = PeerMediaController<Context>(.gifts)
        let item = ContextMenuItem("Filter")
        controller.gifts!.suppliedMenu = [item, ContextSeparatorItem(), ContextMenuItem("Sort")]
        controller.requestUpdateRightBar()
        XCTAssertEqual(actions(controller).map(\.title), ["Filter", "Sort"])
        XCTAssertFalse(controller.editButton!.isHidden)
        XCTAssertTrue(actions(controller).first === item)
    }
    @objc func testSeparatorOnlyChildDoesNotShowButton() {
        let controller = PeerMediaController<Context>(.gifts)
        controller.gifts!.suppliedMenu = [ContextSeparatorItem()]
        controller.requestUpdateRightBar()
        XCTAssertTrue(controller.editButton!.isHidden)
        XCTAssertNil(controller.editButton!.contextMenu?())
    }
    @objc func testDoneHasNoEditContextMenu() {
        let controller = PeerMediaController<Context>(.photoOrVideo)
        controller.update(with: .Edit)
        XCTAssertNil(controller.editButton?.contextMenu?())
        XCTAssertFalse(controller.editButton!.isHidden)
    }
    @objc func testSelectionChromeUpdatesWithoutObserver() {
        let controller = PeerMediaController<Context>(.photoOrVideo)
        controller.interactions.observer = nil
        controller.update(with: .Edit)
        XCTAssertTrue(controller.genericView.selecting)
        controller.applyReadyController(mode: .saved, animated: false)
        XCTAssertFalse(controller.genericView.selecting)
        XCTAssertEqual(controller.state, .Normal)
    }
    @objc func testInteractiveTabTransitionRefreshesAvailability() {
        let controller = PeerMediaController<Context>(.commonGroups)
        controller.interactiveSwitchMode = .gifs
        controller.applyReadyController(mode: .gifs, animated: true)
        XCTAssertFalse(controller.editButton!.isHidden)
        XCTAssertEqual(actions(controller).map(\.title), ["Edit"])
        controller.interactiveSwitchMode = .polls
        controller.applyReadyController(mode: .polls, animated: true)
        XCTAssertTrue(controller.editButton!.isHidden)
    }
    @objc func testSelectionChangedByChildUpdatesDoneAndPanel() {
        let controller = PeerMediaController<Context>(.file)
        controller.interactions.update { $0.withSelectionState() }
        XCTAssertEqual(controller.state, .Edit)
        XCTAssertEqual(controller.editButton?.text, "Done")
        XCTAssertTrue(controller.genericView.selecting)
        controller.interactions.update { $0.withoutSelectionState() }
        XCTAssertEqual(controller.state, .Normal)
        XCTAssertFalse(controller.genericView.selecting)
    }
    @objc func testMembersWithoutRemovableRowsHaveNoEdit() {
        let controller = PeerMediaController<Context>(.members, memberPermission: false)
        XCTAssertTrue(controller.editButton!.isHidden)
        XCTAssertTrue(actions(controller).isEmpty)
        controller.update(with: .Edit)
        XCTAssertEqual(controller.state, .Normal)
    }
    @objc func testMembersPermissionChangesRefreshAndCancelEditing() {
        let controller = PeerMediaController<Context>(.members, memberPermission: false)
        controller.receiveMembersAvailability(true)
        XCTAssertFalse(controller.editButton!.isHidden)
        controller.update(with: .Edit)
        controller.genericView.mainTable!.finishScroll()
        XCTAssertTrue(controller.editing.value)
        controller.receiveMembersAvailability(false)
        XCTAssertEqual(controller.state, .Normal)
        XCTAssertTrue(controller.editButton!.isHidden)
        XCTAssertFalse(controller.editing.value)
        controller.genericView.mainTable!.finishScroll()
        XCTAssertFalse(controller.editing.value)
    }
    @objc func testInactiveMembersPermissionUpdatesDoNotCancelMedia() {
        let controller = PeerMediaController<Context>(.file)
        controller.update(with: .Edit)
        controller.receiveMembersAvailability(false)
        XCTAssertEqual(controller.state, .Edit)
        controller.applyReadyController(mode: .members, animated: true)
        XCTAssertEqual(controller.state, .Normal)
        XCTAssertTrue(controller.editButton!.isHidden)
    }
    @objc func testBasicGroupUsesExistingRemovalAndInvitationRights() {
        let member = GroupParticipant.member(id: 2, invitedBy: 3)
        let invited = GroupParticipant.member(id: 2, invitedBy: 1)
        let own = GroupParticipant.member(id: 1, invitedBy: 1)
        let admin = GroupParticipant.admin(id: 2, invitedBy: 3)
        let creator = GroupParticipant.creator(id: 3)
        XCTAssertFalse(basicGroupCanEdit(TelegramGroup(role: .member), [member]))
        XCTAssertTrue(basicGroupCanEdit(TelegramGroup(role: .member), [invited]))
        XCTAssertFalse(basicGroupCanEdit(TelegramGroup(role: .member), [own]))
        XCTAssertTrue(basicGroupCanEdit(TelegramGroup(role: .admin), [member]))
        XCTAssertFalse(basicGroupCanEdit(TelegramGroup(role: .admin), [admin, creator]))
        XCTAssertTrue(basicGroupCanEdit(TelegramGroup(role: .creator), [admin]))
        XCTAssertFalse(basicGroupCanEdit(TelegramGroup(role: .creator), [creator]))
        XCTAssertFalse(basicGroupCanEdit(TelegramGroup(role: .creator), []))
        XCTAssertFalse(basicGroupCanEdit(TelegramGroup(role: .creator), [member], disabledPeerIds: [2]))
    }
    @objc func testChannelUsesActualRemovableParticipantRights() {
        let member = ChannelParticipant.member(id: 2, invitedAt: 0, adminInfo: nil, banInfo: nil, rank: nil, subscriptionUntilDate: nil)
        let own = ChannelParticipant.member(id: 1, invitedAt: 0, adminInfo: nil, banInfo: nil, rank: nil, subscriptionUntilDate: nil)
        let promoted = ChannelParticipant.member(id: 2, invitedAt: 0, adminInfo: AdminInfo(promotedBy: 1), banInfo: nil, rank: nil, subscriptionUntilDate: nil)
        let otherAdmin = ChannelParticipant.member(id: 2, invitedAt: 0, adminInfo: AdminInfo(promotedBy: 3), banInfo: nil, rank: nil, subscriptionUntilDate: nil)
        let creator = ChannelParticipant.creator(id: 3)
        let noBan = TelegramChannel(flags: [], mayBan: false)
        let ban = TelegramChannel(flags: [], mayBan: true)
        let owner = TelegramChannel(flags: [.isCreator], mayBan: false)
        XCTAssertFalse(channelCanEdit(noBan, [member]))
        XCTAssertTrue(channelCanEdit(ban, [member]))
        XCTAssertFalse(channelCanEdit(ban, [own, creator, otherAdmin]))
        XCTAssertTrue(channelCanEdit(noBan, [promoted]))
        XCTAssertTrue(channelCanEdit(owner, [otherAdmin]))
        XCTAssertFalse(channelCanEdit(owner, [creator]))
        XCTAssertFalse(channelCanEdit(owner, []))
        XCTAssertFalse(channelCanEdit(ban, [member], disabledPeerIds: [2]))
    }
    static let allTests = [
        ("testMembersWithoutRemovableRowsHaveNoEdit", testMembersWithoutRemovableRowsHaveNoEdit),
        ("testMembersPermissionChangesRefreshAndCancelEditing", testMembersPermissionChangesRefreshAndCancelEditing),
        ("testInactiveMembersPermissionUpdatesDoNotCancelMedia", testInactiveMembersPermissionUpdatesDoNotCancelMedia),
        ("testBasicGroupUsesExistingRemovalAndInvitationRights", testBasicGroupUsesExistingRemovalAndInvitationRights),
        ("testChannelUsesActualRemovableParticipantRights", testChannelUsesActualRemovableParticipantRights),
        ("testUnsupportedMenusAreAbsent", testUnsupportedMenusAreAbsent),
        ("testUnsupportedEditCannotBeInvoked", testUnsupportedEditCannotBeInvoked),
        ("testSupportedMenusEnterSelectionAndDoneLeaves", testSupportedMenusEnterSelectionAndDoneLeaves),
        ("testUnsupportedTabCancelsSelection", testUnsupportedTabCancelsSelection),
        ("testSharedMessageTabsRetainSelection", testSharedMessageTabsRetainSelection),
        ("testSwitchingSelectionOwnersCancels", testSwitchingSelectionOwnersCancels),
        ("testOnlyActiveStoryControllerToggles", testOnlyActiveStoryControllerToggles),
        ("testMessageEditingDoesNotToggleStoryChildren", testMessageEditingDoesNotToggleStoryChildren),
        ("testDelayedMemberScrollCannotRestoreEditing", testDelayedMemberScrollCannotRestoreEditing),
        ("testMemberEditingDoesNotAwaitExitScroll", testMemberEditingDoesNotAwaitExitScroll),
        ("testCurrentMemberStateWinsDelayedCompletions", testCurrentMemberStateWinsDelayedCompletions),
        ("testChildMenusArePreservedWithoutFallback", testChildMenusArePreservedWithoutFallback),
        ("testSeparatorOnlyChildDoesNotShowButton", testSeparatorOnlyChildDoesNotShowButton),
        ("testDoneHasNoEditContextMenu", testDoneHasNoEditContextMenu),
        ("testSelectionChromeUpdatesWithoutObserver", testSelectionChromeUpdatesWithoutObserver),
        ("testInteractiveTabTransitionRefreshesAvailability", testInteractiveTabTransitionRefreshesAvailability),
        ("testSelectionChangedByChildUpdatesDoneAndPanel", testSelectionChangedByChildUpdatesDoneAndPanel)
    ]
}
let suite = XCTestSuite(name: "SharedMediaEditAvailabilityTests")
for (name, _) in SharedMediaEditAvailabilityTests.allTests {
    suite.addTest(SharedMediaEditAvailabilityTests(selector: NSSelectorFromString(name)))
}
suite.run()
let result = suite.testRun!
print("Executed \(result.executionCount) tests, with \(result.totalFailureCount) failures")
exit(result.hasSucceeded ? 0 : 1)
