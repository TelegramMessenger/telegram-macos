typealias PeerId = Int
enum GroupParticipant {
    case creator(id: Int)
    case admin(id: Int, invitedBy: Int)
    case member(id: Int, invitedBy: Int)
    var peerId: Int {
        switch self {
        case let .creator(id), let .admin(id, _), let .member(id, _): return id
        }
    }
    var invitedBy: Int? {
        switch self {
        case .creator: return nil
        case let .admin(_, invitedBy), let .member(_, invitedBy): return invitedBy
        }
    }
}
struct TelegramGroup {
    enum Role { case creator, admin, member }
    let role: Role
}
struct AdminInfo { let promotedBy: Int }
enum ChannelParticipant {
    case creator(id: Int)
    case member(id: Int, invitedAt: Int, adminInfo: AdminInfo?, banInfo: Int?, rank: String?, subscriptionUntilDate: Int?)
    var peerId: Int {
        switch self {
        case let .creator(id), let .member(id, _, _, _, _, _): return id
        }
    }
}
struct TelegramChannel {
    struct Flags: OptionSet { let rawValue: Int; static let isCreator = Flags(rawValue: 1) }
    enum Permission { case banMembers }
    let flags: Flags
    let mayBan: Bool
    func hasPermission(_ value: Permission) -> Bool { mayBan || flags.contains(.isCreator) }
}
__PERMISSIONS__
struct TestPeer { let id: Int }
struct RenderedParticipant {
    let participant: ChannelParticipant
    var peer: TestPeer { TestPeer(id: participant.peerId) }
}
struct MemberAccount { let peerId = 1 }
struct MemberContext { let peerId = 1; let account = MemberAccount() }
struct MemberArguments { let context = MemberContext() }
