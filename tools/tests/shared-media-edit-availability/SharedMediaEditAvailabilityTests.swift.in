struct ChatPresentationInterfaceState {
    enum State { case normal, selecting }
    var ids: Set<Int>?
    var state: State { ids == nil ? .normal : .selecting }
    func withoutSelectionState() -> Self { Self(ids: nil) }
    func withSelectionState() -> Self { Self(ids: []) }
}
final class Interaction {
    var presentation = ChatPresentationInterfaceState()
    var observer: ((ChatPresentationInterfaceState, ChatPresentationInterfaceState, Bool) -> Void)?
    func update(_ f: (ChatPresentationInterfaceState) -> ChatPresentationInterfaceState) {
        let old = presentation
        presentation = f(old)
        observer?(presentation, old, true)
    }
}
