class ContextMenuItem {
    let title: String
    var handler: (() -> Void)?
    var isSeparatorItem: Bool { false }
    var isEnabled = true
    var submenu: ContextMenu?
    init(_ title: String, handler: (() -> Void)? = nil, itemImage: Int? = nil) {
        self.title = title
        self.handler = handler
    }
}
final class ContextSeparatorItem: ContextMenuItem {
    override var isSeparatorItem: Bool { true }
    init() { super.init("") }
}
final class ContextMenu {
    var items: [ContextMenuItem] = []
    init(betterInside: Bool = false) {}
    func addItem(_ item: ContextMenuItem) { items.append(item) }
}
class View {
    var frame = NSRect(x: 0, y: 0, width: 600, height: 400)
    var bounds: NSRect { frame }
    var needsLayout = false
    func setFrameSize(_ size: NSSize) { frame.size = size }
}
class ImageButton: View {
    var isHidden = false
    var handler: ((ImageButton) -> Void)?
    var contextMenu: (() -> ContextMenu?)?
    var image: Int?
    var text = ""
    var label: String?
    var shows = 0
    func set(image: Int, for state: ControlState) { self.image = image }
    func set(text: String, for state: ControlState) { self.text = text }
    func set(color: Int, for state: ControlState) {}
    func removeImage(for state: ControlState) { image = nil }
    func sizeToFit(_ inset: NSSize, _ size: NSSize, thatFit: Bool) -> NSSize {
        frame.size = NSSize(width: thatFit ? size.width : CGFloat(text.count * 8) + inset.width, height: size.height)
        return frame.size
    }
    func setSingle(handler: @escaping (ImageButton) -> Void, for event: ControlEvent) { self.handler = handler }
    func showContextMenu() { if contextMenu?() != nil { shows += 1 } }
    func setAccessibilityLabel(_ value: String) { label = value }
    func accessibilityPerformShowMenu() -> Bool { showContextMenu(); return true }
    func press() { if !isHidden { handler?(self) } }
}
typealias TextButton = ImageButton
final class StackedBarView: View {
    static let pillHeight: CGFloat = 40
    func insertButton(at index: Int, image: Int, handler: @escaping () -> Void) -> ImageButton { ImageButton() }
    func set(hidden: Bool, for button: ImageButton) { button.isHidden = hidden; needsLayout = true }
    func fit(to width: CGFloat, transition: ContainedViewLayoutTransition) -> CGFloat { width }
    func updateLayout(size: NSSize, transition: ContainedViewLayoutTransition) {}
}
final class TableView: View {
    var completions: [(Bool) -> Void] = []
    func scroll(to state: TableScrollState, completion: @escaping (Bool) -> Void) { completions.append(completion) }
    func finishScroll() { let pending = completions; completions.removeAll(); pending.forEach { $0(true) } }
}
final class TabsView {
    func index(of id: Int64) -> Int? { Int(id) }
    func contains(_ id: Int64) -> Bool { true }
}
final class ContainerView {
    let view = ContentView()
    let tabsView = TabsView()
    var mainView: View?
    var mainTable: TableView? { mainView as? TableView }
    var selecting = false
    func updateMainView(with view: View, animated: PeerMediaAnimationDirection?) { mainView = view }
    func changeState(selectState: Bool, animated: Bool) { selecting = selectState }
    func updateSearchState(_ state: MediaSearchState, updateSearchState: @escaping (Int) -> Void, toggle: @escaping () -> Void) {}
}
final class ContentView: View { var contentBounds: NSRect { bounds } }
final class ValuePromise<T> {
    var value: T
    init(_ value: T, ignoreRepeated: Bool = true) { self.value = value }
    func set(_ value: T) { self.value = value }
}
final class Disposable { func set(_ value: Int?) {} }
struct MediaSearchState {}
struct Signal<T> {
    static func single(_ value: T) -> Self { Self() }
    func start(next: (T) -> Void) -> Int { 0 }
}
protocol PeerMediaSearchable: AnyObject {
    var mediaSearchValue: Signal<MediaSearchState> { get }
    func setSearchValue(_ value: Signal<Int>)
    func setExternalSearch(_ result: Int, _ loadMore: () -> Void)
    func toggleSearch()
}
struct ExternalSearchData { let searchResult = 0; let loadMore: () -> Void = {} }
class ViewController: Equatable {
    static func == (lhs: ViewController, rhs: ViewController) -> Bool { lhs === rhs }
    var view: View = TableView()
    var suppliedMenu: [ContextMenuItem] = []
    func menuItems() -> [ContextMenuItem] { suppliedMenu }
    func viewWillAppear(_ animated: Bool) {}
    func viewDidAppear(_ animated: Bool) {}
    func viewWillDisappear(_ animated: Bool) {}
    func viewDidDisappear(_ animated: Bool) {}
}
