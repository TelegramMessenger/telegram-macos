var emitted: [Date] = []
let value = make(date(2024, 2, 28), selected: { emitted.append($0) })
expect(key(.RightArrow) == .invoked, "right handled")
expect(CalendarUtils.isSameDate(current(value).month.month, date: date(2024, 2, 28), checkDay: false), "right stays in February when next day is February29")
expect(key(.Return) == .invoked, "Return selects a day")
expect(emitted == [date(2024, 2, 29)], "Return confirms next day instead of unchanged selected date")
expect(key(.UpArrow) == .invoked, "Up supports weekly navigation")
expect(key(.DownArrow) == .invoked, "Down supports weekly navigation")
let original = current(value)
expect(key(.LeftArrow, [.control, .option]) == .invokeNext, "VoiceOver arrow passes through")
expect(current(value) === original, "VoiceOver arrow does not change month")
expect(key(.Return, .command) == .invokeNext, "modified Return passes through")
let bounded = make(date(2013, 1, 1))
key(.LeftArrow)
expect(CalendarUtils.isSameDate(current(bounded).month.month, date: date(2013, 1, 1), checkDay: false), "minimum bound preserved")
bounded.viewWillDisappear(false)
expect(window.handlers.isEmpty, "keyboard handlers cleaned up")
NSTimeZone.default = previousZone
print("\(checks) shared regression assertions, \(failures) failures")
exit(failures == 0 ? 0 : 1)
