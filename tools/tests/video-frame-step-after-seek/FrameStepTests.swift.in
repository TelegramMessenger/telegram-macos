import Foundation

var assertions = 0
var failures = 0

func expect(_ condition: @autoclosure () -> Bool, _ name: String) {
    assertions += 1
    if !condition() {
        failures += 1
        print("FAIL: \(name)")
    }
}

func near(_ lhs: Double?, _ rhs: Double) -> Bool {
    guard let lhs else { return false }
    return abs(lhs - rhs) < 0.000001
}

struct MediaPlayerStatus {
    var timestamp: Double
    var duration: Double

    func withUpdatedTimestamp(_ value: Double) -> MediaPlayerStatus {
        var result = self
        result.timestamp = value
        return result
    }
}

final class Player {
    var seeks: [Double] = []
    var plays = 0
    var pauses = 0
    var toggles = 0

    func seek(_ timestamp: Double, play: Bool = false) {
        seeks.append(timestamp)
        if play { plays += 1 }
    }

    func play() { plays += 1 }
    func pause() { pauses += 1 }
    func togglePlayPause() { toggles += 1 }
}

final class TestDisposable {
    var disposed = false
    var onEmit: () -> Void
    init(_ onEmit: @escaping () -> Void) { self.onEmit = onEmit }
    func dispose() { disposed = true }
    func emit() {
        if !disposed { onEmit() }
    }
}

struct FileReference {
    var media: Bool
}

func isHLSVideo(file: Bool) -> Bool { file }

final class Interactions {
    var rewind: (Double) -> Void
    init(rewind: @escaping (Double) -> Void) { self.rewind = rewind }
}

final class VideoView {
    var status: MediaPlayerStatus?
    var mediaPlayer: Player
    var interactions: Interactions?
    var timeline: ((Float) -> Void)?
    var pipTimeline: ((Float) -> Void)?
    var forward: ((Int) -> Void)?
    var backward: ((Int) -> Void)?
    var overlayVisible = false
    var overlayHides = 0

    init(player: Player, timestamp: Double, duration: Double) {
        self.mediaPlayer = player
        self.status = MediaPlayerStatus(timestamp: timestamp, duration: duration)
        timeline = __TIMELINE__
        pipTimeline = __PIP_TIMELINE__
        forward = __FORWARD__
        backward = __BACKWARD__
    }

    func rewindForward() { forward?(0) }
    func rewindBackward() { backward?(0) }
    func hideFrameStepOverlay() {
        overlayVisible = false
        overlayHides += 1
    }
}

final class Controller {
    var frameStepTimestamp: Double?
    var frameStepDisposable: TestDisposable?
    var isPaused = true
    var reference: FileReference
    var mediaPlayer: Player
    var genericView: VideoView
    var previewRequests: [Double] = []
    var rewind: ((Double) -> Void)?
    var scrubPause: (() -> Void)?
    var scrubPlay: (() -> Void)?

    init(timestamp: Double = 5, duration: Double = 165, hls: Bool = false) {
        let player = Player()
        self.mediaPlayer = player
        self.genericView = VideoView(player: player, timestamp: timestamp, duration: duration)
        self.reference = FileReference(media: hls)
        rewind = __REWIND__
        genericView.interactions = Interactions(rewind: rewind!)
        var paused: Bool? = nil
        scrubPause = __SCRUB_PAUSE__
        scrubPlay = __SCRUB_PLAY__
    }

    func activateMediaControls() {}

    func generateFrameStepPreview(at timestamp: Double) {
        previewRequests.append(timestamp)
        frameStepDisposable?.dispose()
        frameStepDisposable = TestDisposable { [weak self] in
            self?.genericView.overlayVisible = true
        }
    }

    __METHODS__
}

let step = 1.0 / 30.0

for hls in [false, true] {
    for forward in [false, true] {
        for target in [0.0, 18.0, 90.0, 165.0] {
            for pip in [false, true] {
                let c = Controller(hls: hls)
                c.stepFrameForward()
                c.stepFrameForward()
                expect(near(c.mediaPlayer.seeks.last, 5 + step * 2), "consecutive steps accumulate without status delivery")
                let oldPreview = c.frameStepDisposable
                oldPreview?.emit()
                c.scrubPause?()
                expect(c.isPaused, "paused scrub stays paused")
                if pip {
                    c.genericView.pipTimeline?(Float(target / 165))
                } else {
                    c.genericView.timeline?(Float(target / 165))
                }
                let selected = c.genericView.status!.timestamp
                expect(abs(selected - target) < 0.00001, "timeline updates current status")
                expect(near(c.frameStepTimestamp, selected), "seek replaces accumulated step origin with requested target")
                expect(near(c.mediaPlayer.seeks.last, selected), "seek passes new target to player")
                expect(!c.genericView.overlayVisible, "seek hides old step overlay")
                if hls {
                    expect(oldPreview?.disposed == true, "seek disposes old preview subscription")
                    expect(c.frameStepDisposable == nil, "seek releases old subscription")
                    oldPreview?.emit()
                    expect(!c.genericView.overlayVisible, "disposed fixture cannot restore stale overlay")
                }
                c.scrubPlay?()
                expect(c.isPaused && c.mediaPlayer.plays == 0, "paused scrub does not resume playback")
                if forward {
                    c.stepFrameForward()
                } else {
                    c.stepFrameBackward()
                }
                let expected = forward ? min(165, selected + step) : max(0, selected - step)
                expect(near(c.mediaPlayer.seeks.last, expected), "frame step uses newly selected position")
                expect(near(c.frameStepTimestamp, expected), "new origin becomes frame-step accumulator")
                if hls {
                    expect(near(c.previewRequests.last, expected), "new HLS preview follows new origin")
                    c.frameStepDisposable?.emit()
                    expect(c.genericView.overlayVisible, "new HLS preview remains enabled")
                }
            }
        }
    }
}

for hls in [false, true] {
    for useController in [false, true] {
        for forward in [false, true] {
            let c = Controller(timestamp: 50, hls: hls)
            c.stepFrameForward()
            let old = c.frameStepDisposable
            old?.emit()
            if useController {
                if forward { c.rewindForward() } else { c.rewindBackward() }
            } else {
                if forward { c.genericView.rewindForward() } else { c.genericView.rewindBackward() }
            }
            let target = forward ? 65.0 : 35.0
            expect(near(c.mediaPlayer.seeks.last, target), "15-second controls retain target")
            expect(near(c.frameStepTimestamp, target), "button seek seeds requested frame-step origin")
            expect(!c.genericView.overlayVisible, "button seek clears old overlay")
            if hls { expect(old?.disposed == true, "button seek cancels frame preview") }
            expect(near(c.genericView.status?.timestamp, 50), "player status remains delayed after button seek")
            c.stepFrameForward()
            expect(near(c.mediaPlayer.seeks.last, target + step), "immediate step uses button target before status delivery")
            c.genericView.status = c.genericView.status?.withUpdatedTimestamp(50)
            c.stepFrameForward()
            expect(near(c.mediaPlayer.seeks.last, target + step * 2), "stale status cannot rewind consecutive frame steps")
            c.genericView.status = c.genericView.status?.withUpdatedTimestamp(target)
            c.stepFrameBackward()
            expect(near(c.mediaPlayer.seeks.last, target + step), "delayed requested status preserves accumulated frame steps")
            if hls { expect(near(c.previewRequests.last, target + step), "HLS preview follows requested target during delayed status") }
        }
    }
}

for hls in [false, true] {
    for forward in [false, true] {
        for target in [0.0, 65.0, 165.0] {
            let c = Controller(timestamp: 50, hls: hls)
            c.stepFrameForward()
            c.rewind?(target)
            expect(near(c.genericView.status?.timestamp, 50), "direct seek does not require immediate status mutation")
            if forward { c.stepFrameForward() } else { c.stepFrameBackward() }
            let expected = forward ? min(165, target + step) : max(0, target - step)
            expect(near(c.mediaPlayer.seeks.last, expected), "direct seek seeds delayed-status step and clamps boundaries")
            if hls { expect(near(c.previewRequests.last, expected), "direct-seek preview uses pending target") }
        }
    }
    let c = Controller(timestamp: 50, hls: hls)
    c.rewind?(65)
    c.rewind?(100)
    c.stepFrameBackward()
    expect(near(c.mediaPlayer.seeks.last, 100 - step), "latest requested seek wins before any status update")
    c.play()
    expect(c.frameStepTimestamp == nil, "resuming playback clears pending seek accumulator")
    c.genericView.status = c.genericView.status?.withUpdatedTimestamp(110)
    c.pause()
    c.stepFrameForward()
    expect(near(c.mediaPlayer.seeks.last, 110 + step), "pause after playback uses fresh status rather than old seek target")
}

let repeated = Controller()
for i in 1...30 {
    repeated.stepFrameForward()
    expect(near(repeated.mediaPlayer.seeks.last, 5 + Double(i) * step), "rapid step \(i) preserves accumulation")
}
for i in 1...30 {
    repeated.stepFrameBackward()
    expect(near(repeated.mediaPlayer.seeks.last, 6 - Double(i) * step), "rapid reverse step \(i) preserves accumulation")
}
let start = Controller(timestamp: 0)
start.stepFrameBackward()
expect(near(start.mediaPlayer.seeks.last, 0), "backward clamps at start")
let end = Controller(timestamp: 165)
end.stepFrameForward()
expect(near(end.mediaPlayer.seeks.last, 165), "forward clamps at end")
let unknown = Controller()
unknown.genericView.status = nil
unknown.stepFrameForward()
unknown.stepFrameBackward()
expect(unknown.mediaPlayer.seeks.isEmpty, "missing status does not seek")
unknown.rewind?(30)
expect(near(unknown.mediaPlayer.seeks.last, 30), "rewind still works without status")

let playing = Controller()
playing.isPaused = false
playing.stepFrameForward()
playing.stepFrameBackward()
expect(playing.mediaPlayer.seeks.isEmpty, "playing frames are not stepped")
playing.scrubPause?()
expect(playing.isPaused && playing.mediaPlayer.pauses == 1, "playing scrub pauses once")
playing.genericView.timeline?(0.5)
playing.scrubPlay?()
expect(!playing.isPaused && playing.mediaPlayer.plays == 1, "playing scrub resumes after seek")
expect(playing.frameStepTimestamp == nil, "play keeps step accumulator reset")

let toggled = Controller()
toggled.stepFrameForward()
toggled.playOrPause()
expect(!toggled.isPaused && toggled.frameStepTimestamp == nil, "toggle playback resets step origin")
toggled.pause()
expect(toggled.isPaused && toggled.frameStepTimestamp == nil, "pause resets step origin")
toggled.play(12)
expect(near(toggled.mediaPlayer.seeks.last, 12) && !toggled.isPaused, "play from timestamp remains supported")

var released: Controller? = Controller(hls: true)
let callback = released?.rewind
weak var weakController = released
released = nil
expect(weakController == nil, "rewind closure does not retain controller")
callback?(25)
expect(weakController == nil, "late callback tolerates missing controller")

print("\(assertions) assertions; \(failures) failures")
exit(failures == 0 ? 0 : 1)
