class Control: NSView {
    static var lastHandledClickTimestamp: CFTimeInterval?
    static weak var currentEventSource: Control?
    var scaleOnClick = false
    var scaleDownOnClick = false
    var isEnabled = true
    var userInteractionEnabled = true
    var glassTouchEffect: TouchEffect?
    var interactiveGlassView: NSView?
    var glassTouchInitialLocation: NSPoint?
    var mouseDownWindowOrigin: NSPoint?
    var longInvoked = false
    var contextMenu: (() -> Int)?
    var handlers: [Handler] = []
    var sendRightMouseAnyway = false
    var handleLongEvent = false
    var moveNextEventDeep = false
    let longHandleDisposable = Disposable()
    var controlIsHidden: Bool { isHidden }
    var mouseIsDown = false
    var mouseMovedInside = true
    var canHighlight = true
    var pointerInside = true
    var previousState: ControlState?
    var controlState: ControlState = .Normal {
        didSet { stateDidUpdate(controlState) }
    }
    override init(frame: NSRect) {
        super.init(frame: frame)
        wantsLayer = true
        layer?.anchorPoint = .zero
    }
    required init?(coder: NSCoder) { fatalError() }
    override var isFlipped: Bool { true }
    func mouseInside() -> Bool { pointerInside }
    func cancelLongOver() {}
    func invokeLongDown(_ event: NSEvent, point: NSPoint) {}
    __STATE_UPDATE__
    __MOUSE_DOWN__
    __MOUSE_UP__
    __UPDATE_STATE__
    __SEND__
}

protocol AccountContextProtocol {}
struct Context: AccountContextProtocol {}

final class Arguments {
    var avatarExpandedDidChange: (() -> Void)?
}

final class PeerInfoHeadItem<C: AccountContextProtocol> {
    var isAvatarExpanded = false
    let arguments = Arguments()
    var update: (() -> Void)?
    func noteHeightOfRow(animated: Bool) { update?() }
}

final class Header {
    let photoContainer = Control(frame: NSRect(x: 0, y: 0, width: 120, height: 120))
    let model = PeerInfoHeadItem<Context>()
    var item: AnyObject?
    var isTogglingAvatar = false
    var avatarPullProgress: CGFloat = 0
    let stripHeight: CGFloat
    let musicView = NSView()
    var tintUpdates = 0

    init(stripHeight: CGFloat) {
        self.stripHeight = stripHeight
        item = model
        model.update = { [weak self] in self?.updateHeader() }
        model.arguments.avatarExpandedDidChange = { [weak self] in self?.tintUpdates += 1 }
        photoContainer.handlers = [Handler(event: .Click, handler: { [weak self] _ in
            guard let self, !self.model.isAvatarExpanded else { return }
            self.setAvatarExpanded(true)
        })]
        updateHeader()
    }

    func updateHeader() {
        photoContainer.scaleOnClick = !model.isAvatarExpanded
        photoContainer.frame = model.isAvatarExpanded ? NSRect(x: 0, y: 0, width: 480, height: 360) : NSRect(x: 180, y: 20, width: 120, height: 120)
        musicView.frame = NSRect(x: 0, y: model.isAvatarExpanded ? 360 : 300, width: 480, height: stripHeight)
        updateSpawnerFraction()
    }

    func updateSpawnerFraction() {
        let scale = 1 + avatarPullProgress * 0.15
        var transform = CATransform3DIdentity
        transform = CATransform3DTranslate(transform, photoContainer.frame.width / 2, photoContainer.frame.height / 2, 0)
        transform = CATransform3DScale(transform, scale, scale, 1)
        transform = CATransform3DTranslate(transform, -photoContainer.frame.width / 2, -photoContainer.frame.height / 2, 0)
        photoContainer.layer?.transform = scale == 1 ? CATransform3DIdentity : transform
    }

    func expandBySwipe() {
        avatarPullProgress = 0
        updateSpawnerFraction()
        setAvatarExpanded(true)
        finishTransition()
    }

    func collapseBySwipe() {
        avatarPullProgress = 0
        updateSpawnerFraction()
        setAvatarExpanded(false)
        finishTransition()
    }

    __SET_EXPANDED__
}

var failures: [String] = []
var checks: [String] = []
func check(_ value: Bool, _ name: String) {
    checks.append(name)
    if !value { failures.append(name) }
}

func event(_ type: NSEvent.EventType) -> NSEvent {
    NSEvent.mouseEvent(with: type, location: NSPoint(x: 60, y: 60), modifierFlags: [], timestamp: ProcessInfo.processInfo.systemUptime, windowNumber: 0, context: nil, eventNumber: 1, clickCount: 1, pressure: type == .leftMouseDown ? 1 : 0)!
}

func press(_ control: Control) {
    control.mouseIsDown = true
    control.mouseDown(with: event(.leftMouseDown))
}

func release(_ control: Control) {
    control.mouseIsDown = false
    control.mouseUp(with: event(.leftMouseUp))
}

func animationScale(_ control: Control) -> CGFloat? {
    guard let animation = control.layer?.animation(forKey: "transform") as? CABasicAnimation,
          let transform = animation.toValue as? NSValue else { return nil }
    return transform.caTransform3DValue.m22
}

func effectiveBottom(_ header: Header) -> CGFloat {
    let transform: CATransform3D
    if let animation = header.photoContainer.layer?.animation(forKey: "transform") as? CABasicAnimation,
       !animation.isRemovedOnCompletion,
       let value = animation.toValue as? NSValue {
        transform = value.caTransform3DValue
    } else {
        transform = header.photoContainer.layer!.transform
    }
    return header.photoContainer.bounds.height * transform.m22 + transform.m42
}

let ordinary = Control(frame: NSRect(x: 0, y: 0, width: 120, height: 120))
ordinary.scaleOnClick = true
press(ordinary)
check(animationScale(ordinary) == 1.03, "ordinary press installs 1.03 animation")
release(ordinary)
check(animationScale(ordinary) == 1, "ordinary release restores unit scale")
check(ordinary.layer?.animation(forKey: "transform")?.isRemovedOnCompletion == true, "ordinary release animation is removable")

var outcomes: [[String: Any]] = []
for stripHeight: CGFloat in [20, 24] {
    let header = Header(stripHeight: stripHeight)
    let sibling = Control(frame: NSRect(x: 0, y: 0, width: 24, height: 24))
    sibling.scaleOnClick = true
    press(sibling)
    press(header.photoContainer)
    check(animationScale(header.photoContainer) == 1.03, "avatar press starts before expansion \(stripHeight)")
    release(header.photoContainer)
    finishTransition()
    let bottom = effectiveBottom(header)
    check(header.model.isAvatarExpanded, "click expands synchronously \(stripHeight)")
    check(!header.photoContainer.scaleOnClick, "expanded press scaling disabled \(stripHeight)")
    check(header.photoContainer.layer?.animation(forKey: "transform") == nil, "click expansion removes retained press transform \(stripHeight)")
    check(bottom <= header.musicView.frame.minY, "photo does not extend into music strip \(stripHeight)")
    check(animationScale(sibling) == 1.03, "unrelated control press unchanged \(stripHeight)")
    header.updateSpawnerFraction()
    check(effectiveBottom(header) <= header.musicView.frame.minY, "scroll refresh preserves separation \(stripHeight)")
    header.collapseBySwipe()
    header.expandBySwipe()
    check(header.photoContainer.layer?.animation(forKey: "transform") == nil, "subsequent swipe does not retain click scale \(stripHeight)")
    check(header.tintUpdates == 6, "existing transition callbacks preserved \(stripHeight)")
    outcomes.append(["strip_height": stripHeight, "photo_bottom_after_click": bottom, "music_top": header.musicView.frame.minY])

    let fresh = Header(stripHeight: stripHeight)
    fresh.avatarPullProgress = 0.5
    fresh.updateSpawnerFraction()
    check(abs(fresh.photoContainer.layer!.transform.m22 - 1.075) < 0.00001, "pull feedback before toggle preserved \(stripHeight)")
    fresh.expandBySwipe()
    check(fresh.photoContainer.layer?.animation(forKey: "transform") == nil, "fresh swipe has no press animation \(stripHeight)")
    check(effectiveBottom(fresh) <= fresh.musicView.frame.minY, "fresh swipe keeps music separation \(stripHeight)")
}

let output: [String: Any] = ["checks": checks, "failures": failures, "outcomes": outcomes]
let data = try JSONSerialization.data(withJSONObject: output, options: [.sortedKeys])
print(String(data: data, encoding: .utf8)!)
exit(failures.isEmpty ? 0 : 1)
