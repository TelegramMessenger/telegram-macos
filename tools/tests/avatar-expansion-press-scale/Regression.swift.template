public enum ControlState {
    case Normal, Hover, Highlight
}

public enum ControlEvent {
    case Down, Up, RightDown, RightUp, LongMouseUp, SingleClick, DoubleClick, Click
}

struct Handler {
    let event: ControlEvent
    let handler: (Control) -> Void
}

final class Disposable {
    func set(_ value: Any?) {}
}

final class Queue {
    static func mainQueue() -> Queue { Queue() }
}

struct Signal<Value, Failure> {
    static func single(_ value: Value) -> Signal<Value, Failure> { Signal() }
    func start(next: @escaping (Value) -> Void) -> Disposable { Disposable() }
}

infix operator |>: AdditionPrecedence
func |> <T, U>(value: T, operation: (T) -> U) -> U { operation(value) }
func delay<V, F>(_ seconds: Double, queue: Queue) -> (Signal<V, F>) -> Signal<V, F> { { $0 } }
var delayedActions: [() -> Void] = []
func delay(_ seconds: Double, _ action: @escaping () -> Void) { delayedActions.append(action) }
func finishTransition() {
    let actions = delayedActions
    delayedActions.removeAll()
    for action in actions { action() }
}

final class TouchEffect {
    func setStretchVector(_ value: CGPoint, animated: Bool) {}
    func setIsTracking(_ value: Bool) {}
}

enum AppMenu {
    static func show(menu: Int, event: NSEvent, for view: NSView) {}
}

enum System {
    static let backingScale: CGFloat = 2
}

func floorToScreenPixels(_ scale: CGFloat, _ value: CGFloat) -> CGFloat { floor(value * scale) / scale }

