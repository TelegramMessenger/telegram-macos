struct AccessHash {
    let value: Int64
}

enum Namespaces {
    enum Peer {
        static let CloudUser = PeerId.Namespace._internalFromInt32Value(0)
        static let CloudGroup = PeerId.Namespace._internalFromInt32Value(1)
        static let CloudChannel = PeerId.Namespace._internalFromInt32Value(2)
    }
}

class ReferencePeer: Peer {
    let id: PeerId
    let accessHash: AccessHash?
    init(_ value: Int64, namespace: PeerId.Namespace, hash: Int64? = nil) {
        id = PeerId(namespace: namespace, id: ._internalFromInt64Value(value))
        accessHash = hash.map(AccessHash.init)
    }
    func isEqual(_ other: Peer) -> Bool { id == other.id }
}
final class TelegramUser: ReferencePeer {}
final class TelegramGroup: ReferencePeer {}
final class TelegramChannel: ReferencePeer {}
final class TelegramCommunity: ReferencePeer {}

enum PeerReference {
    case user(id: Int64, accessHash: Int64)
    case group(id: Int64)
    case channel(id: Int64, accessHash: Int64)
__PEER_REFERENCE_INIT__
}

enum Api {
    struct User { let userId: Int64; let accessHash: Int64 }
    struct Chat { let chatId: Int64 }
    struct Channel { let channelId: Int64; let accessHash: Int64 }
    enum InputPeer {
        case inputPeerUser(User)
        case inputPeerChat(Chat)
        case inputPeerChannel(Channel)
        var resultPeer: Peer {
            switch self {
            case let .inputPeerUser(value): return .peerUser(.init(userId: value.userId))
            case let .inputPeerChat(value): return .peerChat(.init(chatId: value.chatId))
            case let .inputPeerChannel(value): return .peerChannel(.init(channelId: value.channelId))
            }
        }
    }
    struct PeerUser { let userId: Int64 }
    struct PeerChat { let chatId: Int64 }
    struct PeerChannel { let channelId: Int64 }
    enum Peer {
        case peerUser(PeerUser)
        case peerChat(PeerChat)
        case peerChannel(PeerChannel)
    }
    struct Filter { let filterId: Int32 }
    enum InputChatlist {
        case inputChatlistDialogFilter(Filter)
    }
    struct Invite {
        let flags: Int32
        let title: String
        let url: String
        let peers: [Peer]
    }
    enum ExportedChatlistInvite {
        case exportedChatlistInvite(Invite)
    }
    struct Request {
        let flags: Int32
        let chatlist: InputChatlist
        let slug: String
        let title: String?
        let peers: [InputPeer]?
    }
    enum functions {
        enum chatlists {
            static func editExportedInvite(flags: Int32, chatlist: InputChatlist, slug: String, title: String?, peers: [InputPeer]?) -> Request {
                return Request(flags: flags, chatlist: chatlist, slug: slug, title: title, peers: peers)
            }
        }
    }
}

enum RequestError: Error { case failure }
final class Transaction {
    var peers: [PeerId: Peer]
    init(_ peers: [PeerId: Peer]) { self.peers = peers }
    func getPeer(_ id: PeerId) -> Peer? { peers[id] }
}
final class Postbox {
    var peers: [PeerId: Peer] = [:]
    var pending: [() -> Void] = []
    var reads = 0
    func transaction<T>(_ body: @escaping (Transaction) -> T) -> Signal<T, NoError> {
        return Signal { subscriber in
            var cancelled = false
            self.pending.append {
                guard !cancelled else { return }
                self.reads += 1
                subscriber.putNext(body(Transaction(self.peers)))
                subscriber.putCompletion()
            }
            return ActionDisposable { cancelled = true }
        }
    }
    func flushOne() {
        if !pending.isEmpty { pending.removeFirst()() }
    }
    func flush() {
        while !pending.isEmpty { flushOne() }
    }
}
final class Network {
    var requests: [Api.Request] = []
    var completion: (() -> Void)?
    var fail = false
    var originalIds: [PeerId] = []
    func request(_ value: Api.Request) -> Signal<Api.ExportedChatlistInvite, RequestError> {
        return Signal { subscriber in
            self.requests.append(value)
            var cancelled = false
            self.completion = {
                guard !cancelled else { return }
                if self.fail {
                    subscriber.putError(.failure)
                } else {
                    let peers: [Api.Peer]
                    if let inputs = value.peers {
                        peers = inputs.map { $0.resultPeer }
                    } else {
                        peers = self.originalIds.map { .peerChat(.init(chatId: $0.id._internalGetInt64Value())) }
                    }
                    subscriber.putNext(.exportedChatlistInvite(.init(flags: 0, title: value.title ?? "Original", url: "https://t.me/addlist/local-test", peers: peers)))
                    subscriber.putCompletion()
                }
            }
            return ActionDisposable { cancelled = true }
        }
    }
    func finish() {
        let f = completion
        completion = nil
        f?()
    }
}
final class Account {
    let postbox = Postbox()
    let network = Network()
}
final class EnginePeers {
    let account: Account
    init(_ account: Account) { self.account = account }
    func editChatFolderLink(filterId: Int32, link: ExportedChatFolderLink, title: String?, peerIds: [EnginePeer.Id]?, revoke: Bool) -> Signal<ExportedChatFolderLink, EditChatFolderLinkError> {
        return _internal_editChatFolderLink(account: account, filterId: filterId, link: link, title: title, peerIds: peerIds, revoke: revoke)
    }
}
final class Engine {
    let peers: EnginePeers
    init(_ account: Account) { peers = EnginePeers(account) }
}
protocol AccountContextProtocol: AnyObject {
    var account: Account { get }
    var engine: Engine { get }
}
final class TestContext: AccountContextProtocol {
    let account = Account()
    lazy var engine = Engine(account)
}

__ENGINE_REQUEST__

__EDIT_PRODUCTION__

func invokeEdit(context: TestContext, current: ExportedChatFolderLink, selected: Set<PeerId>) -> Signal<ExportedChatFolderLink, FolderSharingLinkEditError> {
    return __EDIT_REQUEST__
}

final class SaveReplay {
    let context = TestContext()
    let original: ExportedChatFolderLink
    var state: FolderSharingLinkState
    var events: [String] = []
    var unresolved: [PeerId] = []
    var result: ExportedChatFolderLink?
    var disposable: Disposable?

    init(originalIds: [PeerId], selected: Set<PeerId>, title: String = "Original") {
        original = ExportedChatFolderLink(title: "Original", link: "https://t.me/addlist/local-test", peerIds: originalIds, isRevoked: false)
        state = FolderSharingLinkState(filter: ChatListFilter(), link: ExportedChatFolderLink(title: title, link: original.link, peerIds: originalIds, isRevoked: false), selected: selected)
        context.account.network.originalIds = originalIds
    }

    func save() {
        folderSharingSaveLink(state: state, original: original, edit: { current, selected, success, failure in
            self.events.append("edit")
            self.disposable = invokeEdit(context: self.context, current: current, selected: selected).start(next: success, error: { error in
                switch error {
                case let .unresolvedPeers(ids):
                    self.unresolved = ids
                    self.events.append("unresolved")
                case .generic:
                    failure()
                }
            })
        }, updated: { _, result in self.result = result; self.events.append("updated") }, success: { self.events.append("success") }, failure: { self.events.append("failure") }, delete: { self.events.append("delete") }, close: { self.events.append("close") })
    }
}

final class FolderSharingRequestTests: XCTestCase {
    func group(_ id: Int64) -> TelegramGroup { TelegramGroup(id, namespace: Namespaces.Peer.CloudGroup) }
    func channel(_ id: Int64, hash: Int64? = 123) -> TelegramChannel { TelegramChannel(id, namespace: Namespaces.Peer.CloudChannel, hash: hash) }

    func testMissingOriginalPlusAddedChatDoesNotSendOrClose() {
        let a = group(1), b = group(2)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id, b.id])
        replay.context.account.postbox.peers = [b.id: b]
        replay.save()
        replay.context.account.postbox.flush()
        let requestedIds = replay.context.account.network.requests.flatMap { $0.peers ?? [] }.map { $0.resultPeer.peerId.toInt64() }
        print("UNRESOLVED_ORIGINAL_TRACE selected=\(replay.state.selected.map { $0.toInt64() }.sorted()) requested=\(requestedIds) unresolved=\(replay.unresolved.map { $0.toInt64() }) events=\(replay.events)")
        XCTAssertEqual(replay.unresolved, [a.id])
        XCTAssertTrue(replay.context.account.network.requests.isEmpty)
        XCTAssertEqual(replay.events, ["edit", "unresolved"])
        XCTAssertEqual(replay.state.selected, [a.id, b.id])
        XCTAssertNil(replay.result)
    }

    func testMissingAccessHashIsRejectedLikeCoreConversion() {
        let a = channel(1, hash: nil), b = group(2)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id, b.id])
        replay.context.account.postbox.peers = [a.id: a, b.id: b]
        replay.save()
        replay.context.account.postbox.flush()
        XCTAssertEqual(replay.unresolved, [a.id])
        XCTAssertTrue(replay.context.account.network.requests.isEmpty)
        XCTAssertFalse(replay.events.contains("close"))
    }

    func testEverySelectedIdIsValidatedNotOnlyOriginalIds() {
        let a = group(1), b = channel(2, hash: nil), c = group(3)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id, b.id, c.id])
        replay.context.account.postbox.peers = [a.id: a, b.id: b]
        replay.save()
        replay.context.account.postbox.flush()
        XCTAssertEqual(Set(replay.unresolved), [b.id, c.id])
        XCTAssertTrue(replay.context.account.network.requests.isEmpty)
    }

    func testAllResolvedPeersReachTheActualCoreRequest() {
        let a = group(1), b = channel(2)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id, b.id])
        replay.context.account.postbox.peers = [a.id: a, b.id: b]
        replay.save()
        replay.context.account.postbox.flush()
        XCTAssertEqual(replay.context.account.network.requests.count, 1)
        let request = replay.context.account.network.requests.first!
        XCTAssertEqual(Set(request.peers!.map { $0.resultPeer.peerId }), [a.id, b.id])
        XCTAssertEqual(request.flags & (1 << 2), 1 << 2)
        XCTAssertEqual(replay.events, ["edit"])
        replay.context.account.network.finish()
        XCTAssertEqual(replay.events, ["edit", "updated", "close", "success"])
        XCTAssertEqual(Set(replay.result!.peerIds), [a.id, b.id])
    }

    func testRenameOnlyOmitsPeersEvenIfOriginalCannotBeLoaded() {
        let a = group(1)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id], title: "Renamed")
        replay.save()
        replay.context.account.postbox.flush()
        XCTAssertEqual(replay.context.account.network.requests.count, 1)
        XCTAssertNil(replay.context.account.network.requests.first!.peers)
        XCTAssertEqual(replay.context.account.network.requests.first!.flags & (1 << 2), 0)
        XCTAssertEqual(replay.events, ["edit"])
        replay.context.account.network.finish()
        XCTAssertEqual(replay.result?.peerIds, [a.id])
    }

    func testServerFailureKeepsSelectionAndEditorOpen() {
        let a = group(1), b = group(2)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id, b.id])
        replay.context.account.postbox.peers = [a.id: a, b.id: b]
        replay.context.account.network.fail = true
        replay.save()
        replay.context.account.postbox.flush()
        replay.context.account.network.finish()
        XCTAssertEqual(replay.events, ["edit", "failure"])
        XCTAssertEqual(replay.state.selected, [a.id, b.id])
        XCTAssertNil(replay.result)
    }

    func testRetryAfterResolutionKeepsBothChats() {
        let a = group(1), b = group(2)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id, b.id])
        replay.context.account.postbox.peers = [b.id: b]
        replay.save()
        replay.context.account.postbox.flush()
        XCTAssertTrue(replay.context.account.network.requests.isEmpty)
        replay.context.account.postbox.peers[a.id] = a
        replay.save()
        replay.context.account.postbox.flush()
        replay.context.account.network.finish()
        XCTAssertEqual(replay.context.account.network.requests.count, 1)
        XCTAssertEqual(Set(replay.result!.peerIds), [a.id, b.id])
    }

    func testPendingValidationUsesCapturedSelection() {
        let a = group(1), b = group(2), c = group(3)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id, b.id])
        replay.context.account.postbox.peers = [b.id: b, c.id: c]
        replay.save()
        replay.state.selected = [b.id, c.id]
        replay.context.account.postbox.flush()
        XCTAssertEqual(replay.unresolved, [a.id])
        XCTAssertTrue(replay.context.account.network.requests.isEmpty)
    }

    func testCancellationBeforeValidationDoesNotSendOrClose() {
        let a = group(1), b = group(2)
        let replay = SaveReplay(originalIds: [a.id], selected: [a.id, b.id])
        replay.context.account.postbox.peers = [a.id: a, b.id: b]
        replay.save()
        replay.disposable?.dispose()
        replay.context.account.postbox.flush()
        XCTAssertTrue(replay.context.account.network.requests.isEmpty)
        XCTAssertEqual(replay.events, ["edit"])
    }

    func testRepresentablePeerKindsMatchPinnedCoreInputConversion() {
        let values: [Peer] = [group(1), channel(2), channel(3, hash: nil), TelegramUser(4, namespace: Namespaces.Peer.CloudUser, hash: 456), TelegramUser(5, namespace: Namespaces.Peer.CloudUser), TelegramCommunity(6, namespace: Namespaces.Peer.CloudChannel, hash: 789), TestPeer(7)]
        for peer in values {
            XCTAssertEqual(PeerReference(peer) != nil, apiInputPeer(peer) != nil)
        }
    }
}
