import AppKit

protocol Disposable {
    func dispose()
}

final class ActionDisposable: Disposable {
    private var action: (() -> Void)?

    init(_ action: @escaping () -> Void = {}) {
        self.action = action
    }

    func dispose() {
        let action = self.action
        self.action = nil
        action?()
    }
}

final class MetaDisposable: Disposable {
    private var current: Disposable?

    func set(_ disposable: Disposable?) {
        current?.dispose()
        current = disposable
    }

    func dispose() {
        set(nil)
    }
}

enum NoError: Error {
}

struct Signal<Value, Failure> {
    let subscribe: (@escaping (Value) -> Void) -> Disposable

    func start(next: @escaping (Value) -> Void) -> Disposable {
        subscribe(next)
    }

    static func single(_ value: Value) -> Signal {
        Signal { next in
            next(value)
            return ActionDisposable()
        }
    }

    static func never() -> Signal {
        Signal { _ in ActionDisposable() }
    }
}

infix operator |> : AdditionPrecedence

func |> <T, U>(value: T, transform: (T) -> U) -> U {
    transform(value)
}

func map<T, U, E>(_ transform: @escaping (T) -> U) -> (Signal<T, E>) -> Signal<U, E> {
    { signal in
        Signal { next in signal.start(next: { next(transform($0)) }) }
    }
}

func mapToSignal<T, U, E>(_ transform: @escaping (T) -> Signal<U, E>) -> (Signal<T, E>) -> Signal<U, E> {
    { signal in
        Signal { next in
            let inner = MetaDisposable()
            let outer = signal.start(next: { value in
                inner.set(nil)
                inner.set(transform(value).start(next: next))
            })
            return ActionDisposable {
                outer.dispose()
                inner.dispose()
            }
        }
    }
}

final class Queue {
    static let main = Queue()
    var tasks: [() -> Void] = []

    static func mainQueue() -> Queue { main }

    func drain() {
        while !tasks.isEmpty {
            tasks.removeFirst()()
        }
    }
}

final class Cancellation {
    var cancelled = false
}

func delay<T, E>(_ seconds: Double, queue: Queue) -> (Signal<T, E>) -> Signal<T, E> {
    { signal in
        Signal { next in
            let cancellation = Cancellation()
            let disposable = signal.start(next: { value in
                queue.tasks.append {
                    if !cancellation.cancelled {
                        next(value)
                    }
                }
            })
            return ActionDisposable {
                cancellation.cancelled = true
                disposable.dispose()
            }
        }
    }
}

func deliverOnMainQueue<T, E>(_ signal: Signal<T, E>) -> Signal<T, E> { signal }

final class ValuePromise<Value: Equatable> {
    private var value: Value?
    private let ignoreRepeated: Bool
    private var observers: [UUID: (Value) -> Void] = [:]

    init(ignoreRepeated: Bool = false) {
        self.value = nil
        self.ignoreRepeated = ignoreRepeated
    }

    init(_ value: Value, ignoreRepeated: Bool = false) {
        self.value = value
        self.ignoreRepeated = ignoreRepeated
    }

    func set(_ value: Value) {
        if ignoreRepeated && self.value == value {
            return
        }
        self.value = value
        for observer in Array(observers.values) {
            observer(value)
        }
    }

    func get() -> Signal<Value, NoError> {
        Signal { next in
            let id = UUID()
            self.observers[id] = next
            if let value = self.value {
                next(value)
            }
            return ActionDisposable { self.observers.removeValue(forKey: id) }
        }
    }
}

class InterfaceObserver {
    var changes = 0

    func notifyObservers(value: Any, oldValue: Any, animated: Bool) {
        changes += 1
    }
}

