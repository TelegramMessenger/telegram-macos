struct Message {
    let id: Int
    let author: PeerId
    let text: String
    var extendedMedia: Any? = nil
}

func isEqualMessages(_ lhs: Message, _ rhs: Message) -> Bool {
    lhs.id == rhs.id && lhs.author == rhs.author && lhs.text == rhs.text
}

