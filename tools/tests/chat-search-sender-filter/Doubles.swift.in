    let messages: [Message]

    init(_ query: String, _ messages: [Message]) {
        self.query = query
        self.messages = messages
    }
}

final class LoadingMessage {
    var value = false

    func set(_ signal: Signal<Bool, NoError>) {
        _ = signal.start(next: { self.value = $0 })
    }
}

final class ChatInteraction {
    var movePeerToInput: (Peer) -> Void = { _ in }
    var presentation = Presentation()
    var chatLocation: ChatLocation = .peer(100)
    var mode = ChatMode()
    let loadingMessage = LoadingMessage()
    var results = SearchMessagesResultState("", [])

    func updateSearchRequest(_ results: SearchMessagesResultState) {
        self.results = results
    }

    func setLocationTag(_ tag: Int?) {}
}

enum SearchMessagesLocation {
    case peer(peerId: PeerId, fromId: PeerId?, tags: Int?, reactions: [Int], threadId: Int64?, minDate: Int?, maxDate: Int?)

    var fromId: PeerId? {
        switch self {
        case let .peer(_, fromId, _, _, _, _, _):
            return fromId
        }
    }

    var threadId: Int64? {
        switch self {
        case let .peer(_, _, _, _, threadId, _, _):
            return threadId
        }
    }
}

struct EngineSearchResult {
    let messages: [Message]
    let totalCount: Int
}

struct SearchRequest {
    let location: SearchMessagesLocation
    let query: String
    let state: SearchMessagesState?
}

final class EngineMessages {
    var requests: [SearchRequest] = []
    var deferResponses = false
    var pending: [() -> Void] = []
    let fixtures = [Message(id: 1, author: 10, text: "shared needle"), Message(id: 2, author: 20, text: "shared needle"), Message(id: 3, author: 10, text: "different")]

    func searchMessages(location: SearchMessagesLocation, query: String, state: SearchMessagesState?) -> Signal<(EngineSearchResult, SearchMessagesState?), NoError> {
        Signal { next in
            let cancellation = Cancellation()
            self.requests.append(SearchRequest(location: location, query: query, state: state))
            let messages = self.fixtures.filter { message in
                (location.fromId == nil || location.fromId == message.author) && (query.isEmpty || message.text.contains(query))
            }
            let respond = {
                if !cancellation.cancelled {
                    next((EngineSearchResult(messages: messages, totalCount: messages.count), SearchMessagesState(page: 1)))
                }
            }
            if self.deferResponses {
                self.pending.append(respond)
            } else {
                respond()
            }
            return ActionDisposable { cancellation.cancelled = true }
        }
    }

    func respond() {
        let pending = self.pending
        self.pending.removeAll()
        pending.forEach { $0() }
    }
}

struct Engine {
    let messages = EngineMessages()
}

protocol AccountContextProtocol: AnyObject {
}

final class Context: AccountContextProtocol {
    let engine = Engine()
}

final class ChatSearchInteractions {
    var searchRequest: (String, PeerId?, SearchMessagesState?, [EmojiTag]) -> Signal<([Message], SearchMessagesState?, Int), NoError> = { _, _, _, _ in .never() }
    var jump: (Message) -> Void = { _ in }
}
