import Foundation

public struct ItemCollectionId: Hashable {
    public let namespace: Int32
    public let id: Int64
}
struct Namespaces {
    struct ItemCollection {
        static let CloudStickerPacks: Int32 = 1
        static let CloudEmojiPacks: Int32 = 2
    }
}
@@MODELS@@
struct StickerPackCollectionInfo {
    let id: ItemCollectionId
    let flags: StickerPackCollectionInfoFlags
    let accessHash: Int64
    let title: String
    let shortName: String
}
struct StickerPackItem { let token: Int }
struct TelegramMediaFile { let fileId: ItemCollectionId }
@@PREVIEW@@
@@OWN@@

final class Atomic<Value> {
    private var value: Value
    init(value: Value) { self.value = value }
    func with<Result>(_ body: (Value) -> Result) -> Result { body(value) }
    @discardableResult func modify(_ body: (Value) -> Value) -> Value { value = body(value); return value }
    @discardableResult func swap(_ next: Value) -> Value { let old = value; value = next; return old }
}
enum Request: Equatable {
    case add(Int64)
    case remove(Int64)
    case delete(Int64)
}
final class Recorder {
    var requests: [Request] = []
    var pending: [() -> Void] = []
    var installed: Set<Int64> = []
    var closeCount = 0
    var onAddCount = 0
    var confirmations = 0
    var toasts: [String] = []
    func flush() {
        let work = pending
        pending.removeAll()
        work.forEach { $0() }
    }
}
final class Signal {
    let body: () -> Void
    init(_ body: @escaping () -> Void) { self.body = body }
    @discardableResult func start() -> Int { body(); return 0 }
}
func combineLatest(_ signals: [Signal]) -> Signal { Signal { signals.forEach { $0.start() } } }
final class Stickers {
    let recorder: Recorder
    init(_ recorder: Recorder) { self.recorder = recorder }
    func addStickerPackInteractively(info: StickerPackCollectionInfo, items: [StickerPackItem]) -> Signal {
        Signal {
            self.recorder.requests.append(.add(info.id.id))
            self.recorder.pending.append { self.recorder.installed.insert(info.id.id) }
        }
    }
    func removeStickerPackInteractively(id: ItemCollectionId, option: RemoveStickerPackOption) -> Signal {
        precondition(option == .archive)
        return Signal {
            self.recorder.requests.append(.remove(id.id))
            self.recorder.pending.append { self.recorder.installed.remove(id.id) }
        }
    }
    func deleteStickerSet(packReference: StickerPackReference) -> Signal {
        guard case let .id(id, _) = packReference else { fatalError("Expected pack id") }
        return Signal {
            self.recorder.requests.append(.delete(id))
            self.recorder.pending.append { self.recorder.installed.remove(id) }
        }
    }
}
final class Engine {
    let stickers: Stickers
    init(_ recorder: Recorder) { stickers = Stickers(recorder) }
}
final class Context {
    let window: Recorder
    let engine: Engine
    let meUrlPrefix = "https://example.com/"
    init(_ recorder: Recorder) { window = recorder; engine = Engine(recorder) }
}
struct Presentation { func end() {} }
struct AnalyticsContext {
    func beginPresentation() -> Presentation { Presentation() }
    func preservingPresentation(_ signal: Signal) -> Signal { signal }
}
func showModalText(for window: Recorder, text: String, title: String) { window.toasts.append(title) }
func verifyAlert(for window: Recorder, header: String, information: String, ok: String, successHandler: (Bool) -> Void, onDeinit: () -> Void) {
    window.confirmations += 1
    successHandler(true)
    onDeinit()
}
@dynamicMemberLookup struct Strings {
    subscript(dynamicMember name: String) -> String { name }
    func stickerPackAddedInfo(_ name: String) -> String { "sticker-added-" + name }
    func emojiPackAddedInfo(_ name: String) -> String { "emoji-added-" + name }
    func stickerPackRemovedInfo(_ name: String) -> String { "sticker-removed-" + name }
    func emojiPackRemovedInfo(_ name: String) -> String { "emoji-removed-" + name }
    func emojiPackSetsAddOther(_ count: Int) -> String { "emoji-add-\(count)" }
    func stickerPackAdd1Other(_ count: Int) -> String { "sticker-add-\(count)" }
    func stickerPackSetsAdd1Other(_ count: Int) -> String { "sticker-sets-add-\(count)" }
}
func strings() -> Strings { Strings() }
enum MenuAnimation {
    case menu_share, menu_list, menu_edit, menu_delete
    var value: Int { 0 }
}
enum ItemMode { case destruct }
class ContextMenuItem {
    let title: String
    let handler: (() -> Void)?
    var submenu: ContextMenu?
    init(_ title: String, handler: (() -> Void)? = nil, itemMode: ItemMode? = nil, itemImage: Int? = nil) {
        self.title = title
        self.handler = handler
    }
}
final class ContextSeparatorItem: ContextMenuItem {
    init() { super.init("separator") }
}
final class ContextMenu {
    var items: [ContextMenuItem] = []
    func addItem(_ item: ContextMenuItem) { items.append(item) }
}
struct EntertainmentUIHooks {
    static let shared = EntertainmentUIHooks()
    func openStickersBotObserved(_ context: Context, analyticsContext: AnalyticsContext) {}
}
extension String { var trimmed: String { trimmingCharacters(in: .whitespacesAndNewlines) } }
private final class Arguments {
    var addpack: (PreviewState.Source, PreviewState.Collection, Bool) -> Void = { _, _, _ in }
    var addAll: (PreviewState.Source, [PreviewState.Collection], Bool) -> Void = { _, _, _ in }
    var share: (String) -> Void = { _ in }
}
private final class Session {
    let recorder: Recorder
    let stateValue: Atomic<State>
    let updateState: ((State) -> State) -> Void
    let arguments: Arguments
    let pendingAddAction = Atomic<(() -> Void)?>(value: nil)
    let controllerSource: StickerPackPreviewModalSource
    let setEditing: (Bool) -> Void
    let menu: () -> [ContextMenuItem]
    init(source: PreviewState.Source, collections: [PreviewState.Collection], controllerSource: StickerPackPreviewModalSource = .install) {
        self.controllerSource = controllerSource
        let recorder = Recorder()
        recorder.installed = Set(collections.filter(\.installed).map { $0.info.id.id })
        self.recorder = recorder
        let context = Context(recorder)
        let stateValue = Atomic(value: State(preview: PreviewStateEquatable(.loaded(source: source, collections: collections)), installed: Set(), premiumFile: nil))
        self.stateValue = stateValue
        let updateState: ((State) -> State) -> Void = { _ = stateValue.modify($0) }
        self.updateState = updateState
        let getAnalyticsContext: () -> AnalyticsContext = { AnalyticsContext() }
        let close: (() -> Void)? = { recorder.closeCount += 1 }
        let onAdd: (() -> Void)? = { recorder.onAddCount += 1 }
        let editTitle: (PreviewState.Collection) -> Void = { _ in }
@@PACK_REFERENCE@@
@@SET_EDITING@@
        self.setEditing = setEditing
@@DELETE@@
        let arguments = Arguments()
        self.arguments = arguments
        arguments.addpack = @@ADD@@
        arguments.addAll = @@ADD_ALL@@
        self.menu = @@MENU@@
    }
    func headerInstalled(_ collection: PreviewState.Collection, source: PreviewState.Source) -> Bool {
        let state = stateValue.with { $0 }
@@HEADER_STATUS@@
        return isInstalled(collection)
    }
    func headerAdd(_ collection: PreviewState.Collection, source: PreviewState.Source) {
        let arguments = self.arguments
        let action: (StickerPackCollectionInfo, [StickerPackItem]) -> Void = @@HEADER_ADD@@
        action(collection.info, collection.items)
    }
    func footerTitle() -> String? {
        let state = stateValue.with { $0 }
        guard case let .loaded(source, collections) = state.preview.value else { return nil }
        let controllerSource = self.controllerSource
        let setEditing = self.setEditing
        let stateValue = self.stateValue
        let arguments = self.arguments
@@FOOTER@@
        return title
    }
    func replaceSnapshot(source: PreviewState.Source, collections: [PreviewState.Collection]) {
        updateState { current in
            var current = current
            current.preview = PreviewStateEquatable(.loaded(source: source, collections: collections))
            return current
        }
    }
}
private func collection(_ id: Int64, installed: Bool = false, source: PreviewState.Source = .emoji, own: Bool = false, name: String? = nil) -> PreviewState.Collection {
    var flags: StickerPackCollectionInfoFlags = []
    if source == .emoji { flags.insert(.isEmoji) }
    if own { flags.insert(.isCreator) }
    let info = StickerPackCollectionInfo(id: ItemCollectionId(namespace: source == .emoji ? Namespaces.ItemCollection.CloudEmojiPacks : Namespaces.ItemCollection.CloudStickerPacks, id: id), flags: flags, accessHash: id + 20, title: "Pack \(id)", shortName: name ?? "pack\(id)")
    return PreviewState.Collection(info: info, items: [StickerPackItem(token: 1), StickerPackItem(token: 2)], installed: installed)
}
private func deleteItem(_ session: Session) -> ContextMenuItem? { session.menu().first { $0.title == strings().messageContextDelete } }
var passed = 0
var failed = 0
func expect(_ condition: @autoclosure () -> Bool, _ name: String) {
    if condition() { passed += 1; print("PASS " + name) }
    else { failed += 1; print("FAIL " + name) }
}

private let pack = collection(56)
private let session = Session(source: .emoji, collections: [pack])
expect(!session.headerInstalled(pack, source: .emoji) && deleteItem(session) == nil, "uninstalled pack header and menu")
expect(session.footerTitle() == "EMOJI-ADD-2", "uninstalled pack footer")
session.headerAdd(pack, source: .emoji)
expect(session.recorder.requests == [.add(56)] && session.recorder.closeCount == 0, "header add keeps preview open")
expect(session.recorder.installed.isEmpty, "add completion intentionally delayed")
expect(session.headerInstalled(pack, source: .emoji), "header immediately shows added")
expect(session.footerTitle() == nil && deleteItem(session) != nil, "footer hides add and menu shows delete")
expect(session.stateValue.with { $0.installed.contains(.emoji(.name("pack56"))) }, "local installed marker uses pack name")
private let staleMenuDelete = deleteItem(session)
session.replaceSnapshot(source: .emoji, collections: [collection(56, installed: false)])
staleMenuDelete?.handler?()
expect(session.recorder.requests == [.add(56), .remove(56)], "add then menu delete removes before refreshed snapshot")
expect(session.recorder.toasts == [strings().emojiPackAddedTitle, strings().emojiPackRemovedTitle], "delete after add shows removed toast")
expect(session.recorder.closeCount == 1 && session.recorder.onAddCount == 2, "menu removal closes and notifies")
session.recorder.flush()
expect(session.recorder.installed.isEmpty, "queued add then remove ends uninstalled")

private let settled = Session(source: .emoji, collections: [pack])
settled.headerAdd(pack, source: .emoji)
settled.recorder.flush()
expect(settled.recorder.installed == [56], "completed add reflected in store double")
expect(settled.footerTitle() == nil && deleteItem(settled) != nil, "stale snapshot still has consistent installed display")
deleteItem(settled)?.handler?()
settled.recorder.flush()
expect(settled.recorder.requests == [.add(56), .remove(56)] && settled.recorder.installed.isEmpty, "completed add with stale snapshot removes")

private let refreshed = Session(source: .emoji, collections: [pack])
refreshed.headerAdd(pack, source: .emoji)
refreshed.recorder.flush()
refreshed.replaceSnapshot(source: .emoji, collections: [collection(56, installed: true)])
deleteItem(refreshed)?.handler?()
expect(refreshed.recorder.requests == [.add(56), .remove(56)], "updated snapshot removal preserved")

private let duplicate = Session(source: .emoji, collections: [pack])
duplicate.headerAdd(pack, source: .emoji)
duplicate.headerAdd(pack, source: .emoji)
expect(duplicate.recorder.requests == [.add(56)], "stale repeated header add is ignored")
expect(duplicate.recorder.toasts.count == 1 && duplicate.recorder.onAddCount == 1, "ignored header callback does not toast or notify")
expect(duplicate.headerInstalled(pack, source: .emoji), "stale header cannot remove installed pack")

for source: PreviewState.Source in [.emoji, .stickers] {
    let initial = collection(71, installed: true, source: source)
    let preview = Session(source: source, collections: [initial])
    expect(preview.headerInstalled(initial, source: source) && preview.footerTitle() == nil && deleteItem(preview) != nil, "initial installed display \(source)")
    deleteItem(preview)?.handler?()
    expect(preview.recorder.requests == [.remove(71)] && preview.recorder.closeCount == 1, "initial installed removal \(source)")
    expect(!preview.recorder.requests.contains(.delete(71)), "removal not server delete \(source)")
    let fresh = collection(72, source: source)
    let add = Session(source: source, collections: [fresh])
    _ = add.footerTitle()
    add.pendingAddAction.with { $0 }?()
    expect(add.recorder.requests == [.add(72)] && add.recorder.closeCount == 1, "initial uninstalled footer adds and closes \(source)")
}

private let ownerPack = collection(80, installed: true, source: .stickers, own: true)
private let owner = Session(source: .stickers, collections: [ownerPack])
expect(owner.footerTitle() == strings().stickerPackPreviewModalControllerEditStickers, "owned installed footer offers editing")
owner.pendingAddAction.with { $0 }?()
expect(owner.stateValue.with { $0.isEditing } && owner.recorder.requests.isEmpty, "owned footer enters editing without installation operation")
expect(owner.footerTitle() == strings().modalDone.uppercased(), "owned editing footer offers done")
private let ownDelete = deleteItem(owner)
expect(ownDelete?.handler == nil && ownDelete?.submenu?.items.count == 2, "owned installed delete has distinct submenu")
ownDelete?.submenu?.items.first { $0.title == strings().stickerPackPreviewModalControllerRemoveForMe }?.handler?()
expect(owner.recorder.requests == [.remove(80)] && owner.recorder.confirmations == 0, "owned remove for me archives not server delete")
private let ownerServer = Session(source: .stickers, collections: [ownerPack])
deleteItem(ownerServer)?.submenu?.items.first { $0.title == strings().stickerPackPreviewModalControllerDeleteForEveryone }?.handler?()
expect(ownerServer.recorder.requests == [.delete(80)] && ownerServer.recorder.confirmations == 1, "owned delete for everyone confirms server delete")
private let ownerUninstalled = Session(source: .stickers, collections: [collection(81, source: .stickers, own: true)])
expect(deleteItem(ownerUninstalled)?.submenu == nil, "owned uninstalled delete has no remove submenu")
deleteItem(ownerUninstalled)?.handler?()
expect(ownerUninstalled.recorder.requests == [.delete(81)] && ownerUninstalled.recorder.confirmations == 1, "owned uninstalled delete remains server deletion")
private let emojiOwner = Session(source: .emoji, collections: [collection(82, installed: true, own: true)])
deleteItem(emojiOwner)?.handler?()
expect(emojiOwner.recorder.requests == [.remove(82)] && emojiOwner.recorder.confirmations == 0, "emoji creator flag does not trigger sticker server deletion")

private let first = collection(90)
private let second = collection(91)
private let multi = Session(source: .emoji, collections: [first, second])
expect(multi.footerTitle() == "EMOJI-ADD-2" && deleteItem(multi) == nil, "multiple preview footer and menu")
multi.headerAdd(first, source: .emoji)
expect(multi.headerInstalled(first, source: .emoji) && !multi.headerInstalled(second, source: .emoji), "multiple preview tracks each pack separately")
expect(multi.footerTitle() == "EMOJI-ADD-1", "multiple preview excludes locally added pack from count")
multi.headerAdd(second, source: .emoji)
expect(multi.footerTitle() == nil && deleteItem(multi) == nil, "all locally added multi packs hide footer without single delete")
expect(multi.recorder.requests == [.add(90), .add(91)] && multi.recorder.closeCount == 0, "multiple header additions remain independent")
private let bulk = Session(source: .emoji, collections: [first, second])
_ = bulk.footerTitle()
bulk.pendingAddAction.with { $0 }?()
expect(bulk.recorder.requests == [.add(90), .add(91)] && bulk.recorder.closeCount == 1, "multiple footer still adds all and closes")
private let bulkLocal = Session(source: .emoji, collections: [first, second])
bulkLocal.arguments.addAll(.emoji, [first, second], false)
expect(bulkLocal.headerInstalled(first, source: .emoji) && bulkLocal.headerInstalled(second, source: .emoji) && bulkLocal.footerTitle() == nil, "nonclosing addAll markers are consistent")

private let sameName = Session(source: .emoji, collections: [collection(100, name: "same")])
sameName.headerAdd(collection(100, name: "same"), source: .emoji)
expect(!sameName.headerInstalled(collection(101, source: .stickers, name: "same"), source: .stickers), "emoji and sticker names do not cross installed namespace")
private let initialMarker = Session(source: .emoji, collections: [collection(102, installed: true)])
expect(initialMarker.stateValue.with { $0.installed.isEmpty } && initialMarker.headerInstalled(collection(102, installed: true), source: .emoji), "initial snapshot needs no local marker")
for mode: StickerPackPreviewModalSource in [.installGroupEmojiPack, .removeGroupEmojiPack] {
    let group = Session(source: .emoji, collections: [pack], controllerSource: mode)
    expect(deleteItem(group) == nil, "group mode has no delete menu \(mode)")
    _ = group.footerTitle()
    group.pendingAddAction.with { $0 }?()
    expect(group.recorder.requests.isEmpty && group.recorder.closeCount == 1 && group.recorder.onAddCount == 1, "group callback remains distinct \(mode)")
}
print("RESULT \(passed) passed \(failed) failed")
exit(failed == 0 ? 0 : 1)
