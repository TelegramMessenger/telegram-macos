import Foundation

enum NoError: Error {}

struct Disposable {}

struct Signal<T, E> {
    let subscribe: (@escaping (T) -> Void) -> Void

    static func single(_ value: T) -> Signal<T, E> {
        return Signal(subscribe: { next in
            next(value)
        })
    }

    func start(next: @escaping (T) -> Void = { _ in }) -> Disposable {
        self.subscribe(next)
        return Disposable()
    }
}

infix operator |> : AdditionPrecedence
func |> <A, B>(value: A, transform: (A) -> B) -> B {
    return transform(value)
}

func map<T, R, E>(_ f: @escaping (T) -> R) -> (Signal<T, E>) -> Signal<R, E> {
    return { signal in
        return Signal(subscribe: { next in
            signal.subscribe { value in
                next(f(value))
            }
        })
    }
}

func take<T, E>(_ count: Int) -> (Signal<T, E>) -> Signal<T, E> {
    return { signal in
        return Signal(subscribe: { next in
            var left = count
            signal.subscribe { value in
                if left > 0 {
                    left -= 1
                    next(value)
                }
            }
        })
    }
}

func mapToSignal<T, R, E>(_ f: @escaping (T) -> Signal<R, E>) -> (Signal<T, E>) -> Signal<R, E> {
    return { signal in
        return Signal(subscribe: { next in
            var latest = 0
            signal.subscribe { value in
                latest += 1
                let current = latest
                f(value).subscribe { result in
                    if current == latest {
                        next(result)
                    }
                }
            }
        })
    }
}

func distinctUntilChanged<T: Equatable, E>(_ signal: Signal<T, E>) -> Signal<T, E> {
    return Signal(subscribe: { next in
        var last: T?
        signal.subscribe { value in
            if last != value {
                last = value
                next(value)
            }
        }
    })
}

func combineLatest<A, B, E>(_ first: Signal<A, E>, _ second: Signal<B, E>) -> Signal<(A, B), E> {
    return Signal(subscribe: { next in
        var firstValue: A?
        var secondValue: B?
        let update = {
            if let firstValue = firstValue, let secondValue = secondValue {
                next((firstValue, secondValue))
            }
        }
        first.subscribe { value in
            firstValue = value
            update()
        }
        second.subscribe { value in
            secondValue = value
            update()
        }
    })
}

func deliverOnMainQueue<T, E>(_ signal: Signal<T, E>) -> Signal<T, E> {
    return signal
}

final class Promise<T> {
    private var value: T?
    private var observers: [(T) -> Void] = []

    func set(_ value: T) {
        self.value = value
        self.observers.forEach { $0(value) }
    }

    func get() -> Signal<T, NoError> {
        return Signal(subscribe: { next in
            self.observers.append(next)
            if let value = self.value {
                next(value)
            }
        })
    }
}

typealias PeerId = Int64

struct MessageId: Hashable {
    let peerId: PeerId
    let namespace: Int32
    let id: Int32
}

enum Namespaces {
    enum Message {
        static let Cloud: Int32 = 0
        static let ScheduledCloud: Int32 = 1
        static let ScheduledLocal: Int32 = 2
        static let allScheduled: Set<Int32> = [ScheduledCloud, ScheduledLocal]
    }
}

struct Message {
    let id: MessageId
    let threadId: Int64?
}

final class Transaction {
    var messages: [Message] {
        didSet {
            self.observers.forEach { $0() }
        }
    }
    var observers: [() -> Void] = []

    init(messages: [Message]) {
        self.messages = messages
    }

    func withAllMessages(peerId: PeerId, namespace: Int32? = nil, _ f: (Message) -> Bool) {
        for message in self.messages where message.id.peerId == peerId && (namespace == nil || message.id.namespace == namespace) {
            if !f(message) {
                break
            }
        }
    }
}

final class Postbox {
    let transactionValue: Transaction

    init(transaction: Transaction) {
        self.transactionValue = transaction
    }

    func transaction<T>(_ body: @escaping (Transaction) -> T) -> Signal<T, NoError> {
        return Signal(subscribe: { next in
            next(body(self.transactionValue))
        })
    }
}

enum ChatLocationInput {
    case peer(peerId: PeerId, threadId: Int64?)
}

struct MessageHistoryView {
    let entries: [Message]
}

final class ViewTracker {
    let transaction: Transaction
    var openedViews = 0

    init(transaction: Transaction) {
        self.transaction = transaction
    }

    func scheduledMessagesViewForLocation(_ location: ChatLocationInput) -> Signal<(MessageHistoryView, Int, Int?), NoError> {
        switch location {
        case let .peer(peerId, threadId):
            return Signal(subscribe: { next in
                self.openedViews += 1
                let update = {
                    let entries = self.transaction.messages.filter { message in
                        return message.id.peerId == peerId && Namespaces.Message.allScheduled.contains(message.id.namespace) && (threadId == nil || message.threadId == threadId)
                    }
                    next((MessageHistoryView(entries: entries), 0, nil))
                }
                self.transaction.observers.append(update)
                update()
            })
        }
    }
}

final class Account {
    let postbox: Postbox
    let viewTracker: ViewTracker

    init(postbox: Postbox, viewTracker: ViewTracker) {
        self.postbox = postbox
        self.viewTracker = viewTracker
    }
}

enum InteractiveMessagesDeletionType {
    case forLocalPeer
    case forEveryone
}

enum InteractiveHistoryClearingType {
    case scheduledMessages
}

final class Messages {
    let transaction: Transaction
    var clearedThreads: [Int64?] = []
    var deletions: [InteractiveMessagesDeletionType] = []

    init(transaction: Transaction) {
        self.transaction = transaction
    }

    func deleteMessagesInteractively(messageIds: [MessageId], type: InteractiveMessagesDeletionType) -> Signal<Void, NoError> {
        return Signal(subscribe: { next in
            self.deletions.append(type)
            self.transaction.messages.removeAll(where: { messageIds.contains($0.id) })
            next(())
        })
    }

    func clearHistoryInteractively(peerId: PeerId, threadId: Int64?, type: InteractiveHistoryClearingType) -> Signal<Void, NoError> {
        return Signal(subscribe: { next in
            self.clearedThreads.append(threadId)
            self.transaction.messages.removeAll(where: { message in
                guard message.id.peerId == peerId else {
                    return false
                }
                if message.id.namespace == Namespaces.Message.ScheduledCloud {
                    return true
                }
                return message.id.namespace == Namespaces.Message.ScheduledLocal && (threadId == nil || message.threadId == threadId)
            })
            next(())
        })
    }
}

final class Engine {
    let messages: Messages

    init(messages: Messages) {
        self.messages = messages
    }
}

final class Context {
    let window = 0
    let account: Account
    let engine: Engine

    init(transaction: Transaction) {
        self.account = Account(postbox: Postbox(transaction: transaction), viewTracker: ViewTracker(transaction: transaction))
        self.engine = Engine(messages: Messages(transaction: transaction))
    }
}

struct ChatLocation {
    let peerId: PeerId
    let threadId: Int64?
}

