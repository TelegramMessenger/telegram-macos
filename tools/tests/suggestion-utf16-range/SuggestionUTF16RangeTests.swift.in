    HashtagCase(label: "Thai after text with skin tone emoji", before: "👍🏽 ok ", query: "#สวั", hashtag: "#สวัสดี", after: ""),
    HashtagCase(label: "Thai with text after the cursor", before: "", query: "#สวั", hashtag: "#สวัสดี", after: " ท้าย"),
    HashtagCase(label: "Hindi", before: "", query: "#किता", hashtag: "#किताब", after: ""),
    HashtagCase(label: "Bengali", before: "", query: "#নমস্", hashtag: "#নমস্কার", after: ""),
    HashtagCase(label: "Arabic with vowel marks", before: "", query: "#مَرْحَ", hashtag: "#مَرْحَبًا", after: ""),
    HashtagCase(label: "Adlam, outside the BMP", before: "", query: "#𞤀𞤣", hashtag: "#𞤀𞤣𞤤𞤢𞤥", after: ""),
    HashtagCase(label: "Thai with selected text after the query", before: "a ", query: "#สวั", hashtag: "#สวัสดี", after: "", selected: "xyz"),
    HashtagCase(label: "Latin with a decomposed letter", before: "", query: "#cafe\u{301}", hashtag: "#cafe\u{301}te\u{301}ria", after: ""),
    HashtagCase(label: "Latin control", before: "", query: "#hel", hashtag: "#hello", after: ""),
