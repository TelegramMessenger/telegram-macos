struct MentionCase {
    let label: String
    let before: String
    let query: String
    let username: String?
    let title: String
    var selected: String = ""
    var after: String = ""
}

let mentionCases: [MentionCase] = [
    MentionCase(label: "Thai, no username", before: "", query: "@สวั", username: nil, title: "สวัสดี"),
    MentionCase(label: "Thai, username", before: "", query: "@สวั", username: "sawasdee", title: "สวัสดี"),
    MentionCase(label: "Thai after skin tone emoji, no username", before: "hi 👍🏽 ", query: "@สวั", username: nil, title: "สวัสดี"),
    MentionCase(label: "Hindi, no username", before: "", query: "@किता", username: nil, title: "किताब"),
    MentionCase(label: "Bengali, username", before: "", query: "@নমস্", username: "nomoskar", title: "নমস্কার"),
    MentionCase(label: "Arabic with vowel marks, no username", before: "", query: "@مَرْ", username: nil, title: "مَرْحَبًا"),
    MentionCase(label: "Adlam outside the BMP, no username", before: "", query: "@𞤀𞤣", username: nil, title: "𞤀𞤣𞤤𞤢𞤥"),
    MentionCase(label: "Adlam outside the BMP, username", before: "", query: "@𞤀𞤣", username: "adlam", title: "𞤀𞤣𞤤𞤢𞤥"),
    MentionCase(label: "Thai with text after the cursor, no username", before: "", query: "@สวั", username: nil, title: "สวัสดี", after: " ครับ"),
    MentionCase(label: "Thai with selected text after the query, username", before: "a ", query: "@สวั", username: "sawasdee", title: "สวัสดี", selected: "xyz"),
    MentionCase(label: "Cyrillic with a decomposed letter, no username", before: "", query: "@и\u{306}ог", username: nil, title: "и\u{306}ога"),
    MentionCase(label: "Latin control, no username", before: "", query: "@ale", username: nil, title: "Alex"),
    MentionCase(label: "Latin control, username", before: "", query: "@ale", username: "alex_test", title: "Alex"),
    MentionCase(label: "Latin, name with skin tone emoji, no username", before: "👍🏽 ", query: "@ana", username: nil, title: "Ana 👩🏽‍💻"),
]

let hashtagSites: [(String, (FakeInteraction, FakeHashtagItem) -> Void)] = [
    ("InputContextHelper Return hashtag", helperReturnHashtag),
    ("InputContextHelper Return quick hashtag", helperReturnQuickHashtag),
    ("InputContextHelper Tab hashtag", helperTabHashtag),
]

let emojiSites: [(String, (FakeInteraction, Source) -> Void)] = [
    ("InputContextHelper Return emoji", helperReturnEmoji),
    ("InputContextHelper Tab emoji", helperTabEmoji),
]

let mentionSites: [(String, (FakeOwner, FakePeer) -> Void)] = [
    ("ChatController mention", chatMention),
    ("PreviewSenderController mention (first init)", previewMentionFirst),
    ("PreviewSenderController mention (second init)", previewMentionSecond),
    ("ShareModalController mention", shareMention),
]

for (site, run) in hashtagSites {
    for item in hashtagCases {
        let typed = Typed(before: item.before, query: item.query, selected: item.selected, after: item.after)
        let expected = item.before + item.hashtag + " " + item.after
        check(site, item.label, typed: typed, types: [.hashtag], expected: expected, cursor: utf16(item.before + item.hashtag + " "), uid: nil) { interaction in
            run(interaction, FakeHashtagItem(hashtag: item.hashtag))
        }
    }
}

for (site, run) in emojiSites {
    for item in emojiCases {
        let typed = Typed(before: item.before, query: item.query, selected: "", after: item.after)
        let expected = item.before + item.inserted + item.after
        check(site, item.label, typed: typed, types: item.types, expected: expected, cursor: utf16(item.before + item.inserted), uid: nil) { interaction in
            run(interaction, item.clue)
        }
    }
}

for (site, run) in mentionSites {
    for item in mentionCases {
        let typed = Typed(before: item.before, query: item.query, selected: item.selected, after: item.after)
        let inserted: String
        let uid: Range<Int>?
        if let username = item.username {
            inserted = "@" + username + " "
            uid = nil
        } else {
            inserted = item.title + " "
            uid = utf16(item.before) ..< utf16(item.before + item.title)
        }
        let expected = item.before + inserted + item.after
        check(site, item.label, typed: typed, types: [.mention], expected: expected, cursor: utf16(item.before + inserted), uid: uid) { interaction in
            run(FakeOwner(interaction), FakePeer(42, username: item.username, title: item.title))
        }
    }
}

print("\(passed) passed, \(failed) failed")
exit(failed == 0 ? 0 : 1)
