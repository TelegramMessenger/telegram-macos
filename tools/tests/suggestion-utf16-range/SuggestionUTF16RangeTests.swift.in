    let hashtag: String
}

struct FakeInternalId {
    let value: Int64
    func _internalGetInt64Value() -> Int64 {
        return self.value
    }
}

struct FakePeerId {
    let id: FakeInternalId
}

struct FakePeer {
    let id: FakePeerId
    let addressName: String?
    let compactDisplayTitle: String

    init(_ value: Int64, username: String?, title: String) {
        self.id = FakePeerId(id: FakeInternalId(value: value))
        self.addressName = username
        self.compactDisplayTitle = title
    }
}

