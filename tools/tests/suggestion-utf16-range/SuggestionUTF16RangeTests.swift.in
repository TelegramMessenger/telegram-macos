import Foundation
import CoreText

public enum ChatTextInputAttribute: Equatable {
    case uid(Range<Int>, Int64)
}

public struct ChatTextInputState {
    public let inputText: String
    public let selectionRange: Range<Int>
    let attributes: [ChatTextInputAttribute]

    init(inputText: String, selectionRange: Range<Int>, attributes: [ChatTextInputAttribute]) {
        self.inputText = inputText
        self.selectionRange = selectionRange
        self.attributes = attributes
    }
}

extension String {
    __GLYPH_COUNT__

    __IS_SINGLE_EMOJI__

    __CONTAINS_EMOJI__

    __CONTAINS_ONLY_EMOJI__

    var fixed: String {
        return self
    }
}

__UNICODE_SCALAR__

__COMMAND_AUTOCOMPLETE__

__QUERY__

enum TextInputAttributes {
    static let customEmoji = NSAttributedString.Key("Attribute__EmbeddedAnimated")
}

struct FakeFileId {
    let id: Int64
}

struct FakeFile {
    let fileId: FakeFileId
    let customEmojiText: String?
    let stickerText: String?
}

final class TextInputTextCustomEmojiAttribute: NSObject {
    let fileId: Int64
    let emoji: String
    init(fileId: Int64, file: FakeFile, emoji: String) {
        self.fileId = fileId
        self.emoji = emoji
    }
}

let clown = "🤡"

extension NSAttributedString {
    var range: NSRange {
        return NSMakeRange(0, self.length)
    }

    static func makeAnimated(_ file: FakeFile, text: String) -> NSAttributedString {
        let attr = NSMutableAttributedString(string: text)
        attr.addAttribute(TextInputAttributes.customEmoji, value: TextInputTextCustomEmojiAttribute(fileId: file.fileId.id, file: file, emoji: text), range: attr.range)
        return attr
    }
}

extension NSMutableAttributedString {
    func append(string: String) -> NSRange {
        let start = self.length
        self.append(NSAttributedString(string: string))
        return NSMakeRange(start, self.length - start)
    }
}

enum Source {
    case emoji(String)
    case animated(FakeFile)
}

struct FakePresentation {
    var effectiveInput: ChatTextInputState

    func withUpdatedEffectiveInputState(_ state: ChatTextInputState) -> FakePresentation {
        return FakePresentation(effectiveInput: state)
    }
}

final class FakeInteraction {
    var presentation: FakePresentation
    var problems: [String] = []
    var calls = 0

    init(_ state: ChatTextInputState) {
        self.presentation = FakePresentation(effectiveInput: state)
    }

    func update(_ f: (FakePresentation) -> FakePresentation) {
        self.presentation = f(self.presentation)
    }

    @discardableResult func appendText(_ text: NSAttributedString, selectedRange: Range<Int>) -> Range<Int> {
        self.calls += 1
        let input = self.presentation.effectiveInput
        let current = input.inputText as NSString
        guard selectedRange.lowerBound >= 0, selectedRange.upperBound <= current.length else {
            self.problems.append("appendText range \(selectedRange) outside 0..<\(current.length), the app would raise NSRangeException")
            return selectedRange.lowerBound ..< selectedRange.lowerBound + text.length
        }
        let updated = current.replacingCharacters(in: NSMakeRange(selectedRange.lowerBound, selectedRange.count), with: text.string)
        let end = selectedRange.lowerBound + text.length
        self.presentation = self.presentation.withUpdatedEffectiveInputState(ChatTextInputState(inputText: updated, selectionRange: end ..< end, attributes: input.attributes))
        return selectedRange.lowerBound ..< end
    }

    @discardableResult func appendText(_ text: String, selectedRange: Range<Int>) -> Range<Int> {
        return self.appendText(NSAttributedString(string: text), selectedRange: selectedRange)
    }
}

final class FakeOwner {
    let chatInteraction: FakeInteraction
    var contextChatInteraction: FakeInteraction {
        return self.chatInteraction
    }

    init(_ interaction: FakeInteraction) {
        self.chatInteraction = interaction
    }
}

