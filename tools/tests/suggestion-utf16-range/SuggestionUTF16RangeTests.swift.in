var passed = 0
var failed = 0

func utf16(_ text: String) -> Int {
    return (text as NSString).length
}

func show(_ text: String) -> String {
    return "\"" + text.replacingOccurrences(of: "\n", with: "\\n") + "\""
}

struct Typed {
    let before: String
    let query: String
    let selected: String
    let after: String

    var state: ChatTextInputState {
        let cursor = utf16(self.before + self.query)
        return ChatTextInputState(inputText: self.before + self.query + self.selected + self.after, selectionRange: cursor ..< cursor + utf16(self.selected), attributes: [])
    }
}

func check(_ site: String, _ label: String, typed: Typed, types: PossibleContextQueryTypes, expected: String, cursor: Int, uid: Range<Int>?, run: (FakeInteraction) -> Void) {
    var errors: [String] = []
    let state = typed.state
    if let (_, found, _) = textInputStateContextQueryRangeAndType(state, includeContext: false) {
        if !found.contains(types) {
            errors.append("query types \(found.rawValue), expected \(types.rawValue)")
        }
    } else {
        errors.append("no query found in \(show(state.inputText))")
    }
    let interaction = FakeInteraction(state)
    run(interaction)
    let result = interaction.presentation.effectiveInput
    errors.append(contentsOf: interaction.problems)
    if interaction.calls != 1 {
        errors.append("appendText called \(interaction.calls) times")
    }
    if result.inputText != expected {
        errors.append("field \(show(result.inputText)), expected \(show(expected))")
    }
    if result.selectionRange != cursor ..< cursor {
        errors.append("cursor \(result.selectionRange), expected \(cursor)..<\(cursor)")
    }
    let uids = result.attributes.compactMap { attribute -> Range<Int>? in
        if case let .uid(range, _) = attribute {
            return range
        }
        return nil
    }
    if let uid = uid {
        if uids != [uid] {
            errors.append("mention attribute \(uids), expected [\(uid)]")
        }
    } else if !uids.isEmpty {
        errors.append("unexpected mention attribute \(uids)")
    }
    if errors.isEmpty {
        passed += 1
        print("PASS \(site): \(label)")
    } else {
        failed += 1
        print("FAIL \(site): \(label): " + errors.joined(separator: "; "))
    }
}

struct HashtagCase {
    let label: String
    let before: String
    let query: String
    let hashtag: String
    let after: String
    var selected: String = ""
}

let hashtagCases: [HashtagCase] = [
