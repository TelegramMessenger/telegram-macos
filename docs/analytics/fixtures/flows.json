{
 "schema_version": 1,
 "about": "Conformance vectors for flow recording (RULES.md, Flows). Every client must produce exactly `expect` for each case. Compare the event data with the common params (see events.yaml common_params) removed.",
 "ops": {
  "start": "create the flow; its clock starts at at_ms",
  "set": "set a flow param; value null removes it",
  "set_if_absent": "set a flow param only if it has no value",
  "step": "record a step",
  "finish": "end the flow with an outcome",
  "dispose": "the flow's owner is destroyed (screen deallocated) without calling finish"
 },
 "flow": "peer_info.visibility",
 "cases": [
  {
   "name": "success with timings and params",
   "ops": [
    {
     "at_ms": 0,
     "op": "start"
    },
    {
     "at_ms": 0,
     "op": "set",
     "key": "entry",
     "value": "edit"
    },
    {
     "at_ms": 120,
     "op": "set_if_absent",
     "key": "peer_type",
     "value": "channel"
    },
    {
     "at_ms": 1200,
     "op": "step",
     "step": "select_public"
    },
    {
     "at_ms": 2900,
     "op": "step",
     "step": "edit_username"
    },
    {
     "at_ms": 3400,
     "op": "step",
     "step": "username_available"
    },
    {
     "at_ms": 9700,
     "op": "step",
     "step": "save"
    },
    {
     "at_ms": 9700,
     "op": "set",
     "key": "result",
     "value": "public"
    },
    {
     "at_ms": 9900,
     "op": "finish",
     "outcome": "success"
    }
   ],
   "expect": [
    {
     "type": "flow.end",
     "data": {
      "flow": "peer_info.visibility",
      "outcome": "success",
      "entry": "edit",
      "peer_type": "channel",
      "result": "public",
      "steps": [
       [
        "select_public",
        1200
       ],
       [
        "edit_username",
        2900
       ],
       [
        "username_available",
        3400
       ],
       [
        "save",
        9700
       ]
      ],
      "step_count": 4,
      "duration_ms": 9900
     }
    }
   ]
  },
